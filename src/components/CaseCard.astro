---
import { genCaseArt } from '../utils/caseArt';
import type { Case } from '../lib/content';
interface Props {
  item: Case;
  index?: number;
  showLead?: boolean;
}
const { item, index = 0, showLead = false } = Astro.props;
const metric = item.data.metrics[0];
---

<a class="card" href={`/casos/${item.id}/`}>
  <div class="card-media">
    <Fragment set:html={genCaseArt(item.id, index)} />
    <span class="card-metric">
      <strong>{metric.value}</strong>
      <span>{metric.label}</span>
    </span>
  </div>
  <div class="card-body">
    <p class="eyebrow">{item.data.category}</p>
    <h3 class="card-title">{item.data.title}</h3>
    {showLead && <p class="card-text">{item.data.lead}</p>}
  </div>
</a>
