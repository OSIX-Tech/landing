---
import Icon from './Icon.astro';
import { org } from '../site';
import { getServices, getGuidesBySection } from '../lib/content';

const services = await getServices();
const sections = await getGuidesBySection();
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="top">
      <div class="about">
        <img src="/full_logo_w.png" alt="OSIX Tech" width="1080" height="184" loading="lazy" decoding="async" />
        <p>{org.description}</p>
        <ul class="contact">
          <li><Icon name="mail" size={16} /><a href={`mailto:${org.email}`}>{org.email}</a></li>
          <li><Icon name="phone" size={16} /><a href={org.phoneHref}>{org.phone}</a></li>
          <li><Icon name="pin" size={16} /><span>{org.address.locality}, {org.address.region}</span></li>
        </ul>
      </div>

      <nav class="cols" aria-label="Pie de página">
        <div>
          <p class="col-title">Servicios</p>
          <ul>
            {services.map((s) => <li><a href={`/servicios/${s.id}/`}>{s.data.title}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="col-title">Guías</p>
          <ul>
            {sections.map((s) => <li><a href={`/guias/#${s.id}`}>{s.label}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="col-title">OSIX</p>
          <ul>
            <li><a href="/casos/">Casos en producción</a></li>
            <li><a href="/nosotros/">Nosotros</a></li>
            <li><a href="/contacto/">Contacto</a></li>
            <li><a href={org.linkedin} rel="noopener">LinkedIn</a></li>
            <li><a href={org.github} rel="noopener">GitHub</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="bottom">
      <p>© {year} {org.legalName}</p>
      <ul>
        <li><a href="/privacidad/">Privacidad</a></li>
        <li><a href="/seguridad-informacion/">Seguridad de la información</a></li>
        <li><a href="/llms.txt">llms.txt</a></li>
      </ul>
    </div>
  </div>
</footer>

<a class="whatsapp" href={org.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.27-.2-.57-.35m-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88a9.82 9.82 0 0 1 6.99 2.9 9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.17-3.48-8.41z"
    ></path>
  </svg>
</a>

<style>
  .site-footer {
    background: var(--black);
    color: var(--paper);
    padding-block: 4.5rem 2rem;
    font-size: 0.9375rem;
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr);
    gap: 3rem;
  }

  .about img {
    width: 9rem;
    margin-bottom: 1.25rem;
  }

  .about p {
    max-width: 38ch;
    color: var(--muted-on-ink);
    line-height: 1.6;
  }

  .contact {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: grid;
    gap: 0.6rem;
  }

  .contact li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted-on-ink);
  }

  .contact a {
    color: var(--paper);
    text-decoration: none;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .col-title {
    margin-bottom: 0.9rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-on-ink);
  }

  .cols ul,
  .bottom ul {
    list-style: none;
    padding: 0;
  }

  .cols li + li {
    margin-top: 0.55rem;
  }

  /* Same hover as everywhere: an underline drawn from the left, text-wide. */
  .cols a,
  .bottom a,
  .contact a {
    color: var(--paper);
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--t) var(--ease);
  }

  .cols a:hover,
  .bottom a:hover,
  .contact a:hover {
    background-size: 100% 1px;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-on-ink);
    color: var(--muted-on-ink);
    font-size: 0.8125rem;
  }

  .bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .whatsapp {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition: transform 0.25s var(--ease-out);
  }

  .whatsapp:hover {
    transform: scale(1.06);
  }

  @media (max-width: 900px) {
    .top {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
