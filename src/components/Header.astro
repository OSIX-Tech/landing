---
// Site header. No JavaScript: the services menu opens with :hover/:focus-within and
// the mobile menu is a native <details>. The active section is set at build time.
import Icon from './Icon.astro';
import { getServices } from '../lib/content';

const services = await getServices();
const path = Astro.url.pathname;
const section = path.split('/')[1] ?? '';

const links = [
  { href: '/casos/', label: 'Casos', key: 'casos' },
  { href: '/guias/', label: 'Guías', key: 'guias' },
  { href: '/nosotros/', label: 'Nosotros', key: 'nosotros' },
];
const current = (key: string) => (section === key ? 'page' : undefined);
---

<header class="site-header">
  <div class="shell bar">
    <a class="brand" href="/" aria-label="OSIX Tech, inicio">
      <img src="/full_logo.png" alt="OSIX Tech" width="449" height="77" />
    </a>

    <nav class="nav" aria-label="Principal">
      <ul class="nav-list">
        <li class="has-menu">
          <a href="/servicios/" class="nav-link" aria-current={current('servicios')}>
            Servicios <Icon name="chevron" size={14} class="chev" />
          </a>
          <div class="menu">
            <ul class="menu-grid">
              {
                services.map((s) => (
                  <li>
                    <a href={`/servicios/${s.id}/`} class="menu-card">
                      <span class="menu-card-title">{s.data.title}</span>
                      <span class="menu-card-text">{s.data.tagline}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="nav-link" aria-current={current(l.key)}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/contacto/" class="btn btn-dark nav-cta" aria-current={current('contacto')}>
      Contacto <Icon name="arrow" size={15} class="arrow" />
    </a>

    <details class="mobile">
      <summary aria-label="Menú">
        <Icon name="menu" size={24} class="open" />
        <Icon name="close" size={24} class="shut" />
      </summary>
      <nav class="mobile-panel" aria-label="Principal (móvil)">
        <p class="mobile-group">Servicios</p>
        <ul>
          {
            services.map((s) => (
              <li>
                <a href={`/servicios/${s.id}/`}>{s.data.title}</a>
              </li>
            ))
          }
        </ul>
        <ul class="mobile-main">
          {
            links.map((l) => (
              <li>
                <a href={l.href} aria-current={current(l.key)}>
                  {l.label}
                </a>
              </li>
            ))
          }
          <li><a href="/contacto/">Contacto</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
  }

  .brand img {
    width: 9.25rem;
  }

  .nav {
    margin-left: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.85rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1.5px;
    background-repeat: no-repeat;
    background-position: 0.85rem calc(100% - 0.35rem);
    transition: background-size 0.3s var(--ease-out);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    background-size: calc(100% - 1.7rem) 1.5px;
  }

  .nav-link :global(.chev) {
    transition: transform 0.25s var(--ease-out);
  }

  .has-menu:hover .nav-link :global(.chev),
  .has-menu:focus-within .nav-link :global(.chev) {
    transform: rotate(180deg);
  }

  /* Services menu: a full-width panel under the bar. */
  .menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding: 0.75rem var(--gutter) 1.25rem;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.2s ease,
      transform 0.25s var(--ease-out),
      visibility 0s linear 0.25s;
  }

  .has-menu:hover .menu,
  .has-menu:focus-within .menu {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    list-style: none;
    padding: 0;
  }

  .menu-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    padding: 1.15rem 1.25rem;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .menu-card:hover {
    background: var(--ink-2);
  }

  .menu-card-title {
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .menu-card-text {
    font-size: 0.875rem;
    color: var(--muted-on-ink);
    line-height: 1.45;
  }

  .nav-cta {
    min-height: 2.5rem;
    padding: 0.5rem 1.15rem;
  }

  /* Mobile */
  .mobile {
    display: none;
    margin-left: auto;
  }

  .mobile summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    list-style: none;
  }

  .mobile summary::-webkit-details-marker {
    display: none;
  }

  .mobile :global(.shut),
  .mobile[open] :global(.open) {
    display: none;
  }

  .mobile[open] :global(.shut) {
    display: block;
  }

  .mobile-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: calc(100svh - var(--header-h));
    overflow-y: auto;
    padding: 1.5rem var(--gutter) 3rem;
    background: var(--paper);
    border-top: 1px solid var(--line);
  }

  .mobile-panel ul {
    list-style: none;
    padding: 0;
  }

  .mobile-panel a {
    display: block;
    padding: 0.7rem 0;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .mobile-group {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .mobile-main {
    margin-top: 1.75rem;
  }

  .mobile-main a {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  @media (max-width: 900px) {
    .nav,
    .nav-cta {
      display: none;
    }

    .mobile {
      display: block;
    }

    .brand img {
      width: 8rem;
    }
  }
</style>
