---
// Site header. No JavaScript: every menu opens with :hover/:focus-within and the mobile
// menu is a native <details>. The active section is set at build time. Servicios, Casos
// and Guías each get the same list-of-lines menu, built from the content collections.
import Icon from './Icon.astro';
import { getCases, getGuidesBySection, getServices } from '../lib/content';

const [services, cases, sections] = await Promise.all([getServices(), getCases(), getGuidesBySection()]);
const path = Astro.url.pathname;
const section = path.split('/')[1] ?? '';

type Item = { href: string; title: string; text?: string };
type Menu = { key: string; label: string; href: string; all: string; items: Item[] };

const menus: Menu[] = [
  {
    key: 'servicios',
    label: 'Servicios',
    href: '/servicios/',
    all: 'Todos los servicios',
    items: services.map((s) => ({ href: `/servicios/${s.id}/`, title: s.data.shortTitle ?? s.data.title, text: s.data.tagline })),
  },
  {
    key: 'casos',
    label: 'Casos',
    href: '/casos/',
    all: `Los ${cases.length} casos`,
    items: cases.map((c) => ({ href: `/casos/${c.id}/`, title: c.data.title })),
  },
  {
    key: 'guias',
    label: 'Guías',
    href: '/guias/',
    all: 'Todas las guías',
    items: sections
      .filter((s) => s.guides.length)
      .map((s) => ({ href: `/guias/#${s.id}`, title: s.label, text: `${s.guides.length} guías` })),
  },
];
const current = (key: string) => (section === key ? 'page' : undefined);
---

<header class="site-header">
  <div class="shell bar">
    <a class="brand" href="/" aria-label="OSIX Tech, inicio">
      <img src="/full_logo.png" alt="OSIX Tech" width="449" height="77" />
    </a>

    <nav class="nav" aria-label="Principal">
      <ul class="nav-list">
        {
          menus.map((m) => (
            <li class="has-menu">
              <a href={m.href} class="nav-link" aria-current={current(m.key)}>
                {m.label} <Icon name="chevron" size={14} class="chev" />
              </a>
              <div class="menu">
                <ul class="menu-list">
                  {m.items.map((i) => (
                    <li>
                      <a href={i.href} class="menu-item">
                        <span class="menu-text">
                          <span class="menu-title t-link">{i.title}</span>
                          {i.text && <span class="menu-tagline">{i.text}</span>}
                        </span>
                        <Icon name="arrow" size={15} class="arrow" />
                      </a>
                    </li>
                  ))}
                </ul>
                <a href={m.href} class="menu-all t-link">
                  {m.all}
                </a>
              </div>
            </li>
          ))
        }
        <li>
          <a href="/nosotros/" class="nav-link" aria-current={current('nosotros')}>Nosotros</a>
        </li>
      </ul>
    </nav>

    <a href="/contacto/" class="btn btn-dark nav-cta" aria-current={current('contacto')}>
      Contacto <Icon name="arrow" size={15} class="arrow" />
    </a>

    <details class="mobile">
      <summary aria-label="Menú">
        <Icon name="menu" size={24} class="open" />
        <Icon name="close" size={24} class="shut" />
      </summary>
      <nav class="mobile-panel" aria-label="Principal (móvil)">
        {
          menus.map((m) => (
            <details class="mobile-group" open={m.key === section}>
              <summary>
                {m.label} <Icon name="chevron" size={18} class="chev" />
              </summary>
              <ul>
                {m.items.map((i) => (
                  <li>
                    <a href={i.href}>{i.title}</a>
                  </li>
                ))}
                <li>
                  <a href={m.href} class="mobile-all">
                    {m.all}
                  </a>
                </li>
              </ul>
            </details>
          ))
        }
        <ul class="mobile-main">
          <li><a href="/nosotros/" aria-current={current('nosotros')}>Nosotros</a></li>
          <li><a href="/contacto/">Contacto</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
  }

  .brand img {
    width: 9.25rem;
  }

  .nav {
    margin-left: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  .has-menu {
    position: relative;
  }

  /* Every top-level link gets the same hover: an underline drawn from the left. */
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.85rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1.5px;
    background-repeat: no-repeat;
    background-position: 0.85rem calc(100% - 0.35rem);
    transition: background-size var(--t) var(--ease);
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .has-menu:hover .nav-link,
  .has-menu:focus-within .nav-link,
  .nav-link[aria-current='page'] {
    background-size: calc(100% - 1.7rem) 1.5px;
  }

  .nav-link :global(.chev) {
    transition: transform var(--t) var(--ease);
  }

  .has-menu:hover .nav-link :global(.chev),
  .has-menu:focus-within .nav-link :global(.chev) {
    transform: rotate(180deg);
  }

  /* Menus: a list of lines under the link, no cards. Fades, does not move. */
  .menu {
    position: absolute;
    left: 0;
    top: 100%;
    width: 27rem;
    max-width: calc(100vw - 2 * var(--gutter));
    padding: 0.5rem 0 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--t-fast) var(--ease),
      visibility 0s linear var(--t-fast);
  }

  /* The last two menus open to the left so they stay inside the viewport. */
  .has-menu:nth-last-child(-n + 3) .menu {
    left: auto;
    right: 0;
  }

  .menu::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 0.75rem;
  }

  .has-menu:hover .menu,
  .has-menu:focus-within .menu {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .menu-list {
    list-style: none;
    padding: 0;
  }

  .menu-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }

  .menu-item:hover .menu-title,
  .menu-item:focus-visible .menu-title {
    background-size: 100% 1px;
  }

  .menu-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    min-width: 0;
  }

  .menu-title {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .menu-tagline {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .menu-item :global(.arrow) {
    margin-top: 0.2rem;
    color: var(--muted);
    transition:
      transform var(--t) var(--ease),
      color var(--t-fast) var(--ease);
  }

  .menu-item:hover :global(.arrow) {
    transform: translateX(4px);
    color: var(--ink);
  }

  .menu-all {
    display: inline-block;
    margin: 0.25rem 1.25rem 1.1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .nav-cta {
    min-height: 2.5rem;
    padding: 0.5rem 1.15rem;
  }

  /* Mobile */
  .mobile {
    display: none;
    margin-left: auto;
  }

  .mobile > summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    list-style: none;
  }

  .mobile > summary::-webkit-details-marker {
    display: none;
  }

  .mobile :global(.shut),
  .mobile[open] :global(.open) {
    display: none;
  }

  .mobile[open] :global(.shut) {
    display: block;
  }

  .mobile-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: calc(100svh - var(--header-h));
    overflow-y: auto;
    padding: 0.5rem var(--gutter) 3rem;
    background: var(--paper);
    border-top: 1px solid var(--line);
  }

  .mobile-panel ul {
    list-style: none;
    padding: 0;
  }

  .mobile-group {
    border-bottom: 1px solid var(--line);
  }

  .mobile-group > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    cursor: pointer;
    list-style: none;
  }

  .mobile-group > summary::-webkit-details-marker {
    display: none;
  }

  .mobile-group > summary :global(.chev) {
    transition: transform var(--t) var(--ease);
  }

  .mobile-group[open] > summary :global(.chev) {
    transform: rotate(180deg);
  }

  .mobile-group ul {
    padding-bottom: 0.75rem;
  }

  .mobile-group a {
    display: block;
    padding: 0.5rem 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }

  .mobile-all {
    font-size: 0.75rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted) !important;
  }

  .mobile-main a {
    display: block;
    padding: 1rem 0;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .nav,
    .nav-cta {
      display: none;
    }

    .mobile {
      display: block;
    }

    .brand img {
      width: 8rem;
    }
  }
</style>
