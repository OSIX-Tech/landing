---
// Home hero: the 3D mark is the subject, the headline sits small under it.
// The headline and poster paint immediately; the live 3D mark loads on intent:
//   - desktop (fine pointer): on the visitor's first pointer move, scroll, key press or touch;
//   - touch devices: when the visitor taps the mark;
//   - never with prefers-reduced-motion or Save-Data — the poster stays.
// The poster is a still of the same scene, so the swap is a crossfade, not a jump.
import Icon from './Icon.astro';
import { hero } from '../data/home';

let i = 0;
const lines = hero.lines.map((line) => line.split(' ').map((word) => ({ word, i: i++ })));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="stage" id="logo-stage">
    <picture>
      <source type="image/avif" srcset="/hero/osix-mark-800.avif 800w, /hero/osix-mark-1600.avif 1600w" sizes="200vh" />
      <img
        class="poster"
        src="/hero/osix-mark-1600.webp"
        srcset="/hero/osix-mark-800.webp 800w, /hero/osix-mark-1600.webp 1600w"
        sizes="200vh"
        width="1600"
        height="800"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <button class="stage-hit" type="button" aria-label="Animar el logo de OSIX en 3D"></button>
  </div>

  <div class="shell content">
    <div class="copy">
      <h1 id="hero-title" class="rise">
        {
          lines.map((words) => (
            <span class="line">
              {words.map((w) => (
                <>
                  <span class="w" style={`--i:${w.i}`}>
                    {w.word}
                  </span>{' '}
                </>
              ))}
            </span>
          ))
        }
      </h1>
      <p class="subtitle fade-in" style="--d:0.4s">{hero.subtitle}</p>
    </div>
    <div class="actions fade-in" style="--d:0.55s">
      <a href="#servicios" class="btn btn-dark">Cómo te ayudamos <Icon name="arrow" size={15} class="arrow" /></a>
      <a href="/contacto/" class="btn btn-outline">Háblanos de tu proyecto <Icon name="arrow" size={15} class="arrow" /></a>
    </div>
    <p class="hint fade-in" style="--d:0.9s" aria-hidden="true">Haz clic en el logo · arrástralo para girarlo</p>
  </div>
</section>

<script>
  const stage = document.getElementById('logo-stage');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  if (stage && !reduce && !saveData) {
    let started = false;
    const start = async () => {
      if (started) return;
      started = true;
      cleanup();
      try {
        const { mountLogo } = await import('../scripts/logo3d');
        mountLogo(stage);
        stage.classList.add('is-live');
      } catch {
        // WebGL unavailable: the poster stays.
      }
    };
    const intent = ['pointermove', 'scroll', 'keydown', 'wheel'] as const;
    const fine = window.matchMedia('(pointer: fine)').matches;
    const cleanup = () => intent.forEach((e) => window.removeEventListener(e, start));
    if (fine) intent.forEach((e) => window.addEventListener(e, start, { once: true, passive: true }));
    stage.querySelector('.stage-hit')?.addEventListener('click', start, { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: calc(100svh - var(--header-h));
    overflow: hidden;
    isolation: isolate;
  }

  /* The 3D stage takes most of the hero; the canvas and poster share its box. */
  .stage {
    position: absolute;
    inset: 0 0 17% 0;
    z-index: -1;
    --logo-scale: 1;
  }

  .poster {
    position: absolute;
    top: 50%;
    left: 50%;
    height: calc(100% * var(--logo-scale));
    width: auto;
    max-width: none;
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: opacity 0.6s var(--ease);
  }

  .stage :global(.logo-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: grab;
    opacity: 0;
    animation: canvas-in 0.6s var(--ease) 0.1s forwards;
  }

  .stage.is-live .poster,
  .stage.is-live .stage-hit {
    opacity: 0;
    visibility: hidden;
  }

  .stage-hit {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(70vw, 30rem);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .content {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'copy actions'
      'copy hint';
    align-items: end;
    align-content: end;
    gap: 0.75rem 2rem;
    padding-block: 2.5rem clamp(1.75rem, 5vh, 3rem);
    pointer-events: none;
  }

  .copy,
  .actions,
  .hint {
    pointer-events: auto;
  }

  .copy {
    grid-area: copy;
  }

  .actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .hint {
    grid-area: hint;
    justify-self: end;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  h1 {
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .line {
    display: block;
  }

  .subtitle {
    margin-top: 0.75rem;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    color: var(--muted);
  }

  @keyframes canvas-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .stage:not(.is-live) .poster {
      animation: bob 4.2s ease-in-out infinite;
    }
  }

  @keyframes bob {
    0%,
    100% {
      transform: translate(-50%, -50%);
    }
    50% {
      transform: translate(-50%, calc(-50% - 1.6%));
    }
  }

  /* Mirrors cameraDistance() in logo3d.ts: the mark shrinks as the camera backs off. */
  @media (max-width: 1023px) {
    .stage {
      --logo-scale: 0.8;
    }
  }

  @media (max-width: 800px) {
    .content {
      grid-template-columns: 1fr;
      grid-template-areas:
        'copy'
        'actions';
    }

    .actions {
      justify-content: flex-start;
    }

    .hint {
      display: none;
    }
  }

  @media (max-width: 639px) {
    .stage {
      --logo-scale: 0.6667;
      inset: 0 0 34% 0;
    }

    .actions .btn {
      width: 100%;
    }
  }

  @media (pointer: coarse) {
    .hint {
      display: none;
    }
  }
</style>
