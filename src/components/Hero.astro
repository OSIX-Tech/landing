---
// Home hero. The 3D mark floats alone on the first screen; scrolling pulls it apart and
// the headline comes through the gap. GSAP ScrollTrigger scrubs the whole sequence.
//   - first paint: the poster (a still of the same scene) and nothing else;
//   - after load (or the first interaction): the live mark replaces the poster;
//   - without JavaScript, with reduced motion or Save-Data: a static hero, mark above copy.
import Icon from './Icon.astro';
import { hero } from '../data/home';

let i = 0;
const lines = hero.lines.map((line) => line.split(' ').map((word) => ({ word, i: i++ })));
---

<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="pin">
    <div class="stage" id="logo-stage">
      <picture>
        <source type="image/avif" srcset="/hero/osix-mark-800.avif 800w, /hero/osix-mark-1600.avif 1600w" sizes="200vh" />
        <img
          class="poster"
          src="/hero/osix-mark-1600.webp"
          srcset="/hero/osix-mark-800.webp 800w, /hero/osix-mark-1600.webp 1600w"
          sizes="200vh"
          width="1600"
          height="800"
          alt=""
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>

    <div class="copy shell">
      <h1 id="hero-title">
        {
          lines.map((words) => (
            <span class="line">
              {words.map((w) => (
                <>
                  <span class="w" style={`--i:${w.i}`}>
                    {w.word}
                  </span>{' '}
                </>
              ))}
            </span>
          ))
        }
      </h1>
      <p class="subtitle">{hero.subtitle}</p>
      <div class="actions">
        <a href="#servicios" class="btn btn-dark">Cómo te ayudamos <Icon name="arrow" size={15} class="arrow" /></a>
        <a href="/contacto/" class="btn btn-outline">Háblanos de tu proyecto <Icon name="arrow" size={15} class="arrow" /></a>
      </div>
    </div>

    <p class="hint" aria-hidden="true">
      <span>Desplázate</span>
      <Icon name="chevron" size={16} />
    </p>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const hero = document.getElementById('hero')!;
  const stage = document.getElementById('logo-stage')!;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  if (!reduce) {
    gsap.registerPlugin(ScrollTrigger);
    hero.classList.add('is-scrolly');

    let logo: { explode(value: number): void } | null = null;
    const words = hero.querySelectorAll<HTMLElement>('.w');
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
    });
    // 0 → 1 is the scroll through the hero. The mark comes apart over the first half and
    // steps back; the words rise through it; the subtitle and buttons follow.
    tl.to(hero.querySelector('.hint'), { opacity: 0, duration: 0.08 }, 0)
      .to({ p: 0 }, { p: 1, duration: 0.55, onUpdate() { logo?.explode(this.targets()[0].p); } }, 0)
      .to(stage, { scale: 1.18, opacity: 0.18, duration: 0.7, ease: 'power1.in' }, 0.05)
      .fromTo(words, { yPercent: 110 }, { yPercent: 0, duration: 0.3, stagger: 0.06, ease: 'power2.out' }, 0.3)
      .fromTo(hero.querySelector('.subtitle'), { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.2 }, 0.6)
      .fromTo(hero.querySelector('.actions'), { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.2 }, 0.7);

    if (!saveData) {
      let started = false;
      const start = async () => {
        if (started) return;
        started = true;
        cleanup();
        try {
          const { mountLogo } = await import('../scripts/logo3d');
          logo = mountLogo(stage, { driven: true });
          logo.explode(tl.scrollTrigger?.progress ? Math.min(1, tl.scrollTrigger.progress / 0.55) : 0);
          stage.classList.add('is-live');
        } catch {
          // WebGL unavailable: the poster stays and still fades out on scroll.
        }
      };
      const intent = ['pointermove', 'scroll', 'keydown', 'wheel', 'touchstart'] as const;
      const cleanup = () => intent.forEach((e) => window.removeEventListener(e, start));
      intent.forEach((e) => window.addEventListener(e, start, { once: true, passive: true }));
      // Or simply once the page is idle, so the mark is already alive when the scroll begins.
      window.addEventListener('load', () => setTimeout(start, 800), { once: true });
    }
  }
</script>

<style>
  /* Static hero (no JS / reduced motion): the mark, then the copy. */
  .hero {
    position: relative;
  }

  .pin {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - var(--header-h));
    overflow: hidden;
  }

  /* The poster was rendered at camera distance 6; the live camera sits at 5, so the
     poster is scaled by 6/5 to match (and by the same ratio at the other breakpoints). */
  .stage {
    position: relative;
    height: min(52svh, 34rem);
    --logo-scale: 1.2;
  }

  .poster {
    position: absolute;
    top: 50%;
    left: 50%;
    height: calc(100% * var(--logo-scale));
    width: auto;
    max-width: none;
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: opacity 0.6s var(--ease);
  }

  .stage :global(.logo-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: grab;
    opacity: 0;
    animation: canvas-in 0.6s var(--ease) 0.1s forwards;
  }

  .stage.is-live .poster {
    opacity: 0;
    visibility: hidden;
  }

  .copy {
    position: relative;
    text-align: center;
    padding-block: 2rem 3rem;
  }

  h1 {
    font-size: clamp(2.75rem, 8.5vw, 8rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .w {
    display: inline-block;
  }

  .subtitle {
    margin: 1.5rem auto 0;
    max-width: 38ch;
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    font-weight: 500;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hint {
    display: none;
  }

  @keyframes canvas-in {
    to {
      opacity: 1;
    }
  }

  /* Scroll-driven hero: 260vh tall, the screen stays pinned while the sequence plays. */
  .hero.is-scrolly {
    height: 260svh;
  }

  .is-scrolly .pin {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
    min-height: 0;
    display: block;
  }

  .is-scrolly .stage {
    position: absolute;
    inset: 0;
    height: auto;
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }

  .is-scrolly .copy {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-block: 0;
    pointer-events: none;
  }

  .is-scrolly .copy :is(h1, .subtitle, .actions) {
    pointer-events: auto;
  }

  .is-scrolly .subtitle,
  .is-scrolly .actions {
    opacity: 0;
  }

  .is-scrolly .hint {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .is-scrolly .hint :global(svg) {
    animation: nudge 1.6s var(--ease) infinite;
  }

  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  /* Mirrors cameraDistance() in logo3d.ts: the mark shrinks as the camera backs off. */
  @media (max-width: 1023px) {
    .stage {
      --logo-scale: 0.96;
    }
  }

  @media (max-width: 639px) {
    .stage {
      --logo-scale: 0.8;
    }

    .actions .btn {
      width: 100%;
    }
  }
</style>
