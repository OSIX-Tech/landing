---
// Audited figures, set large. Values are plain server-rendered text.
interface Props {
  items: { value: string; label: string; note?: string }[];
  label: string;
  variant?: 'ink' | 'light';
}
const { items, label, variant = 'ink' } = Astro.props;
---

<div class:list={['metrics', variant]}>
  <p class="eyebrow">{label}</p>
  <dl class="reveal-stagger">
    {
      items.map((m) => (
        <div>
          <dt>{m.label}</dt>
          <dd>{m.value}</dd>
          {m.note && <dd class="note">{m.note}</dd>}
        </div>
      ))
    }
  </dl>
</div>

<style>
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 2rem 2.5rem;
    margin-top: 1.5rem;
  }

  dl > div {
    display: flex;
    flex-direction: column;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line-on-ink);
  }

  .light dl > div {
    border-top-color: var(--line);
  }

  dd {
    order: -1;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  dt {
    margin-top: 0.6rem;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  dd.note {
    order: 0;
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.4;
    color: var(--muted-on-ink);
  }

  .light dd.note {
    color: var(--muted);
  }
</style>
