---
import Layout from '../../../layouts/Layout.astro';
import LoadingScreen from '../../../components/LoadingScreen.astro';
import BeamsBackground from '../../../components/BeamsBackground.jsx';
import CaseMetrics from '../../../components/case/CaseMetrics';
import CaseNarrativeStack from '../../../components/case/CaseNarrativeStack.jsx';
import CaseFAQ from '../../../components/case/CaseFAQ.astro';
import CaseRail from '../../../components/case/CaseRail.astro';
import { getCaseStudy, getCaseStudySlugs, caseStudies } from '../../../data/case-studies';
import { genCaseArt } from '../../../utils/caseArt';
import type { Lang } from '../../../utils/languages';

export const prerender = true;

// Spanish only: these are measured client figures, not copy we can translate.
export async function getStaticPaths() {
  return getCaseStudySlugs().map(slug => ({ params: { lang: 'es', slug } }));
}

const { lang = 'es', slug = '' } = Astro.params as { lang: Lang; slug: string };
const study = getCaseStudy(slug);

if (!study) {
  return Astro.redirect(`/${lang}/casos/`);
}

const related = caseStudies.filter(c => c.slug !== slug).slice(0, 3);
const canonicalUrl = `https://osix.tech/${lang}/casos/${slug}/`;
const heroArt = genCaseArt(slug);

const railSections = [
  { id: 'metricas', label: 'Cifras' },
  { id: 'caso', label: 'El caso' },
  { id: 'limite', label: 'El límite' },
  { id: 'ficha', label: 'Ficha' },
  { id: 'faq', label: 'Preguntas' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${canonicalUrl}#article`,
      headline: study.title,
      description: study.seoDescription,
      url: canonicalUrl,
      inLanguage: lang,
      datePublished: '2026-09-08',
      dateModified: '2026-09-08',
      author: { '@type': 'Organization', name: 'OSIX Tech', url: 'https://osix.tech' },
      publisher: { '@id': 'https://osix.tech/#organization' },
      about: { '@type': 'Thing', name: study.category },
      isPartOf: { '@type': 'WebSite', '@id': 'https://osix.tech/#website', name: 'OSIX Tech', url: 'https://osix.tech' },
      mainEntityOfPage: canonicalUrl,
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Inicio', item: `https://osix.tech/${lang}/` },
          { '@type': 'ListItem', position: 2, name: 'Casos de estudio', item: `https://osix.tech/${lang}/casos/` },
          { '@type': 'ListItem', position: 3, name: study.title, item: canonicalUrl },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      isPartOf: { '@id': `${canonicalUrl}#article` },
      mainEntity: study.faqs.map(faq => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<Layout
  lang={lang}
  title={study.seoTitle}
  description={study.seoDescription}
  canonical={canonicalUrl}
  pageType="article"
  jsonLd={jsonLd}
>
  <LoadingScreen duration={1000} />
  <CaseRail sections={railSections} />

  <!-- HERO -->
  <section class="case-hero relative bg-black overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="absolute inset-0 z-0">
      <BeamsBackground client:only="react" beamWidth={4} beamHeight={20} beamNumber={10} speed={2} noiseIntensity={0.5} scale={0.2} rotation={30} />
    </div>

    <div class="case-hero-inner">
      <div class="case-hero-text">
        <nav class="case-crumbs hero-el" style="--d: 0.05s" aria-label="Breadcrumb">
          <a href={`/${lang}/`}>Inicio</a>
          <span aria-hidden="true">/</span>
          <a href={`/${lang}/casos/`}>Casos de estudio</a>
        </nav>

        <span class="case-eyebrow hero-el" style="--d: 0.15s">{study.category}</span>
        <h1 class="case-h1 hero-el" style="--d: 0.25s">{study.title}</h1>
        <p class="case-lead hero-el" style="--d: 0.35s">{study.lead}</p>

        <div class="case-hero-meta hero-el" style="--d: 0.45s">
          <div class="case-meta-item">
            <span class="case-meta-key">Estado</span>
            <span class="case-meta-val">{study.status}</span>
          </div>
        </div>

        <a href={`/${lang}/#contact`} class="btn-secondary btn-arrow hero-el case-hero-cta" style="--d: 0.55s">
          Cuéntanos tu proceso
          <svg class="btn-arrow-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <figure class="case-hero-media hero-el" style="--d: 0.4s">
        <div class="case-hero-frame">
          <Fragment set:html={heroArt} />
        </div>
        <figcaption class="case-hero-caption">{study.category}</figcaption>
      </figure>
    </div>
  </section>

  <!-- HEADLINE METRICS -->
  <section id="metricas" class="case-band-dark case-metrics-band mb-0">
    <div class="case-shell">
      <CaseMetrics client:visible stats={study.metrics} label="Cifras medidas" />
      {study.metricsNote && <p class="case-metrics-note">{study.metricsNote}</p>}
    </div>
  </section>

  <!-- NARRATIVE -->
  <section id="caso" class="case-band-light case-narrative mb-0">
    <div class="case-shell">
      <CaseNarrativeStack
        client:visible
        sections={study.sections}
        ctaTitle={study.ctaTitle}
        ctaBody={study.ctaBody}
        ctaLabel="Cuéntanos tu proceso"
        ctaHref={`/${lang}/#contact`}
      />
    </div>
  </section>

  <!-- SECONDARY METRICS -->
  {study.secondaryMetrics && study.secondaryMetrics.length > 0 && (
    <section class="case-band-muted mb-0">
      <div class="case-shell">
        <CaseMetrics client:visible stats={study.secondaryMetrics} label="Desglose de producción" variant="secondary" />
      </div>
    </section>
  )}

  <!-- THE LIMIT — deliberately prominent -->
  <section id="limite" class="case-band-light mb-0">
    <div class="case-shell">
      <div class="case-limit fade-up" style="--delay: 0.05s">
        <span class="case-limit-tag">Alcance</span>
        <h2 class="case-limit-title">{study.limitSection.title}</h2>
        {study.limitSection.body.map(paragraph => (
          <p class="case-limit-text">{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- PROJECT FACTS -->
  <section id="ficha" class="case-band-dark mb-0">
    <div class="case-shell">
      <header class="case-section-head fade-up" style="--delay: 0.05s">
        <span class="case-section-eyebrow is-inverse">Ficha del proyecto</span>
        <h2 class="case-section-title is-inverse">Cómo se midió</h2>
      </header>
      <dl class="case-facts fade-up" style="--delay: 0.15s">
        {study.facts.map(fact => (
          <div class="case-fact">
            <dt class="case-fact-key">{fact.key}</dt>
            <dd class="case-fact-value">{fact.value}</dd>
          </div>
        ))}
      </dl>
      {study.sourceNote && (
        <p class="case-source fade-up" style="--delay: 0.25s">{study.sourceNote}</p>
      )}
    </div>
  </section>

  <!-- FAQ -->
  <div id="faq">
    <CaseFAQ faqs={study.faqs} label="Preguntas frecuentes" title="Lo que suelen preguntarnos sobre este caso" />
  </div>

  <!-- RELATED + CTA -->
  <section class="case-band-muted mb-0">
    <div class="case-shell">
      <div class="case-outro">
        <div class="case-outro-cases fade-up" style="--delay: 0.05s">
          <span class="case-section-eyebrow">Otros casos</span>
          <div class="case-related-grid">
            {related.map((other, i) => (
              <a href={`/${lang}/casos/${other.slug}/`} class="case-related-card">
                <span class="case-related-media">
                  <Fragment set:html={genCaseArt(other.slug, i + 1)} />
                  <span class="case-related-metric">{other.metrics[0].value}</span>
                </span>
                <span class="case-related-body">
                  <span class="case-related-client">{other.category}</span>
                  <span class="case-related-title">{other.title}</span>
                </span>
              </a>
            ))}
          </div>
        </div>

        <aside class="case-outro-cta fade-up" style="--delay: 0.15s">
          <h2 class="case-outro-title">¿Tienes un proceso parecido?</h2>
          <p class="case-outro-text">
            Podemos revisar el flujo actual, separar lo que conviene automatizar de lo que debe seguir bajo control humano y proponer una primera prueba medible.
          </p>
          <a href={`/${lang}/casos/`} class="case-outro-link">Ver todos los casos →</a>
          <a href={`/${lang}/#contact`} class="btn-primary btn-arrow">
            Hablar con OSIX
            <svg class="btn-arrow-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script>
  const revealHero = () => {
    document.querySelectorAll('.hero-el').forEach(el => el.classList.add('is-in'));
  };

  const start = () => {
    const skipDelay = !!window.location.hash;
    if (skipDelay) revealHero();
    else setTimeout(revealHero, 150);

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

    setTimeout(() => {
      document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
    }, skipDelay ? 0 : 900);
  };

  if ((window as any).isLoadingComplete) start();
  else window.addEventListener('loadingComplete', start);
</script>

<style is:global>
  /* ── Shell + bands ───────────────────────────────────────────── */
  .case-shell {
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  @media (min-width: 768px) {
    .case-shell { padding-left: 3rem; padding-right: 3rem; }
  }

  .case-band-light { background: #fff; padding: 4.5rem 0; display: block; }
  .case-band-muted { background: #f5f5f5; padding: 4.5rem 0; display: block; }
  .case-band-dark { background: #0a0a0a; padding: 4.5rem 0; display: block; }

  @media (min-width: 768px) {
    .case-band-light,
    .case-band-muted,
    .case-band-dark { padding: 6rem 0; }
  }

  .case-section-eyebrow {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(0, 0, 0, 0.4);
  }
  .case-section-eyebrow.is-inverse { color: rgba(255, 255, 255, 0.4); }

  .case-section-head { margin-bottom: 3rem; }

  .case-section-title {
    margin-top: 0.75rem;
    font-size: clamp(1.6rem, 3.4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #000;
    max-width: 34ch;
  }
  .case-section-title.is-inverse { color: #fff; }

  /* ── Hero ────────────────────────────────────────────────────── */
  .case-hero { padding: 4rem 0 4.5rem; display: block; }

  @media (min-width: 1024px) {
    .case-hero { padding: 5.5rem 0 6rem; }
  }

  .case-hero-inner {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .case-hero-inner { padding: 0 3rem; }
  }

  @media (min-width: 1024px) {
    .case-hero-inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 4rem;
    }
  }

  .case-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 1.75rem;
  }
  .case-crumbs a { color: inherit; text-decoration: none; transition: color 0.2s ease; }
  .case-crumbs a:hover { color: #fff; }

  .case-eyebrow {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #0a0a0a;
    background: #fff;
    padding: 0.4rem 0.75rem;
    margin-bottom: 1.25rem;
  }

  .case-h1 {
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
    margin-bottom: 1.25rem;
    max-width: 20ch;
  }

  .case-lead {
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.6);
    max-width: 60ch;
    margin-bottom: 2rem;
  }

  .case-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    margin-bottom: 2rem;
  }

  .case-meta-item { display: flex; flex-direction: column; gap: 0.3rem; max-width: 46ch; }

  .case-meta-key {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.35);
  }

  .case-meta-val { font-size: 0.95rem; font-weight: 600; color: #fff; line-height: 1.5; }

  .case-hero-cta { align-self: flex-start; }

  .case-hero-media { position: relative; margin: 0; }

  .case-hero-frame {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: #0a0a0a;
    overflow: hidden;
    aspect-ratio: 600 / 420;
  }

  /* Offset outline behind the frame */
  .case-hero-media::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    pointer-events: none;
  }

  .case-hero-frame svg { width: 100%; height: 100%; object-fit: cover; display: block; }

  .case-hero-caption {
    margin-top: 1rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.35);
  }

  /* ── Metrics ─────────────────────────────────────────────────── */
  .case-metrics-band {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 3rem 0;
  }

  @media (min-width: 768px) {
    .case-metrics-band { padding: 3.5rem 0; }
  }

  .case-metrics-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 2rem;
  }

  .case-metrics-secondary .case-metrics-label { color: rgba(0, 0, 0, 0.4); }

  .case-metrics-note {
    margin-top: 2rem;
    max-width: 62ch;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.55);
  }

  .case-metrics-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin: 0;
  }

  @media (min-width: 640px) {
    .case-metrics-row { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
  }

  .case-metric {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    position: relative;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i, 0) * 0.08s);
  }

  .case-metrics.is-revealed .case-metric { opacity: 1; transform: translateY(0); }

  .case-metric-value {
    order: -1; /* value reads first; DOM keeps the required dt → dd order */
    margin: 0;
    font-size: clamp(2.1rem, 4.4vw, 3.2rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .case-metric-label {
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.65);
  }

  .case-metric-note {
    font-size: 0.68rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.35);
    line-height: 1.4;
  }

  .case-metric-rule {
    display: block;
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i, 0) * 0.08s + 0.2s);
    margin-top: 0.4rem;
  }

  .case-metrics.is-revealed .case-metric-rule { transform: scaleX(1); }

  /* Secondary figures sit on a light band */
  .case-metrics-secondary .case-metric-value { color: #0a0a0a; font-size: clamp(1.7rem, 3.2vw, 2.4rem); }
  .case-metrics-secondary .case-metric-label { color: rgba(0, 0, 0, 0.7); }
  .case-metrics-secondary .case-metric-note { color: rgba(0, 0, 0, 0.4); }
  .case-metrics-secondary .case-metric-rule { background: rgba(0, 0, 0, 0.15); }

  /* ── Narrative stack ─────────────────────────────────────────── */
  .cns-card {
    width: 100%;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: 0 4px 32px rgba(0, 0, 0, 0.06);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .cns-card { padding: 3rem 3.5rem; }
  }

  .cns-head {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .cns-index {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: rgba(0, 0, 0, 0.25);
    padding-top: 0.4rem;
  }

  .cns-title {
    font-size: clamp(1.3rem, 2.4vw, 1.9rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #000;
  }

  .cns-body { display: flex; flex-direction: column; gap: 1rem; }

  .cns-text { font-size: 1rem; line-height: 1.75; color: #555; max-width: 70ch; }

  .cns-cta {
    width: 100%;
    background: #0a0a0a;
    padding: 3rem 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .cns-cta { padding: 4rem 3.5rem; }
  }

  .cns-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 46rem;
  }

  .cns-cta-title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .cns-cta-text { font-size: 1rem; line-height: 1.7; color: rgba(255, 255, 255, 0.6); }

  /* ── The limit callout ───────────────────────────────────────── */
  .case-limit {
    border-left: 3px solid #0a0a0a;
    padding: 0.5rem 0 0.5rem 2rem;
    max-width: 58rem;
  }

  .case-limit-tag {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    background: #0a0a0a;
    color: #fff;
    padding: 0.35rem 0.7rem;
    margin-bottom: 1.25rem;
  }

  .case-limit-title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #000;
    margin-bottom: 1.25rem;
  }

  .case-limit-text {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #444;
    margin-bottom: 1rem;
  }

  .case-limit-text:last-child { margin-bottom: 0; }

  /* ── Project facts ───────────────────────────────────────────── */
  .case-facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (min-width: 900px) {
    .case-facts { grid-template-columns: 1fr 1fr; column-gap: 4rem; }
  }

  .case-fact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .case-fact-key {
    flex: 0 0 11rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.4);
    padding-top: 0.15rem;
  }

  .case-fact-value {
    flex: 1 1 12rem;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  .case-source {
    margin-top: 2.5rem;
    max-width: 60ch;
    font-size: 0.85rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.45);
  }

  /* ── Outro ───────────────────────────────────────────────────── */
  .case-outro {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

