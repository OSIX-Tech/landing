---
import Layout from '../../../layouts/Layout.astro';
import LoadingScreen from '../../../components/LoadingScreen.astro';
import BeamsBackground from '../../../components/BeamsBackground.jsx';
import { getCaseStudyCards } from '../../../data/case-studies';
import { genCaseArt } from '../../../utils/caseArt';
import type { Lang } from '../../../utils/languages';

export const prerender = true;

export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang = 'es' } = Astro.params as { lang: Lang };
const cards = getCaseStudyCards();
const canonicalUrl = `https://osix.tech/${lang}/casos/`;

const seoTitle = 'Casos de estudio de automatización e IA | OSIX Tech';
const seoDescription =
  'Casos de estudio de OSIX Tech: software a medida, automatización documental, OCR e inteligencia artificial con métricas de producción.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: canonicalUrl,
  name: seoTitle,
  description: seoDescription,
  inLanguage: lang,
  publisher: { '@type': 'Organization', name: 'OSIX Tech', url: 'https://osix.tech' },
  mainEntity: cards.map((c, i) => ({
    '@type': 'Article',
    name: c.title,
    url: `https://osix.tech${c.href}`,
    position: i + 1,
  })),
};
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="website"
  canonical={canonicalUrl}
  jsonLd={jsonLd}
>
  <LoadingScreen duration={1000} />

  <section class="cases-hub-hero relative bg-black overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="absolute inset-0 z-0">
      <BeamsBackground client:only="react" beamWidth={4} beamHeight={20} beamNumber={10} speed={2} noiseIntensity={0.5} scale={0.2} rotation={30} />
    </div>
    <div class="cases-hub-hero-inner">
      <span class="cases-hub-badge">Casos OSIX · software en producción</span>
      <h1 class="cases-hub-title">Software que ya está trabajando</h1>
      <p class="cases-hub-lead">
        Productos que procesan documentos, ordenan correo, preparan ofertas y convierten documentación en respuestas.
        Cada caso publica la ventana medida y lo que la cifra no demuestra.
      </p>
    </div>
  </section>

  <section class="cases-hub-body mb-0">
    <div class="case-shell">
      <div class="cases-hub-grid">
        {cards.map((item, i) => (
          <a href={item.href} class="case-hub-card fade-up" style={`--delay: ${(i % 3) * 0.08}s`}>
            <span class="case-hub-media">
              <Fragment set:html={genCaseArt(item.slug, i)} />
              <span class="case-hub-metric">
                <span class="case-hub-metric-value">{item.metric.value}</span>
                <span class="case-hub-metric-label">{item.metric.label}</span>
              </span>
            </span>
            <span class="case-hub-body">
              <span class="case-hub-tag">{item.category}</span>
              <h2 class="case-hub-title">{item.title}</h2>
              <p class="case-hub-desc">{item.lead}</p>
              <span class="case-hub-link">
                Leer el caso completo
                <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  const start = () => {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

    document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
  };

  if ((window as any).isLoadingComplete) start();
  else window.addEventListener('loadingComplete', start);
</script>

<style is:global>
  .case-shell {
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  @media (min-width: 768px) {
    .case-shell { padding-left: 3rem; padding-right: 3rem; }
  }

  .cases-hub-hero { display: block; padding: 5rem 0 5.5rem; }

  @media (min-width: 1024px) {
    .cases-hub-hero { padding: 7rem 0 7.5rem; }
  }

  .cases-hub-hero-inner {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 62rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .cases-hub-hero-inner { padding: 0 3rem; }
  }

  .cases-hub-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #0a0a0a;
    background: #fff;
    padding: 0.4rem 0.75rem;
    margin-bottom: 1.5rem;
  }

  .cases-hub-title {
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
    margin-bottom: 1.5rem;
  }

  .cases-hub-lead {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: #fff;
    max-width: 48rem;
    margin: 0 auto;
  }

  .cases-hub-body { display: block; background: #fff; padding: 4.5rem 0; }

  @media (min-width: 768px) {
    .cases-hub-body { padding: 6rem 0; }
  }

  .cases-hub-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .cases-hub-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .cases-hub-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .case-hub-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    text-decoration: none;
    color: #0a0a0a;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
  }

  .case-hub-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.12);
  }

  .case-hub-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0a0a0a;
  }

  .case-hub-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .case-hub-card:hover .case-hub-media svg { transform: scale(1.05); }

  .case-hub-metric {
    position: absolute;
    left: 1.25rem;
    bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .case-hub-metric-value {
    font-size: 2.1rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: #fff;
  }

  .case-hub-metric-label {
    font-size: 0.65rem;
    font-weight: 600;
    color: #fff;
  }

  .case-hub-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.75rem;
    padding: 1.5rem;
  }

  .case-hub-tag {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(0, 0, 0, 0.45);
  }

  .case-hub-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: #000;
  }

  .case-hub-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #555;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .case-hub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #000;
  }

  .case-hub-card:hover .case-hub-link .btn-arrow-icon { transform: translateX(4px); }

  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }
  .fade-up.in-view { opacity: 1; transform: translateY(0); }

  @media (prefers-reduced-motion: reduce) {
    .fade-up,
    .case-hub-card,
    .case-hub-media svg {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>
