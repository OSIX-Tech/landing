---
import Layout from '../../../layouts/Layout.astro';
import LoadingScreen from '../../../components/LoadingScreen.astro';

export const prerender = true;

// Guía actualmente en español (prompt BOFU: cómo automatizar documentos sin perder la revisión humana). Ampliar a en/gl cuando exista traducción.
export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang = 'es' } = Astro.params;

const GuideContent = (await import('../../../content/es/guias/automatizar-documentos-sin-perder-revision-humana.md')).default;

const canonicalUrl = `https://osix.tech/${lang}/guias/automatizar-documentos-sin-perder-revision-humana/`;

// SEO Data
const seoTitle = 'Automatizar documentos sin perder la revisión humana: 6 tipos por retorno (2026) - OSIX Tech';
const seoDescription = 'Cómo automatizar documentos sin perder la revisión humana: seis tipos de documento ordenados por retorno y riesgo, los controles de supervisión y cuándo no conviene automatizar.';

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué es human-in-the-loop y por qué importa para documentos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Human-in-the-loop (HITL) es un sistema donde una persona participa en la supervisión o en la decisión de un proceso automatizado. En documentos importa porque la mayoría de los errores no son de lectura, son de contexto: un importe raro, una cláusula que no toca, un proveedor nuevo. El diseño HITL hace que esos casos se detengan y lleguen a una persona con el contexto necesario para decidir."
      }
    },
    {
      "@type": "Question",
      "name": "¿Automatizar documentos con datos personales es legal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Automatizar no cambia tu responsabilidad como responsable del tratamiento: sigues obligado a que el tratamiento sea correcto, proporcionado y seguro. Además, cuando un sistema de IA se usa en casos que la normativa europea clasifica como de alto riesgo, la supervisión humana no es una opción de diseño, es un requisito del artículo 14 del Reglamento de IA de la UE. Para la automatización documental interna de una pyme, facturas, ofertas o informes, el riesgo suele ser limitado, pero conviene dejar documentado qué revisa una persona y por qué."
      }
    },
    {
      "@type": "Question",
      "name": "¿Puedo dejar que la IA apruebe y revisar después?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Solo en procesos de bajo riesgo y reversibles, con muestreo y revisión posterior por alerta. Si el documento genera un pago, un compromiso o una obligación, la aprobación humana va antes, no después. La regla del diseño es que la persona se sitúe donde el error duele."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta mantener la revisión humana?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Depende de cuántas excepciones genere el proceso. Un diseño honesto arranca con un porcentaje alto de revisión y lo baja con datos, cuando las reglas demuestran que pueden confiar en el resto. Si desde el primer día la bandeja recibe más casos de los que el equipo puede atender, el proceso no está listo para automatizar. El objetivo no es revisar cero, es revisar menos y mejor."
      }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · Automatización documental · Revisión humana · Pymes · España</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">
          Automatizar documentos sin perder la revisión humana
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">
          Seis tipos de documento ordenados por retorno y riesgo, los controles que mantienen la supervisión humana y los casos donde no conviene automatizar.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-4xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <div class="related-guides mt-12 fade-up" style="--delay: 0.3s">
        <h2 class="related-guides-title">Guías relacionadas</h2>
        <ul class="related-guides-list">
          <li><a href="/es/guias/automatizar-facturas-documentos-pyme/">Cómo automatizar las facturas y los documentos de tu pyme</a></li>
          <li><a href="/es/guias/integrar-ia-software-pyme-espana/">Cómo integrar la IA con el software que ya usa tu empresa</a></li>
          <li><a href="/es/guias/donde-se-guardan-datos-ia-empresa/">Dónde se guardan los datos de tu empresa con un sistema de IA</a></li>
          <li><a href="/es/guias/medir-resultados-ia-pyme/">Cómo medir si la IA de tu pyme está dando resultados</a></li>
        </ul>      </div>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/${lang}/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * tables are `white-space: nowrap` inside their scroll containers, the intrinsic
   * width of the whole article is the table width (well over the phone viewport), so the
   * column rendered ~896px wide on a 390px phone and html/body's overflow-x:clip chopped
   * the right edge off every paragraph. Fix: make the section a normal block so its child
   * caps at the viewport, and let the tables keep scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }
  .content-section .max-w-4xl {
    max-width: 100%;
    min-width: 0;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section transitions */
  .hero-section { animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroReveal { from { opacity: 0; } to { opacity: 1; } }
</style>
