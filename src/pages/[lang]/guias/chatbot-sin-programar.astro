---
import Layout from '../../../layouts/Layout.astro';
import LoadingScreen from '../../../components/LoadingScreen.astro';

export const prerender = true;

// Guía en español (prompt: chatbot sin programar). Ampliar a en/gl cuando exista traducción.
export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang = 'es' } = Astro.params;

const GuideContent = (await import('../../../content/es/guias/chatbot-sin-programar.md')).default;

const canonicalUrl = `https://osix.tech/${lang}/guias/chatbot-sin-programar/`;

// SEO Data
const seoTitle = '¿Puedo montar un chatbot para mi empresa sin saber programar? (2026) - OSIX Tech';
const seoDescription = 'Sí, puedes montar un chatbot sin programar con Landbot, ManyChat o Botpress... y cuándo no te vale: la guía honesta con precios reales y el límite de las herramientas no-code frente al desarrollo a medida.';

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Puedo montar un chatbot en WhatsApp sin saber programar?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí. Plataformas como ManyChat, Chatfuel, Landbot o el WhatsApp Business API de terceros montan un bot por reglas que responde, capta y deriva. Eso cubre el caso estándar. Si el bot tiene que leer documentos, consultar un ERP o mantener contexto largo, necesitarás desarrollo." }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto se tarda en montar un chatbot sin programar?",
      "acceptedAnswer": { "@type": "Answer", "text": "Un prototipo con respuestas preparadas: horas. Un bot en producción con flujos, formularios y CRM: de 2 a 5 días con las herramientas no-code. Un sistema a medida que lee documentos: de 2 a 6 semanas." }
    },
    {
      "@type": "Question",
      "name": "¿ChatGPT puede ser mi chatbot?",
      "acceptedAnswer": { "@type": "Answer", "text": "Puede ser la base del asistente, pero no lo publiques directamente contra tus clientes sin límites: hay que entrenarlo o conectarlo a tus datos, definir cuándo escala a humano y controlar las respuestas. Eso es lo que convierte ChatGPT en un producto, y requiere trabajo técnico." }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta un chatbot para una pyme en 2026?",
      "acceptedAnswer": { "@type": "Answer", "text": "Con no-code, desde 0 hasta 300 €/mes según plan y volumen. Un asistente a medida que se integra con tus herramientas, de 5.000 a 20.000 € según alcance, más mantenimiento." }
    },
    {
      "@type": "Question",
      "name": "¿Qué es mejor para mi caso: Landbot, ManyChat o un desarrollo a medida?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si el caso es atención y captación estándar, cualquiera de las no-code te vale y la elección es de interfaz y precio. Si el chatbot tiene que entender tus documentos o conectarse a tus sistemas, la respuesta honesta es desarrollo a medida: no hay plugin que sustituya a un sistema que lee tus datos." }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · Chatbots · Pymes</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">
          ¿Puedo montar un chatbot para mi empresa sin saber programar?
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">
          Sí, con herramientas no-code... y cuándo no te vale. La respuesta y el límite honesto en 2026.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-4xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <!-- Related guides (internal linking for indexation) -->
      <div class="related-guides mt-12 fade-up" style="--delay: 0.3s">
        <h2 class="related-guides-title">Guías relacionadas</h2>
        <ul class="related-guides-list">
          <li><a href="/es/guias/contratar-empresa-ia-o-usar-herramientas/">¿Contratar empresa de IA o usar herramientas hechas?</a></li>
          <li><a href="/es/guias/mejores-herramientas-ia-pymes/">Las mejores herramientas de IA para pymes en España</a></li>
          <li><a href="/es/guias/cuanto-cuesta-automatizar-con-ia-pyme-espana/">Cuánto cuesta automatizar procesos con IA en una pyme</a></li>
        </ul>
      </div>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/${lang}/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * comparison table is `white-space: nowrap` inside its scroll container, the intrinsic
   * width of the whole article is the table width (well over the phone viewport), so the
   * column rendered ~896px wide on a 390px phone and html/body's overflow-x:clip chopped
   * the right edge off every paragraph. Fix: make the section a normal block so its child
   * caps at the viewport, and let the table keep scrolling inside its own container.
   */
  .content-section {
    display: block;
    width: 100%;
  }
  .content-section .max-w-4xl {
    max-width: 100%;
    min-width: 0;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section transitions */
  .hero-section { animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroReveal { from { opacity: 0; } to { opacity: 1; } }
</style>