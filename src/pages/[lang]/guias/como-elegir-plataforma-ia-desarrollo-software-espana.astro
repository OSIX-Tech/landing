---
import Layout from '../../../layouts/Layout.astro';
import LoadingScreen from '../../../components/LoadingScreen.astro';

export const prerender = true;

// Guía actualmente en español (apunta al prompt MOFU de criterios de plataforma de desarrollo con IA). Ampliar a en/gl cuando exista traducción.
export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang = 'es' } = Astro.params;

const GuideContent = (await import('../../../content/es/guias/como-elegir-plataforma-ia-desarrollo-software-espana.md')).default;

const canonicalUrl = `https://osix.tech/${lang}/guias/como-elegir-plataforma-ia-desarrollo-software-espana/`;

// SEO Data
const seoTitle = 'Cómo elegir una plataforma de desarrollo de software con IA en España (2026): 8 criterios - OSIX Tech';
const seoDescription = 'Los 8 criterios para elegir una plataforma de desarrollo de software con IA en España en 2026: cumplimiento normativo (Ley de IA, RGPD, AEPD), calidad del código, integración, datos, propiedad intelectual y coste total. Con fuentes oficiales.';

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué plataforma de desarrollo con IA es mejor en 2026?",
      "acceptedAnswer": { "@type": "Answer", "text": "No hay una mejor universal: depende del caso de uso, del stack de tu equipo y de los datos que manejes. Los ocho criterios de la guía (cumplimiento normativo, calidad del código, integración, datos, propiedad intelectual, escalabilidad, coste total y soporte) permiten comparar con objetividad. Para una pyme española, el cumplimiento normativo y dónde se alojan los datos suelen decantar la elección tanto como la capacidad técnica." }
    },
    {
      "@type": "Question",
      "name": "¿Es mejor una plataforma low-code o desarrollo a medida?",
      "acceptedAnswer": { "@type": "Answer", "text": "Depende del proyecto. Las plataformas low-code aceleran prototipos y casos estándar. El desarrollo a medida tiene sentido cuando necesitas lógica compleja, integraciones profundas, una aplicación nueva o garantías de propiedad y portabilidad." }
    },
    {
      "@type": "Question",
      "name": "¿La plataforma puede usar mi código para entrenar sus modelos?",
      "acceptedAnswer": { "@type": "Answer", "text": "Depende de la plataforma y de su contrato. Es la pregunta número uno que debes hacer, y la respuesta debe ser por escrito. Algunas plataformas ofrecen cláusulas de exclusión de entrenamiento; otras no." }
    },
    {
      "@type": "Question",
      "name": "¿Necesito tener un equipo técnico para usar una plataforma de IA?",
      "acceptedAnswer": { "@type": "Answer", "text": "Las plataformas low-code reducen la barrera, pero el mantenimiento, la integración y la supervisión humana siguen requiriendo criterio técnico. Muchas pymes combinan una plataforma con una consultora que la configura y la mantiene." }
    },
    {
      "@type": "Question",
      "name": "¿Qué ayudas públicas existen para un proyecto de IA en España?",
      "acceptedAnswer": { "@type": "Answer", "text": "Programas como Kit Digital (para digitalización de pymes) y líneas autonómicas como las de IGAPE en Galicia pueden cubrir parte del coste de implantación. Las convocatorias cambian cada año: verifica las condiciones vigentes en las fuentes oficiales antes de planificar el presupuesto." }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · Criterios · Plataformas de IA · España</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">
          Cómo elegir una plataforma de desarrollo de software con IA
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">
          Los 8 criterios que funcionan en 2026, con la normativa europea y las señales de alerta de cada uno.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-4xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/${lang}/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * criteria table is `white-space: nowrap` inside its scroll container, the intrinsic
   * width of the whole article is the table width, so the column renders wider than a
   * phone viewport and html/body's overflow-x:clip chops the right edge off every
   * paragraph. Fix: make the section a normal block so its child caps at the viewport,
   * and let the table keep scrolling inside its own container.
   */
  .content-section {
    display: block;
    width: 100%;
  }
  .content-section .max-w-4xl {
    max-width: 100%;
    min-width: 0;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section transitions */
  .hero-section { animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroReveal { from { opacity: 0; } to { opacity: 1; } }
</style>