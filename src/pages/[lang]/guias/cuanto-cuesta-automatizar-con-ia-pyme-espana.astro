---
import Layout from '../../../layouts/Layout.astro';
import LoadingScreen from '../../../components/LoadingScreen.astro';

export const prerender = true;

// Guía actualmente en español (apunta al prompt BOFU de coste). Ampliar a en/gl cuando exista traducción.
export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang = 'es' } = Astro.params;

const GuideContent = (await import('../../../content/es/guias/cuanto-cuesta-automatizar-con-ia-pyme-espana.md')).default;

const canonicalUrl = `https://osix.tech/${lang}/guias/cuanto-cuesta-automatizar-con-ia-pyme-espana/`;

// SEO Data
const seoTitle = 'Cuánto cuesta automatizar procesos con IA en una pyme española (2026): precios reales por tipo de proyecto - OSIX Tech';
const seoDescription = 'Cuánto cuesta un proyecto de automatización con IA para una pyme en España en 2026: precios reales por tipo de proyecto, qué incluye cada presupuesto, cómo saber si es justo y qué ayudas públicas (Kit Consulting, Kit Digital, IGAPE IA360) pueden pagarlo.';

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta automatizar un proceso con IA en una pyme en España?",
      "acceptedAnswer": { "@type": "Answer", "text": "Entre 3.000 y 5.000 € para un proceso sencillo automatizado de punta a punta, hasta 15.000 € para varios procesos o un copiloto interno, y 9.000 a 25.000 € para una plataforma IA con marca propia. A eso se suman 200 a 800 €/mes de operación. Programas como Kit Consulting o las ayudas autonómicas pueden cubrir parte del coste." }
    },
    {
      "@type": "Question",
      "name": "¿En cuánto tiempo se ven resultados?",
      "acceptedAnswer": { "@type": "Answer", "text": "Un primer entregable funcional puede estar listo en 2 a 4 semanas desde el arranque; los ahorros operativos suelen notarse entre el mes 2 y 4 tras el despliegue, y el retorno se consolida en 2 a 6 meses si el alcance estaba bien definido." }
    },
    {
      "@type": "Question",
      "name": "¿Es mejor montarlo yo con n8n o Make?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si tienes un perfil técnico y quieres control de tus datos, montarlo tú es viable para un flujo sencillo. Pero para un proceso que toca tu ERP o CRM, o que necesita una aplicación o agente complejo, el desarrollo a medida casi siempre da mejor resultado, porque incluye diseño, integración y mantenimiento." }
    },
    {
      "@type": "Question",
      "name": "¿Cada cuánto hay que pagar mantenimiento?",
      "acceptedAnswer": { "@type": "Answer", "text": "Un retainer de 300 a 800 €/mes (4 a 12 horas) mantiene el sistema activo y lo adapta a cambios en tus herramientas. Es la partida que las pymes más tienden a saltarse, y la que evita que una automatización muera en unos meses." }
    },
    {
      "@type": "Question",
      "name": "¿Las ayudas cubren el proyecto entero?",
      "acceptedAnswer": { "@type": "Answer", "text": "No siempre entero, pero sí una parte importante. Kit Consulting financia asesoramiento de IA (hasta 12.000 a 24.000 € según tamaño); Kit Digital y las líneas autonómicas como IGAPE IA360 cubren implantación. El proveedor debe saber diseñar el proyecto para que sea elegible." }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · Precios · Automatización con IA · España</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">
          Cuánto cuesta automatizar procesos con IA en una pyme española
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">
          Precios reales por tipo de proyecto en 2026, qué incluye cada presupuesto y cómo las ayudas públicas pueden pagarlo.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-4xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/${lang}/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * price tables are `white-space: nowrap` inside their scroll containers, the intrinsic
   * width of the whole article is the table width (well over the phone viewport), so the
   * column rendered ~896px wide on a 390px phone and html/body's overflow-x:clip chopped
   * the right edge off every paragraph. Fix: make the section a normal block so its child
   * caps at the viewport, and let the tables keep scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }
  .content-section .max-w-4xl {
    max-width: 100%;
    min-width: 0;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section transitions */
  .hero-section { animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroReveal { from { opacity: 0; } to { opacity: 1; } }
</style>
