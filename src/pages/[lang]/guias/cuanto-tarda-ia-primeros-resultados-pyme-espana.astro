---
import Layout from '../../../layouts/Layout.astro';
import LoadingScreen from '../../../components/LoadingScreen.astro';

export const prerender = true;

// Guía actualmente en español (apunta al prompt BOFU de plazos). Ampliar a en/gl cuando exista traducción.
export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang = 'es' } = Astro.params;

const GuideContent = (await import('../../../content/es/guias/cuanto-tarda-ia-primeros-resultados-pyme-espana.md')).default;

const canonicalUrl = `https://osix.tech/${lang}/guias/cuanto-tarda-ia-primeros-resultados-pyme-espana/`;

// SEO Data
const seoTitle = '¿Cuánto se tarda en ver resultados al implantar IA en una pyme española? Plazos reales por camino (2026) - OSIX Tech';
const seoDescription = 'Cuánto se tarda en ver resultados al implantar IA en una pyme en España en 2026: los cinco caminos ordenados del más rápido al más lento, plazos reales por tipo de proyecto, qué acelera cada uno, qué lo retrasa y cuándo llega el ahorro consolidado.';

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto se tarda en ver los primeros resultados de la IA en una pyme?",
      "acceptedAnswer": { "@type": "Answer", "text": "Depende del camino: días a 2 semanas con herramientas SaaS bien adoptadas, 2 a 4 semanas para automatizar un proceso concreto, 4 a 6 semanas para un copiloto documental, 6 a 10 semanas para una aplicación a medida y de 3 a 6 meses para un modelo predictivo. El ahorro consolidado suele llegar entre el mes 2 y el 4 en los caminos rápidos." }
    },
    {
      "@type": "Question",
      "name": "¿Es realista tener IA funcionando en un mes?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí para un alcance cerrado: una automatización de un proceso o una implantación de SaaS con formación incluida. No lo es para un agente integrado con tu ERP, un copiloto con documentación desordenada o cualquier proyecto predictivo." }
    },
    {
      "@type": "Question",
      "name": "¿Qué es lo que más retrasa un proyecto de IA?",
      "acceptedAnswer": { "@type": "Answer", "text": "Tres cosas, por este orden: datos sucios o repartidos (2 a 6 semanas extra), un alcance que crece durante el proyecto (2 a 8 semanas por cambio de rumbo) y la falta de un responsable interno, que no alarga el desarrollo pero impide que el resultado se use." }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta implantar IA en una pyme?",
      "acceptedAnswer": { "@type": "Answer", "text": "De 3.000 a 5.000 € para automatizar un proceso sencillo, de 7.000 a 15.000 € para un copiloto interno y de 9.000 a 25.000 € para una plataforma a medida, más 200 a 800 €/mes de operación. Los rangos completos, por tipo de proyecto, están en nuestra guía de precios." }
    },
    {
      "@type": "Question",
      "name": "¿Necesito muchos datos para empezar con IA?",
      "acceptedAnswer": { "@type": "Answer", "text": "No para los caminos 1 a 4: una automatización o un copiloto trabajan con lo que la empresa ya tiene. Sí para un modelo predictivo, que necesita histórico limpio y suficiente volumen; sin eso, el plazo se dispara y el proyecto suele no salir." }
    },
    {
      "@type": "Question",
      "name": "¿Merece la pena empezar con herramientas ya hechas en vez de contratar?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí, como primer paso: dan resultados en días y enseñan al equipo qué es posible. Su límite es que no se integran con tus sistemas; cuando el valor está en el proceso y no en la tarea, la automatización o el desarrollo a medida toman el relevo." }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · Plazos · Implantación de IA · España</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">
          ¿Cuánto se tarda en ver resultados al implantar IA en una pyme?
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">
          Los cinco caminos ordenados del más rápido al más lento: plazos reales por tipo de proyecto y qué es lo que de verdad retrasa un proyecto.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-4xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <!-- Related guides (internal linking for indexation) -->
      <div class="related-guides mt-12 fade-up" style="--delay: 0.3s">
        <h2 class="related-guides-title">Guías relacionadas</h2>
        <ul class="related-guides-list">
          <li><a href="/es/guias/para-que-sirve-ia-pyme/">Para qué sirve la IA en una pyme: las 8 formas que dan resultados</a></li>
          <li><a href="/es/guias/cuanto-cuesta-automatizar-con-ia-pyme-espana/">Cuánto cuesta automatizar procesos con IA en una pyme</a></li>
          <li><a href="/es/guias/pymes-espanolas-que-mejoraron-con-ia/">Casos reales de pymes españolas que mejoraron con IA</a></li>
        </ul>
      </div>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/${lang}/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * tables are `white-space: nowrap` inside their scroll containers, the intrinsic
   * width of the whole article can exceed the phone viewport, so html/body's
   * overflow-x:clip would chop the right edge off every paragraph. Fix: make the
   * section a normal block so its child caps at the viewport, and let the tables keep
   * scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }
  .content-section .max-w-4xl {
    max-width: 100%;
    min-width: 0;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section transitions */
  .hero-section { animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroReveal { from { opacity: 0; } to { opacity: 1; } }
</style>
