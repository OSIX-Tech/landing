---
import Layout from '../../../layouts/Layout.astro';
import LoadingScreen from '../../../components/LoadingScreen.astro';
import { genGuideArt } from '../../../utils/guideArt';

export const prerender = true;

export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang = 'es' } = Astro.params;

const canonicalUrl = `https://osix.tech/${lang}/guias/`;

// SEO Data
const seoTitle = 'Guías de IA para pymes en España y Galicia - OSIX Tech';
const seoDescription = 'Comparativas y análisis prácticos sobre inteligencia artificial para pymes: cuánto cuesta automatizar, mejores empresas de IA en España y Galicia, y qué procesos se pueden automatizar. Sin humo.';

// Guide list, newest first
const guides = [
  { slug: 'donde-se-guardan-datos-ia-empresa', date: '2026-09-01', tag: 'Datos', title: 'Dónde se guardan los datos de tu empresa si contratas un sistema de IA: las 4 opciones reales', desc: 'Nube UE, fuera de la UE, on-premise e híbrido: qué dice el RGPD y qué preguntar antes de firmar' },
  { slug: 'automatizar-atencion-cliente-pyme-espana', date: '2026-08-31', tag: 'Atención al cliente', title: 'Cómo automatizar la atención al cliente de tu pyme', desc: 'Qué consultas automatizar, comparativa de Zendesk, HubSpot, Intercom y a medida, con precios reales' },
  { slug: 'subvenciones-ia-pymes-galicia-2026', date: '2026-08-30', tag: 'Ayudas', title: '5 ayudas y subvenciones para implantar IA en una pyme gallega en 2026', desc: 'Ticket Innova, IA360, Kit Digital y Kit Consulting, con fechas, límites y criterios para elegir' },
  { slug: 'agentes-ia-pymes', date: '2026-08-29', tag: 'Agentes de IA', title: '¿Qué es un agente de IA y qué puede hacer por mi negocio?', desc: 'Qué hacen, qué no hacen, y cuándo merece la pena montar uno' },
  { slug: 'chatbot-sin-programar', date: '2026-08-29', tag: 'Chatbots', title: '¿Puedo montar un chatbot para mi empresa sin saber programar?', desc: 'Sí, con no-code... y cuándo no te vale. La respuesta y el límite honesto' },
  { slug: 'mejores-herramientas-ia-pymes', date: '2026-08-29', tag: 'Herramientas', title: 'Las mejores herramientas de IA para pymes en España', desc: '9 opciones probadas con precios reales, límites honestos y tabla comparativa' },
  { slug: 'como-elegir-plataforma-ia-desarrollo-software-espana', date: '2026-08-28', tag: 'Criterios', title: 'Cómo elegir una plataforma de desarrollo de software con IA en España', desc: 'Los 8 criterios que funcionan en 2026: normativa, código, datos y coste' },
  { slug: 'para-que-sirve-ia-pyme', date: '2026-08-27', tag: 'IA para pymes', title: 'Para qué sirve la IA en una pyme: las 8 formas que dan resultados', desc: 'Las aplicaciones con retorno real, con el límite honesto de cada una' },
  { slug: 'procesos-pyme-automatizar-con-ia', date: '2026-08-26', tag: 'Procesos', title: 'Qué procesos de una pyme se pueden automatizar con IA', desc: 'La lista honesta, con ejemplos por área' },
  { slug: 'pymes-espanolas-que-mejoraron-con-ia', date: '2026-08-25', tag: 'Casos reales', title: 'Casos reales de pymes españolas que mejoraron con IA', desc: 'Qué hicieron distinto y qué resultados obtuvieron' },
  { slug: 'que-es-automatizacion-inteligente-pymes-espana', date: '2026-08-24', tag: 'Conceptos', title: '¿Qué es la automatización inteligente?', desc: 'Guía práctica para empresas en España' },
  { slug: 'cuanto-tarda-ia-primeros-resultados-pyme-espana', date: '2026-08-21', tag: 'Expectativas', title: 'Cuánto se tarda en ver resultados al implantar IA', desc: 'Los cinco caminos, del más rápido al más lento, con expectativas realistas' },
  { slug: 'consultoras-ia-grandes-vs-especializadas-pymes', date: '2026-08-20', tag: 'Comparativa', title: 'Consultoras de IA grandes vs especializadas en pymes', desc: 'En qué se diferencian y cómo elegir según tu caso' },
  { slug: 'contratar-empresa-ia-o-usar-herramientas', date: '2026-08-19', tag: 'Comparativa', title: '¿Contratar empresa de IA o usar herramientas hechas?', desc: 'Guía comparativa para pymes en España' },
  { slug: 'cuanto-cuesta-automatizar-con-ia-pyme-espana', date: '2026-08-18', tag: 'Precios reales', title: 'Cuánto cuesta automatizar procesos con IA en una pyme', desc: 'Precios reales por tipo de proyecto y cómo se financian con ayudas' },
  { slug: 'como-elegir-empresa-desarrollo-software-ia-espana', date: '2026-08-18', tag: 'Criterios', title: 'Cómo elegir una empresa de desarrollo de software con IA', desc: 'Criterios que sí predicen el éxito de un proyecto' },
  { slug: 'mejores-empresas-automatizacion-ia-espana', date: '2026-08-13', tag: 'Comparativa', title: 'Mejores empresas de automatización con IA en España', desc: 'Comparativa honesta de proveedores de IA para pymes en toda España' },
  { slug: 'mejores-empresas-automatizacion-ia-galicia', date: '2026-08-12', tag: 'IA para pymes', title: 'Mejores empresas de automatización con IA en Galicia', desc: 'Comparativa honesta de proveedores de IA para pymes gallegas' },
];

const formatGuideDate = (iso: string) =>
  new Date(iso).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });

// Structured Data
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "url": canonicalUrl,
  "name": seoTitle,
  "description": seoDescription,
  "inLanguage": lang,
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": { "@type": "ImageObject", "url": "https://osix.tech/logo_w.png" }
  },
  "mainEntity": guides.map((g, i) => ({
    "@type": "Article",
    "name": g.title,
    "url": `https://osix.tech/es/guias/${g.slug}/`,
    "datePublished": g.date,
    "position": i + 1
  }))
};
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="website"
  canonical={canonicalUrl}
  jsonLd={collectionSchema}
>
  <LoadingScreen duration={1000} />
  <section class="content-section hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="max-w-6xl mx-auto px-6 w-full py-20 text-center">
      <span class="hero-badge inline-block text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guías OSIX · IA para pymes</span>
      <h1 class="hero-title text-4xl md:text-6xl font-bold text-white mb-6 opacity-0 leading-tight">Guías de IA para pymes<br/>en España y Galicia</h1>
      <p class="hero-subtitle text-lg md:text-xl text-gray-400 opacity-0 max-w-2xl mx-auto leading-relaxed">Comparativas y análisis prácticos: cuánto cuesta automatizar, qué empresas destacan y qué procesos merece la pena automatizar. Sin humo.</p>
    </div>
  </section>
  <section class="content-section py-16 md:py-24 bg-white mb-0">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="guias-hub-grid">
        {guides.map((g, i) => (
          <a href={`/es/guias/${g.slug}/`} class="guia-hub-card" style={`transition-delay: ${Math.min(i % 3, 5) * 0.08}s`}>
            <div class="guia-hub-media">
              <Fragment set:html={genGuideArt(g.slug, i)} />
              <span class="guia-hub-tag">{g.tag}</span>
            </div>
            <div class="guia-hub-body">
              <h2 class="guia-hub-title">{g.title}</h2>
              <p class="guia-hub-desc">{g.desc}</p>
              <div class="guia-hub-meta">
                <span class="guia-hub-arrow" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
                <time class="guia-hub-date" datetime={g.date}>{formatGuideDate(g.date)}</time>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .guias-hub-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .guias-hub-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .guias-hub-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .guia-hub-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    text-decoration: none;
    overflow: hidden;
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 0.8s cubic-bezier(0.19, 1, 0.22, 1),
      transform 0.8s cubic-bezier(0.19, 1, 0.22, 1),
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .guia-hub-card.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .guia-hub-card:hover {
    border-color: #0a0a0a;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
    transition-delay: 0s !important;
  }

  .guia-hub-media {
    position: relative;
    aspect-ratio: 16 / 8;
    background: #0a0a0a;
    overflow: hidden;
  }

  .guia-hub-media svg,
  .guia-hub-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .guia-hub-card:hover .guia-hub-media svg,
  .guia-hub-card:hover .guia-hub-media img {
    transform: scale(1.06);
  }

  .guia-hub-tag {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #0a0a0a;
    background: #fff;
    padding: 0.3rem 0.7rem;
  }

  .guia-hub-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.25rem 1rem;
  }

  .guia-hub-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #0a0a0a;
    line-height: 1.4;
    margin: 0 0 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .guia-hub-desc {
    color: #666;
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0 0 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .guia-hub-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .guia-hub-arrow {
    color: rgba(0, 0, 0, 0.3);
    transition: color 0.3s ease, transform 0.3s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .guia-hub-card:hover .guia-hub-arrow {
    color: #0a0a0a;
    transform: translateX(5px);
  }

  .guia-hub-date {
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.35);
    letter-spacing: 0.04em;
  }

  /* Mobile-overflow fix (shared with guide pages) */
  .content-section {
    display: block;
    width: 100%;
  }

  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }
  .hero-subtitle { opacity: 0; transform: translateY(20px); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateY(0); }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
    setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
    setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);

    const cards = document.querySelectorAll('.guia-hub-card');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    cards.forEach(card => observer.observe(card));
  });
</script>
