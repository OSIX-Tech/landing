---
import Layout from '../../../layouts/Layout.astro';
import LoadingScreen from '../../../components/LoadingScreen.astro';

export const prerender = true;

export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang = 'es' } = Astro.params;

const canonicalUrl = `https://osix.tech/${lang}/guias/`;

// SEO Data
const seoTitle = 'Guías de IA para pymes en España y Galicia - OSIX Tech';
const seoDescription = 'Comparativas y análisis prácticos sobre inteligencia artificial para pymes: cuánto cuesta automatizar, mejores empresas de IA en España y Galicia, y qué procesos se pueden automatizar. Sin humo.';

// Guide list
const guides = [
  { slug: 'mejores-empresas-automatizacion-ia-galicia', title: 'Mejores empresas de automatización con IA en Galicia', desc: 'Comparativa honesta de proveedores de IA para pymes gallegas' },
  { slug: 'mejores-empresas-automatizacion-ia-espana', title: 'Mejores empresas de automatización con IA en España', desc: 'Comparativa honesta de proveedores de IA para pymes en toda España' },
  { slug: 'cuanto-cuesta-automatizar-con-ia-pyme-espana', title: 'Cuánto cuesta automatizar procesos con IA en una pyme', desc: 'Precios reales por tipo de proyecto y cómo se financian con ayudas' },
  { slug: 'cuanto-tarda-ia-primeros-resultados-pyme-espana', title: 'Cuánto se tarda en ver resultados al implantar IA', desc: 'Los cinco caminos, del más rápido al más lento, con expectativas realistas' },
  { slug: 'como-elegir-empresa-desarrollo-software-ia-espana', title: 'Cómo elegir una empresa de desarrollo de software con IA', desc: 'Criterios que sí predicen el éxito de un proyecto' },
  { slug: 'consultoras-ia-grandes-vs-especializadas-pymes', title: 'Consultoras de IA grandes vs especializadas en pymes', desc: 'En qué se diferencian y cómo elegir según tu caso' },
  { slug: 'contratar-empresa-ia-o-usar-herramientas', title: '¿Contratar empresa de IA o usar herramientas hechas?', desc: 'Guía comparativa para pymes en España' },
  { slug: 'procesos-pyme-automatizar-con-ia', title: 'Qué procesos de una pyme se pueden automatizar con IA', desc: 'La lista honesta, con ejemplos por área' },
  { slug: 'pymes-espanolas-que-mejoraron-con-ia', title: 'Casos reales de pymes españolas que mejoraron con IA', desc: 'Qué hicieron distinto y qué resultados obtuvieron' },
  { slug: 'que-es-automatizacion-inteligente-pymes-espana', title: '¿Qué es la automatización inteligente?', desc: 'Guía práctica para empresas en España' },
];

// Structured Data
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "url": canonicalUrl,
  "name": seoTitle,
  "description": seoDescription,
  "inLanguage": lang,
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": { "@type": "ImageObject", "url": "https://osix.tech/logo_w.png" }
  },
  "mainEntity": guides.map((g, i) => ({
    "@type": "Article",
    "name": g.title,
    "url": `https://osix.tech/es/guias/${g.slug}/`,
    "position": i + 1
  }))
};
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="website"
  canonical={canonicalUrl}
  jsonLd={collectionSchema}
>
  <LoadingScreen duration={1000} />
  <section class="content-section hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="max-w-6xl mx-auto px-6 w-full py-20 text-center">
      <span class="hero-badge inline-block text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guías OSIX · IA para pymes</span>
      <h1 class="hero-title text-4xl md:text-6xl font-bold text-white mb-6 opacity-0 leading-tight">Guías de IA para pymes<br/>en España y Galicia</h1>
      <p class="hero-subtitle text-lg md:text-xl text-gray-400 opacity-0 max-w-2xl mx-auto leading-relaxed">Comparativas y análisis prácticos: cuánto cuesta automatizar, qué empresas destacan y qué procesos merece la pena automatizar. Sin humo.</p>
    </div>
  </section>
  <section class="content-section py-16 md:py-24 bg-white mb-0">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
        {guides.map((g, i) => (
          <a href={`/es/guias/${g.slug}/`} class="guide-card" style={`transition-delay: ${Math.min(i, 5) * 0.08}s`}>
            <span class="guide-card-num">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="guide-card-title">{g.title}</h2>
            <p class="guide-card-desc">{g.desc}</p>
            <span class="guide-card-arrow" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .guide-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    padding: 2rem;
    text-decoration: none;
    overflow: hidden;
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 0.8s cubic-bezier(0.19, 1, 0.22, 1),
      transform 0.8s cubic-bezier(0.19, 1, 0.22, 1),
      background-color 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .guide-card.in-view {
    opacity: 1;
    transform: translateY(0);
  }
  .guide-card:hover {
    background: #0a0a0a;
    border-color: #0a0a0a;
    transition-delay: 0s !important;
  }
  .guide-card-num {
    font-size: 0.8rem;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.25);
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
    transition: color 0.35s ease;
  }
  .guide-card:hover .guide-card-num {
    color: rgba(255, 255, 255, 0.35);
  }
  .guide-card-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #0a0a0a;
    margin: 0 0 0.5rem;
    line-height: 1.3;
    transition: color 0.35s ease;
  }
  .guide-card:hover .guide-card-title {
    color: #fff;
  }
  .guide-card-desc {
    color: #555;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 1.5rem;
    transition: color 0.35s ease;
  }
  .guide-card:hover .guide-card-desc {
    color: rgba(255, 255, 255, 0.6);
  }
  .guide-card-arrow {
    margin-top: auto;
    color: rgba(0, 0, 0, 0.3);
    transition: color 0.35s ease, transform 0.35s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .guide-card:hover .guide-card-arrow {
    color: #fff;
    transform: translateX(6px);
  }

  /* Mobile-overflow fix (shared with guide pages) */
  .content-section {
    display: block;
    width: 100%;
  }

  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }
  .hero-subtitle { opacity: 0; transform: translateY(20px); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateY(0); }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
    setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
    setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);

    const cards = document.querySelectorAll('.guide-card');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    cards.forEach(card => observer.observe(card));
  });
</script>