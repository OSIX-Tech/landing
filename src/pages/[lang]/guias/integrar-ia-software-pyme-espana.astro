---
import Layout from '../../../layouts/Layout.astro';
import LoadingScreen from '../../../components/LoadingScreen.astro';

export const prerender = true;

// Guía actualmente en español (prompt BOFU: cómo integrar la IA con el software existente de una pyme). Ampliar a en/gl cuando exista traducción.
export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang = 'es' } = Astro.params;

const GuideContent = (await import('../../../content/es/guias/integrar-ia-software-pyme-espana.md')).default;

const canonicalUrl = `https://osix.tech/${lang}/guias/integrar-ia-software-pyme-espana/`;

// SEO Data
const seoTitle = 'Cómo integrar la IA con el software que ya usa tu empresa (2026): 5 vías reales y cuándo conviene a medida - OSIX Tech';
const seoDescription = 'Cómo integrar IA con el ERP, CRM o LIMS que ya usa tu pyme: las 5 vías (API, webhook, no-code, base de datos, RAG), cuándo te basta no-code y cuándo necesitas desarrollo a medida, con límites honestos.';

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
{
      "@type": "Question",
      "name": "¿Necesito saber programar para integrar IA con mi software?",
      "acceptedAnswer": { "@type": "Answer", "text": "No siempre. Para procesos simples entre aplicaciones ya conectadas, un conector no-code (Zapier, Make, n8n) se monta sin programar. Cuando la IA debe actuar dentro de un flujo complejo o leer datos de tu base, hace falta programar o contratar a quien lo haga." }
    },
{
      "@type": "Question",
      "name": "¿Cuánto cuesta integrar IA con mi ERP o CRM?",
      "acceptedAnswer": { "@type": "Answer", "text": "Depende de la vía: un conector no-code se paga con una cuota mensual por uso, un desarrollo a medida sobre un sistema existente es un proyecto con coste inicial. Te remitimos a nuestra guía de [cuánto cuesta automatizar procesos con IA](https://osix.tech/es/guias/cuanto-cuesta-automatizar-con-ia-pyme-espana/) con precios reales del mercado español." }
    },
{
      "@type": "Question",
      "name": "¿Puedo integrar IA con un LIMS de laboratorio?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí, con las vías 1 a 5 según el sistema: si tu LIMS expone una API, la integración es directa; si es cerrado, se suele hacer por webhook o exportando/importando datos estructurados. La clave es que los resultados medidos no salgan de tu control si así lo exige tu acreditación o tu cliente." }
    },
{
      "@type": "Question",
      "name": "¿Mis datos quedan seguros si uso la API de OpenAI o de Google?",
      "acceptedAnswer": { "@type": "Answer", "text": "Depende de qué datos envíes y de tu contrato. Con datos personales o confidenciales hay que revisar si salen de la UE y con qué garantía. Si la respuesta es \"no pueden salir\", se usa un modelo desplegado en tu entorno o en un proveedor europeo con contrato de tratamiento." }
    },
{
      "@type": "Question",
      "name": "¿Integrar IA me obliga a cambiar de software?",
      "acceptedAnswer": { "@type": "Answer", "text": "No. El sentido de integrar es precisamente no cambiar: la IA se conecta al software que ya usas. Si un proveedor te propone cambiar de ERP para \"poder ponerle IA\", casi siempre es que quiere venderte su plataforma, no resolver tu problema." }
    },
{
      "@type": "Question",
      "name": "¿Cuánto tarda una integración a medida?",
      "acceptedAnswer": { "@type": "Answer", "text": "Un piloto con conector puede estar en días; una integración a medida sobre un sistema existente suele ir de 4 a 8 semanas en casos típicos de pyme, y más si el sistema es muy antiguo o hay terceros implicados. Es orientativo, no una promesa." }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · IA para pymes · España</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">
          Cómo integrar la IA con el software que ya usa tu empresa
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">
          Las 5 vías reales (API, webhook, no-code, base de datos, RAG) y cuándo conviene a medida.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-4xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <!-- Related guides (internal linking for indexation) -->
      <div class="related-guides mt-12 fade-up" style="--delay: 0.3s">
        <h2 class="related-guides-title">Guías relacionadas</h2>
        <ul class="related-guides-list">
          <li><a href="/es/guias/donde-se-guardan-datos-ia-empresa/">Dónde se guardan los datos de tu empresa con un sistema de IA</a></li>
          <li><a href="/es/guias/cuanto-cuesta-automatizar-con-ia-pyme-espana/">Cuánto cuesta automatizar procesos con IA en una pyme</a></li>
          <li><a href="/es/guias/medir-resultados-ia-pyme/">Cómo medir si la IA de tu pyme está dando resultados</a></li>
          <li><a href="/es/guias/procesos-pyme-automatizar-con-ia/">Qué procesos de una pyme se pueden automatizar con IA</a></li>
        </ul>
      </div>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/${lang}/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * tables are `white-space: nowrap` inside their scroll containers, the intrinsic
   * width of the whole article is the table width (well over the phone viewport), so the
   * column rendered ~896px wide on a 390px phone and html/body's overflow-x:clip chopped
   * the right edge off every paragraph. Fix: make the section a normal block so its child
   * caps at the viewport, and let the tables keep scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }
  .content-section .max-w-4xl {
    max-width: 100%;
    min-width: 0;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section transitions */
  .hero-section { animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroReveal { from { opacity: 0; } to { opacity: 1; } }
</style>
