---
import Layout from '../../../layouts/Layout.astro';
import LoadingScreen from '../../../components/LoadingScreen.astro';

export const prerender = true;

// Guía actualmente en español (ranking de herramientas de IA para pymes). Ampliar a en/gl cuando exista traducción.
export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang = 'es' } = Astro.params;

const GuideContent = (await import('../../../content/es/guias/mejores-herramientas-ia-pymes.md')).default;

const canonicalUrl = `https://osix.tech/${lang}/guias/mejores-herramientas-ia-pymes/`;

// SEO Data
const seoTitle = 'Las mejores herramientas de IA para pymes en España (2026): 9 opciones con precios reales - OSIX Tech';
const seoDescription = 'Las 9 mejores herramientas de IA para pymes en España en 2026, con precios reales comprobados en agosto de 2026, plan gratuito, límites honestos y una tabla comparativa. Sin humo, sin afiliación.';

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuál es la mejor herramienta de IA para empezar en una pyme?",
      "acceptedAnswer": { "@type": "Answer", "text": "Un asistente general como ChatGPT, con su plan gratuito, para redactar, resumir y probar ideas sin coste. Cuando ya tengas un proceso concreto que automatizar o necesites trabajar con tus propios datos, sube de capa a una herramienta de automatización o a una integración a medida." }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta la IA para una pyme?",
      "acceptedAnswer": { "@type": "Answer", "text": "Desde 0 €, con los planes gratuitos de ChatGPT, Canva, Make o Tidio, hasta 27,73 €/usuario al mes de Microsoft 365 Copilot (sin IVA), más la licencia de Microsoft 365. La mayoría de las herramientas de pago para equipos pequeños se mueven entre 10 y 30 €/usuario al mes." }
    },
    {
      "@type": "Question",
      "name": "¿Qué herramientas de IA están en español?",
      "acceptedAnswer": { "@type": "Answer", "text": "ChatGPT, Microsoft 365 Copilot, Google Workspace con Gemini, Power Automate, Canva y Tidio tienen interfaz en español. Make y n8n no ofrecen interfaz oficial en español, lo que añade fricción si el equipo no está cómodo con el inglés." }
    },
    {
      "@type": "Question",
      "name": "¿Es seguro usar herramientas de IA con datos de mi empresa?",
      "acceptedAnswer": { "@type": "Answer", "text": "Depende de la herramienta y del plan. Microsoft (frontera de datos de la UE), Google y n8n (centros de datos en Frankfurt) ofrecen opciones de residencia de datos en la UE. Antes de subir datos sensibles, revisa dónde se procesan y qué dice el RGPD." }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · Herramientas de IA · España</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">
          Las mejores herramientas de IA para pymes en España
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">
          9 opciones probadas con precios reales, límites honestos y una tabla comparativa.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-4xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <!-- Related guides (internal linking for indexation) -->
      <div class="related-guides mt-12 fade-up" style="--delay: 0.3s">
        <h2 class="related-guides-title">Guías relacionadas</h2>
        <ul class="related-guides-list">
          <li><a href="/es/guias/contratar-empresa-ia-o-usar-herramientas/">¿Contratar empresa de IA o usar herramientas hechas?</a></li>
          <li><a href="/es/guias/mejores-empresas-automatizacion-ia-espana/">Mejores empresas de automatización con IA en España</a></li>
          <li><a href="/es/guias/para-que-sirve-ia-pyme/">Para qué sirve la IA en una pyme</a></li>
          <li><a href="/es/guias/chatbot-sin-programar/">¿Puedo montar un chatbot para mi empresa sin saber programar?</a></li>
        </ul>
      </div>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/${lang}/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * price tables are `white-space: nowrap` inside their scroll containers, the intrinsic
   * width of the whole article is the table width (well over the phone viewport), so the
   * column rendered ~896px wide on a 390px phone and html/body's overflow-x:clip chopped
   * the right edge off every paragraph. Fix: make the section a normal block so its child
   * caps at the viewport, and let the tables keep scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }
  .content-section .max-w-4xl {
    max-width: 100%;
    min-width: 0;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }
</style>