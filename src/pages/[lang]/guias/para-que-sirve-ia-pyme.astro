---
import Layout from '../../../layouts/Layout.astro';
import LoadingScreen from '../../../components/LoadingScreen.astro';

export const prerender = true;

// Guía actualmente en español (apunta al prompt TOFU de para qué sirve la IA en una pyme). Ampliar a en/gl cuando exista traducción.
export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang = 'es' } = Astro.params;

const GuideContent = (await import('../../../content/es/guias/para-que-sirve-ia-pyme.md')).default;

const canonicalUrl = `https://osix.tech/${lang}/guias/para-que-sirve-ia-pyme/`;

// SEO Data
const seoTitle = 'Para qué sirve la IA en una pyme: 8 usos con resultados reales (2026) - OSIX Tech';
const seoDescription = 'Para qué sirve la inteligencia artificial en una pyme española en 2026: las 8 aplicaciones con retorno real (documentos, atención al cliente, ventas, datos), su límite honesto y por cuánto se empieza a arrancar.';

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿La IA para pymes sustituye a los trabajadores?",
      "acceptedAnswer": { "@type": "Answer", "text": "En la práctica de la mayoría de las pymes, no. Sustituye tareas repetitivas de bajo valor y libera horas para trabajo con criterio, atención al cliente y mejora continua. La encuesta de la OCDE lo refleja: el 83% de las pymes que usan IA generativa dice que no ha tenido efecto en su plantilla." }
    },
    {
      "@type": "Question",
      "name": "¿Puedo empezar con herramientas gratuitas?",
      "acceptedAnswer": { "@type": "Answer", "text": "Para explorar y probar, sí. ChatGPT, Claude y otras permiten redactar, resumir y probar ideas con coste bajo. Para producción, con tus datos y sistemas conectados, necesitarás una integración más sólida, y ahí ya hablamos de un proyecto con estructura." }
    },
    {
      "@type": "Question",
      "name": "¿Qué pyme es buena candidata para la IA?",
      "acceptedAnswer": { "@type": "Answer", "text": "La que tiene un proceso con volumen, un dolor medible (horas, costes, errores) y datos razonablemente ordenados. Si tienes eso, hay un proyecto que abordar. Si no, el primer paso no es IA, es ordenar el proceso." }
    },
    {
      "@type": "Question",
      "name": "¿Por dónde empiezo si tengo poca experiencia?",
      "acceptedAnswer": { "@type": "Answer", "text": "Por la tarea que más horas te roba y que es estándar: procesar documentos, automatizar respuestas o arrancar un asistente de consultas. Son las de retorno rápido y riesgo bajo. Deja las predicciones complejas para cuando ya valides el camino." }
    },
    {
      "@type": "Question",
      "name": "¿Cada cuánto hay que mantener el sistema?",
      "acceptedAnswer": { "@type": "Answer", "text": "Un retainer mensual (de 300 a 800 €, según alcance) mantiene el sistema al día con los cambios de tus herramientas. Es la partida que las pymes más se saltan, y la que evita que la automatización muera en unos meses." }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · IA para pymes · España</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">
          Para qué sirve la inteligencia artificial en una pyme
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">
          Las 8 formas que dan resultados reales en 2026, su límite honesto y por cuánto se empieza.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-4xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <!-- Related guides (internal linking for indexation) -->
      <div class="related-guides mt-12 fade-up" style="--delay: 0.3s">
        <h2 class="related-guides-title">Guías relacionadas</h2>
        <ul class="related-guides-list">
          <li><a href="/es/guias/procesos-pyme-automatizar-con-ia/">Qué procesos de una pyme se pueden automatizar con IA</a></li>
          <li><a href="/es/guias/mejores-herramientas-ia-pymes/">Las mejores herramientas de IA para pymes en España</a></li>
          <li><a href="/es/guias/cuanto-tarda-ia-primeros-resultados-pyme-espana/">Cuánto se tarda en ver resultados al implantar IA</a></li>
        </ul>
      </div>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/${lang}/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * price tables are `white-space: nowrap` inside their scroll containers, the intrinsic
   * width of the whole article is the table width (well over the phone viewport), so the
   * column rendered ~896px wide on a 390px phone and html/body's overflow-x:clip chopped
   * the right edge off every paragraph. Fix: make the section a normal block so its child
   * caps at the viewport, and let the tables keep scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }
  .content-section .max-w-4xl {
    max-width: 100%;
    min-width: 0;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section transitions */
  .hero-section { animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroReveal { from { opacity: 0; } to { opacity: 1; } }
</style>