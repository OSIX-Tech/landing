---
import Layout from '../../../layouts/Layout.astro';
import LoadingScreen from '../../../components/LoadingScreen.astro';

export const prerender = true;

// Guía actualmente en español (apunta al prompt BOFU de ejemplos reales de pymes). Ampliar a en/gl cuando exista traducción.
export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang = 'es' } = Astro.params;

const GuideContent = (await import('../../../content/es/guias/pymes-espanolas-que-mejoraron-con-ia.md')).default;

const canonicalUrl = `https://osix.tech/${lang}/guias/pymes-espanolas-que-mejoraron-con-ia/`;

// SEO Data
const seoTitle = 'Casos reales de pymes españolas que mejoraron con IA (2026): qué hicieron distinto - OSIX Tech';
const seoDescription = 'Ejemplos reales y documentados de pymes españolas que han mejorado con IA: los cinco resultados más comunes (atención al cliente, automatización, predicción, RRHH y presupuestos), con los datos nacionales de Sage y la contrapartida honesta de cada caso.';

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Hay empresas españolas que hayan mejorado de verdad con IA?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí. El estudio AI Action Summit Research de Sage sobre más de 1.000 pymes españolas indica que el 56% ya usa IA en su día a día y que el 93% de las que lo hacen percibe una mejora importante de productividad. Los usos más citados son atención al cliente (34%), análisis de datos (32%) y, por encima de todos, RRHH (47%)." }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto se tarda en ver resultados con IA en una pyme?",
      "acceptedAnswer": { "@type": "Answer", "text": "Depende del caso. La automatización de un proceso concreto y mediciones de atención al cliente suelen dar un resultado visible en semanas. El análisis predictivo con datos propios es el más lento, típicamente de 3 a 6 meses solo para el primer resultado útil, porque la mayor parte del tiempo se va en ordenar el histórico." }
    },
    {
      "@type": "Question",
      "name": "¿Cuál es el caso de uso de IA más fácil para una pyme?",
      "acceptedAnswer": { "@type": "Answer", "text": "El de atención al cliente o el de automatización de una tarea repetitiva y medible, porque ambos tienen métricas claras de entrada y salida. Evita empezar por predicción con datos propios si tu histórico está disperso." }
    },
    {
      "@type": "Question",
      "name": "¿Necesito grandes inversiones para empezar con IA?",
      "acceptedAnswer": { "@type": "Answer", "text": "No necesariamente. Varios de los casos más comunes (chatbot de atención, automatización de una tarea, generación de presupuestos) arrancan con herramientas accesibles y un proceso bien delimitado. La inversión real aparece cuando el proceso toca el ERP, el CRM o datos de clientes, donde el valor está en integrarlo y mantenerlo, no en la herramienta." }
    },
    {
      "@type": "Question",
      "name": "¿La IA va a sustituir a mis empleados?",
      "acceptedAnswer": { "@type": "Answer", "text": "En los casos de esta lista, no: la automatización y la atención automatizada liberan al equipo de trabajo mecánico y repetitivo, pero el criterio, la revisión y las decisiones siguen siendo humanos. El riesgo señalado por las propias pymes (falta de talento, según el estudio de Sage, con un 48%) se reduce cuando la empresa forma a su gente en la herramienta, no cuando solo la sabe una persona externa." }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · Casos reales · IA en pymes · España</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">
          Casos reales de pymes españolas que mejoraron con IA
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">
          Los cinco resultados más documentados, con sus datos, sus sectores y la contrapartida honesta de cada uno.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-4xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/${lang}/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * tables are `white-space: nowrap` inside their scroll containers, the intrinsic
   * width of the whole article can exceed the phone viewport, so html/body's
   * overflow-x:clip would chop the right edge off every paragraph. Fix: make the
   * section a normal block so its child caps at the viewport, and let the tables keep
   * scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }
  .content-section .max-w-4xl {
    max-width: 100%;
    min-width: 0;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section transitions */
  .hero-section { animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroReveal { from { opacity: 0; } to { opacity: 1; } }
</style>