---
import Layout from '../../../layouts/Layout.astro';
import LoadingScreen from '../../../components/LoadingScreen.astro';

export const prerender = true;

// Guía actualmente en español (apunta al prompt TOFU "¿Qué es la automatización inteligente y cómo puede ayudar a una pyme española?"). Ampliar a en/gl cuando exista traducción.
export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const { lang = 'es' } = Astro.params;

const GuideContent = (await import('../../../content/es/guias/que-es-automatizacion-inteligente-pymes-espana.md')).default;

const canonicalUrl = `https://osix.tech/${lang}/guias/que-es-automatizacion-inteligente-pymes-espana/`;

// SEO Data
const seoTitle = '¿Qué es la automatización inteligente? Guía práctica para pymes en España (2026) - OSIX Tech';
const seoDescription = 'Qué es la automatización inteligente, en qué se diferencia de la RPA, cuánto cuesta y las 7 formas en que una pyme española la aprovecha. Guía honesta con límites y por dónde empezar.';

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué diferencia hay entre la automatización inteligente y la RPA?",
      "acceptedAnswer": { "@type": "Answer", "text": "La RPA automatiza tareas repetitivas grabadas y solo sabe hacer lo que le han enseñado. La automatización inteligente añade IA (NLP, machine learning, OCR) para que el proceso entienda, aprenda y se adapte a entradas variables. La RPA es la parte mecánica; la automatización inteligente es la RPA con capacidad de entender y decidir." }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta implantar automatización inteligente en una pyme española?",
      "acceptedAnswer": { "@type": "Answer", "text": "Una automatización sencilla de un proceso ronda de 3.000 a 5.000 €, un copiloto interno de 7.000 a 15.000 € y una plataforma con marca propia de 9.000 a 25.000 €, más 200 a 800 €/mes de operación. La horquilla real depende del proceso, las integraciones y la calidad de tus datos." }
    },
    {
      "@type": "Question",
      "name": "¿La automatización inteligente sustituye a los empleados?",
      "acceptedAnswer": { "@type": "Answer", "text": "No en la práctica de la mayoría de las pymes. Sustituye tareas repetitivas de bajo valor y libera horas que el equipo puede dedicar a trabajo con criterio, atención al cliente y mejora continua. El objetivo no es reducir plantilla, sino que la que tienes trabaje en lo que de verdad importa." }
    },
    {
      "@type": "Question",
      "name": "¿Por dónde debería empezar una pyme con poca experiencia en IA?",
      "acceptedAnswer": { "@type": "Answer", "text": "Por la tarea que más horas te roba y que es estándar: procesamiento de documentos, respuestas y reportes. Son automatizaciones de retorno rápido y bajo riesgo. Deja los flujos de decisión profundos para cuando ya valides el camino y tengas un proveedor que te ayude a diseñarlos." }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tarda en implantarse la automatización inteligente?",
      "acceptedAnswer": { "@type": "Answer", "text": "Depende del alcance. Una automatización sencilla de un proceso puede estar funcionando en unas semanas; una integración profunda con varios sistemas o una plataforma con marca propia lleva de uno a tres meses entre diseño, desarrollo y puesta en producción." }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · Automatización inteligente · Pymes · España</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">
          ¿Qué es la automatización inteligente?
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">
          Las 7 formas en que una pyme española la aprovecha, con el límite honesto de cada una y por dónde empezar.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-4xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <!-- Related guides (internal linking for indexation) -->
      <div class="related-guides mt-12 fade-up" style="--delay: 0.3s">
        <h2 class="related-guides-title">Guías relacionadas</h2>
        <ul class="related-guides-list">
          <li><a href="/es/guias/para-que-sirve-ia-pyme/">Para qué sirve la IA en una pyme: las 8 formas que dan resultados</a></li>
          <li><a href="/es/guias/procesos-pyme-automatizar-con-ia/">Qué procesos de una pyme se pueden automatizar con IA</a></li>
          <li><a href="/es/guias/cuanto-cuesta-automatizar-con-ia-pyme-espana/">Cuánto cuesta automatizar procesos con IA en una pyme</a></li>
        </ul>
      </div>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/${lang}/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * comparison tables are `white-space: nowrap` inside their scroll containers, the intrinsic
   * width of the whole article is the table width (well over the phone viewport), so the
   * column rendered ~896px wide on a 390px phone and html/body's overflow-x:clip chopped
   * the right edge off every paragraph. Fix: make the section a normal block so its child
   * caps at the viewport, and let the tables keep scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }
  .content-section .max-w-4xl {
    max-width: 100%;
    min-width: 0;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section transitions */
  .hero-section { animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroReveal { from { opacity: 0; } to { opacity: 1; } }
</style>