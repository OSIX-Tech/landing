---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ServicesShowcase from '../../components/ServicesShowcase.astro';
import AboutUsSection from '../../components/AboutUsSection.astro';
import HomeFAQ from '../../components/HomeFAQ.astro';
import StaticContactSection from '../../components/StaticContactSection.astro';
import LoadingScreen from '../../components/LoadingScreen.astro';
import { getAllServices } from '../../data/services-multilingual';
import { LANGUAGES, type Lang } from '../../utils/languages';

export const prerender = true;

export async function getStaticPaths() {
  return LANGUAGES.map(lang => ({ params: { lang } }));
}

const { lang = 'en' } = Astro.params as { lang: Lang };

// SEO Data
const seoTitle = ({ es: 'OSIX Tech - Consultoría Tecnológica & Desarrollo a Medida con IA', gl: 'OSIX Tech - Consultoría Tecnolóxica & Desenvolvemento a Medida con IA', en: 'OSIX Tech - Technology Consulting & Custom AI Development' }[lang]);

const seoDescription = ({ es: 'OSIX Tech: Desarrollo de software a medida con IA, consultoría de transformación digital y gestión de subvenciones. Tecnología que genera resultados reales para tu empresa.', gl: 'OSIX Tech: Desenvolvemento de software a medida con IA, consultoría de transformación dixital e xestión de subvencións. Tecnoloxía que xera resultados reais para a túa empresa.', en: 'OSIX Tech: Custom AI software development, digital transformation consulting, and innovation grants. Technology that delivers real results for your business.' }[lang]);

// FAQ translations for structured data
const faqTranslations = await import(`../../../public/locales/${lang}.json`);
const ft = (k: string) => faqTranslations.default[k] || k;

// Team members for Person schema (E-E-A-T signals)
const teamPersons = [
  { name: "Pablo Pazos", role: "CTO / Software Architect", linkedin: "https://www.linkedin.com/in/pablo-pazos-parada/" },
  { name: "Mateo Bodenlle", role: "CFO", linkedin: "https://www.linkedin.com/in/mateo-bodenlle-villarino/" },
  { name: "Juan Freire", role: "Backend Engineer", linkedin: "https://www.linkedin.com/in/juan-freire-alvarez/" },
  { name: "David Gutiérrez", role: "Security & AI Backend Engineer", linkedin: "https://www.linkedin.com/in/david-gutierrez-cs/" },
  { name: "Nicolás Corbal", role: "Frontend Engineer", linkedin: "https://www.linkedin.com/in/nicol%C3%A1s-corbal-912929318/" },
  { name: "David M. Raposeiras", role: "DevOps Engineer", linkedin: "https://www.linkedin.com/in/david-manuel-raposeiras-canabal-a95028210/" },
  { name: "Diego Cristóbal", role: "Full Stack Mobile Engineer", linkedin: "https://www.linkedin.com/in/diego-cristobal-andaluz-3a5580304/" },
];

// Collect testimonials from all services for AggregateRating
const allServices = getAllServices(lang);
const testimonials = allServices.map(s => s.testimonial);

// Structured Data — unified @graph
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "LocalBusiness"],
      "@id": "https://osix.tech/#organization",
      "name": "OSIX Tech",
      "url": "https://osix.tech",
      "logo": "https://osix.tech/logo_w.png",
      "description": seoDescription,
      "telephone": "+34 648935068",
      "email": "info@osix.tech",
      "foundingDate": "2024",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Santiago del Estero, 2-4 1G",
        "addressLocality": "Santiago de Compostela",
        "addressRegion": "Galicia",
        "postalCode": "15702",
        "addressCountry": "ES"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 42.8782,
        "longitude": -8.5448
      },
      "areaServed": [
        { "@type": "Country", "name": "Spain" },
        { "@type": "AdministrativeArea", "name": "Galicia" }
      ],
      "sameAs": [
        "https://github.com/osixtech",
        "https://linkedin.com/company/osixtech"
      ],
      "knowsAbout": [
        "Artificial Intelligence",
        "Inteligencia Artificial",
        "Intelixencia Artificial",
        "AI Consulting",
        "Consultoría de IA",
        "Consultoría de IA en Galicia",
        "Digital Transformation",
        "Intelligent Agents",
        "Process Automation",
        "IGAPE IA360",
        "Custom Software Development"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": "info@osix.tech",
        "telephone": "+34 648935068",
        "availableLanguage": ["English", "Spanish", "Galician"]
      },
      "employee": teamPersons.map(p => ({
        "@type": "Person",
        "name": p.name,
        "jobTitle": p.role,
        "worksFor": { "@id": "https://osix.tech/#organization" },
        "sameAs": [p.linkedin]
      })),
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5",
        "bestRating": "5",
        "ratingCount": String(testimonials.length),
        "reviewCount": String(testimonials.length)
      },
      "review": testimonials.map(t => ({
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "author": { "@type": "Person", "name": t.author },
        "reviewBody": t.quote
      })),
      "makesOffer": allServices.map(s => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": s.title,
          "description": s.description,
          "url": `https://osix.tech/${lang}/servicios/${s.id}`
        }
      }))
    },
    {
      "@type": "WebSite",
      "@id": "https://osix.tech/#website",
      "name": "OSIX Tech",
      "url": "https://osix.tech",
      "publisher": { "@id": "https://osix.tech/#organization" },
      "inLanguage": ["en", "es", "gl"]
    },
    {
      "@type": "WebPage",
      "@id": `https://osix.tech/${lang}/#webpage`,
      "name": seoTitle,
      "description": seoDescription,
      "url": `https://osix.tech/${lang}/`,
      "inLanguage": lang,
      "dateModified": "2026-04-07",
      "isPartOf": { "@id": "https://osix.tech/#website" },
      "about": { "@id": "https://osix.tech/#organization" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [{
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `https://osix.tech/${lang}/`
        }]
      }
    },
    {
      "@type": "FAQPage",
      "@id": `https://osix.tech/${lang}/#faq`,
      "isPartOf": { "@id": `https://osix.tech/${lang}/#webpage` },
      "mainEntity": [
        { "@type": "Question", "name": ft('home.faq.q1'), "acceptedAnswer": { "@type": "Answer", "text": ft('home.faq.a1') } },
        { "@type": "Question", "name": ft('home.faq.q2'), "acceptedAnswer": { "@type": "Answer", "text": ft('home.faq.a2') } },
        { "@type": "Question", "name": ft('home.faq.q3'), "acceptedAnswer": { "@type": "Answer", "text": ft('home.faq.a3') } },
        { "@type": "Question", "name": ft('home.faq.q4'), "acceptedAnswer": { "@type": "Answer", "text": ft('home.faq.a4') } },
        { "@type": "Question", "name": ft('home.faq.q5'), "acceptedAnswer": { "@type": "Answer", "text": ft('home.faq.a5') } },
        { "@type": "Question", "name": ft('home.faq.q6'), "acceptedAnswer": { "@type": "Answer", "text": ft('home.faq.a6') } }
      ]
    }
  ]
};

---

<Layout 
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="website"
  jsonLd={jsonLd}
>
  <LoadingScreen duration={1000} />
  <section id="hero"><Hero lang={lang} /></section>
  <section id="services"><ServicesShowcase lang={lang} /></section>
  <section id="guias" class="home-guias bg-white text-black">
    <div class="w-full max-w-7xl mx-auto px-6 md:px-12">
      <div class="home-guias-header">
        <p class="text-sm tracking-[0.2em] uppercase text-gray-400 mb-5">
          {{ es: 'Guías prácticas', gl: 'Guías prácticas', en: 'Practical guides' }[lang]}
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-black leading-tight mb-4">
          {{ es: 'Análisis sin humo sobre IA para pymes', gl: 'Análises sen humo sobre IA para pemes', en: 'No-hype analysis on AI for SMEs' }[lang]}
        </h2>
        <p class="text-lg text-gray-500 max-w-xl leading-relaxed">
          {{ es: 'Comparativas y guías basadas en criterios objetivos, no en marketing.', gl: 'Comparativas e guías baseadas en criterios obxectivos, non en marketing.', en: 'Comparisons and guides based on objective criteria, not marketing.' }[lang]}
        </p>
      </div>
      <div class="home-guias-grid">
        {[
          { href: '/es/guias/mejores-empresas-automatizacion-ia-galicia/', num: '01', tag: { es: 'IA para pymes', gl: 'IA para pemes', en: 'AI for SMEs' }[lang], title: { es: 'Mejores empresas de automatización con IA en Galicia', gl: 'Mellores empresas de automatización con IA en Galicia', en: 'Best AI automation companies in Galicia' }[lang] },
          { href: '/es/guias/cuanto-cuesta-automatizar-con-ia-pyme-espana/', num: '02', tag: { es: 'Precios reales', gl: 'Prezos reais', en: 'Real pricing' }[lang], title: { es: 'Cuánto cuesta automatizar procesos con IA en una pyme', gl: 'Canto custa automatizar procesos con IA nunha peme', en: 'How much it costs to automate with AI in an SME' }[lang] },
          { href: '/es/guias/cuanto-tarda-ia-primeros-resultados-pyme-espana/', num: '03', tag: { es: 'Expectativas', gl: 'Expectativas', en: 'Expectations' }[lang], title: { es: 'Cuánto se tarda en ver resultados al implantar IA', gl: 'Canto se tarda en ver resultados ao implantar IA', en: 'How long until AI results show' }[lang] },
        ].map((g) => (
          <a class="home-guias-card" href={g.href}>
            <div class="home-guias-card-top">
              <span class="home-guias-num">{g.num}</span>
              <span class="home-guias-tag">{g.tag}</span>
            </div>
            <span class="home-guias-card-title">{g.title}</span>
            <span class="home-guias-card-arrow" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
      <div class="home-guias-link">
        <a href={`/es/guias/`} class="home-guias-all">
          {{ es: 'Ver todas las guías', gl: 'Ver todas as guías', en: 'See all guides' }[lang]}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
  <section id="about-us"><AboutUsSection lang={lang} /></section>
  <section id="faq"><HomeFAQ lang={lang} /></section>
  <section id="contact"><StaticContactSection lang={lang} /></section>
</Layout>

<style>
  #hero {
    margin-bottom: 7.5vh !important;
  }

  .home-guias {
    padding: 96px 0;
  }

  .home-guias-header {
    margin-bottom: 3rem;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.19, 1, 0.22, 1), transform 0.8s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .home-guias.in-view .home-guias-header {
    opacity: 1;
    transform: translateY(0);
  }

  .home-guias-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .home-guias-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .home-guias-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    padding: 2rem;
    min-height: 240px;
    text-decoration: none;
    overflow: hidden;
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 0.8s cubic-bezier(0.19, 1, 0.22, 1),
      transform 0.8s cubic-bezier(0.19, 1, 0.22, 1),
      background-color 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .home-guias.in-view .home-guias-card {
    opacity: 1;
    transform: translateY(0);
  }

  .home-guias.in-view .home-guias-card:nth-child(1) { transition-delay: 0.1s, 0.1s, 0s, 0s; }
  .home-guias.in-view .home-guias-card:nth-child(2) { transition-delay: 0.2s, 0.2s, 0s, 0s; }
  .home-guias.in-view .home-guias-card:nth-child(3) { transition-delay: 0.3s, 0.3s, 0s, 0s; }

  .home-guias-card:hover {
    background: #0a0a0a;
    border-color: #0a0a0a;
  }

  .home-guias-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .home-guias-num {
    font-size: 0.8rem;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.25);
    letter-spacing: 0.1em;
    transition: color 0.35s ease;
  }

  .home-guias-card:hover .home-guias-num {
    color: rgba(255, 255, 255, 0.35);
  }

  .home-guias-tag {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    background: #0a0a0a;
    padding: 0.35rem 0.85rem;
    transition: background-color 0.35s ease, color 0.35s ease;
  }

  .home-guias-card:hover .home-guias-tag {
    background: #fff;
    color: #0a0a0a;
  }

  .home-guias-card-title {
    display: block;
    color: #0a0a0a;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: auto;
    transition: color 0.35s ease;
  }

  .home-guias-card:hover .home-guias-card-title {
    color: #fff;
  }

  .home-guias-card-arrow {
    margin-top: 1.5rem;
    color: rgba(0, 0, 0, 0.3);
    transition: color 0.35s ease, transform 0.35s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .home-guias-card:hover .home-guias-card-arrow {
    color: #fff;
    transform: translateX(6px);
  }

  .home-guias-link {
    margin-top: 2.5rem;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.19, 1, 0.22, 1) 0.4s, transform 0.8s cubic-bezier(0.19, 1, 0.22, 1) 0.4s;
  }

  .home-guias.in-view .home-guias-link {
    opacity: 1;
    transform: translateY(0);
  }

  .home-guias-all {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    background: #0a0a0a;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .home-guias-all svg {
    transition: transform 0.25s ease;
  }

  .home-guias-all:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
  }

  .home-guias-all:hover svg {
    transform: translateX(4px);
  }

  .contact-section {
    transform: translateY(100%);
    opacity: 0;
  }

  .contact-section.visible {
    transform: translateY(0);
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const contactSection = document.querySelector('.contact-section');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1 });

    if (contactSection) {
      observer.observe(contactSection);
    }

    const guiasSection = document.querySelector('.home-guias');
    if (guiasSection) {
      const guiasObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            guiasObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      guiasObserver.observe(guiasSection);
    }
  });
</script>