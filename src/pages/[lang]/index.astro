---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ServicesShowcase from '../../components/ServicesShowcase.astro';
import AboutUsSection from '../../components/AboutUsSection.astro';
import HomeFAQ from '../../components/HomeFAQ.astro';
import StaticContactSection from '../../components/StaticContactSection.astro';
import LoadingScreen from '../../components/LoadingScreen.astro';
import { getAllServices } from '../../data/services-multilingual';
import { LANGUAGES, type Lang } from '../../utils/languages';

export const prerender = true;

export async function getStaticPaths() {
  return LANGUAGES.map(lang => ({ params: { lang } }));
}

const { lang = 'en' } = Astro.params as { lang: Lang };

// ── Guias section: latest guides + generative placeholder art ──
const latestGuides = [
  { slug: 'para-que-sirve-ia-pyme', date: '2026-08-27', tag: { es: 'IA para pymes', gl: 'IA para pemes', en: 'AI for SMEs' }[lang], title: { es: 'Para qué sirve la IA en una pyme: las 8 formas que dan resultados', gl: 'Para que serve a IA nunha peme: as 8 formas que dan resultados', en: 'What AI is for in an SME: the 8 ways that deliver results' }[lang] },
  { slug: 'procesos-pyme-automatizar-con-ia', date: '2026-08-26', tag: { es: 'Procesos', gl: 'Procesos', en: 'Processes' }[lang], title: { es: 'Qué procesos de una pyme se pueden automatizar con IA', gl: 'Que procesos dunha peme se poden automatizar con IA', en: 'Which SME processes can be automated with AI' }[lang] },
  { slug: 'pymes-espanolas-que-mejoraron-con-ia', date: '2026-08-25', tag: { es: 'Casos reales', gl: 'Casos reais', en: 'Real cases' }[lang], title: { es: 'Casos reales de pymes españolas que mejoraron con IA', gl: 'Casos reais de pemes españolas que melloraron con IA', en: 'Real cases of Spanish SMEs that improved with AI' }[lang] },
  { slug: 'que-es-automatizacion-inteligente-pymes-espana', date: '2026-08-24', tag: { es: 'Conceptos', gl: 'Conceptos', en: 'Concepts' }[lang], title: { es: '¿Qué es la automatización inteligente? Guía para pymes', gl: 'Que é a automatización intelixente? Guía para pemes', en: 'What is intelligent automation? A guide for SMEs' }[lang] },
  { slug: 'cuanto-tarda-ia-primeros-resultados-pyme-espana', date: '2026-08-21', tag: { es: 'Expectativas', gl: 'Expectativas', en: 'Expectations' }[lang], title: { es: 'Cuánto se tarda en ver resultados al implantar IA', gl: 'Canto se tarda en ver resultados ao implantar IA', en: 'How long until AI results show' }[lang] },
  { slug: 'consultoras-ia-grandes-vs-especializadas-pymes', date: '2026-08-20', tag: { es: 'Comparativa', gl: 'Comparativa', en: 'Comparison' }[lang], title: { es: 'Consultoras de IA grandes vs especializadas en pymes', gl: 'Consultoras de IA grandes vs especializadas en pemes', en: 'Big AI consultancies vs SME specialists' }[lang] },
];

const formatGuideDate = (iso: string) => {
  const localeMap: Record<string, string> = { es: 'es-ES', gl: 'gl-ES', en: 'en-GB' };
  return new Date(iso).toLocaleDateString(localeMap[lang] || 'es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
};

// Seeded PRNG so each card gets stable but unique placeholder art
function seedFromString(str: string): number {
  let h = 2166136261;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function mulberry32(seed: number) {
  let a = seed;
  return () => {
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// Poster-style monochrome compositions in the OSIX mark's language.
// Each slug deterministically picks one of four curated patterns with seeded variation.
function genGuideArt(slug: string, variantOverride?: number): string {
  const rnd = mulberry32(seedFromString(slug));
  const W = 400, H = 250;
  const parts: string[] = [];
  const variant = variantOverride !== undefined ? variantOverride % 4 : Math.floor(rnd() * 4);
  const dir = rnd() > 0.5 ? 1 : -1;

  if (variant === 0) {
    // Chevron march: bold chevrons crossing the frame, opacity ramp, one crisp accent
    const n = 5;
    const gap = 58 + rnd() * 10;
    const startX = (dir === 1 ? 60 : W - 60) + (rnd() - 0.5) * 40;
    const span = 74;
    for (let i = 0; i < n; i++) {
      const x = startX + dir * i * gap;
      const o = 0.06 + i * 0.055;
      parts.push(`<path d="M ${x - dir * span / 2} -20 L ${x + dir * span / 2} ${H / 2} L ${x - dir * span / 2} ${H + 20}" fill="none" stroke="#fff" stroke-width="30" opacity="${o.toFixed(2)}"/>`);
    }
    const ax = startX + dir * (n - 1.4) * gap;
    parts.push(`<path d="M ${ax - dir * span / 2} -20 L ${ax + dir * span / 2} ${H / 2} L ${ax - dir * span / 2} ${H + 20}" fill="none" stroke="#fff" stroke-width="3" opacity="0.9"/>`);
  } else if (variant === 1) {
    // Diagonal stripes: parallel full-bleed lines, alternating weight, one white accent
    const n = 6;
    const gap = 54 + rnd() * 12;
    const off = rnd() * 60 - 90;
    const accent = 1 + Math.floor(rnd() * (n - 2));
    for (let i = 0; i < n; i++) {
      const x = off + i * gap;
      const isAccent = i === accent;
      const w = isAccent ? 3 : (i % 2 === 0 ? 22 : 9);
      const o = isAccent ? 0.9 : 0.07 + (i / n) * 0.14;
      parts.push(`<line x1="${x}" y1="${H + 40}" x2="${x + H + 80}" y2="-40" stroke="#fff" stroke-width="${w}" opacity="${o.toFixed(2)}"/>`);
    }
  } else if (variant === 2) {
    // Nested chevrons: concentric > shapes sharing a vertex, ramping opacity
    const n = 5;
    const cx = W * (0.35 + rnd() * 0.3);
    const cy = H / 2 + (rnd() - 0.5) * 30;
    const step = 34 + rnd() * 8;
    for (let i = n - 1; i >= 0; i--) {
      const s = (i + 1.2) * step;
      const o = i === 0 ? 0.9 : 0.08 + (n - i) * 0.05;
      const w = i === 0 ? 3 : 16;
      parts.push(`<path d="M ${cx - dir * s * 0.55} ${cy - s} L ${cx + dir * s * 0.55} ${cy} L ${cx - dir * s * 0.55} ${cy + s}" fill="none" stroke="#fff" stroke-width="${w}" opacity="${o.toFixed(2)}"/>`);
    }
  } else {
    // Gradient grid: field of squares fading across, one large faint triangle behind
    const cols = 10, rows = 6;
    const cw = W / cols, ch = H / rows;
    const tx = rnd() * W * 0.5;
    parts.push(`<polygon points="${tx},${H + 30} ${tx + 260 * dir},${H + 30} ${tx + 130 * dir},-30" fill="#fff" opacity="0.05"/>`);
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const t = dir === 1 ? c / cols : 1 - c / cols;
        const o = 0.04 + t * t * 0.4 + rnd() * 0.04;
        const s = 5 + t * 4;
        parts.push(`<rect x="${(c + 0.5) * cw - s / 2}" y="${(r + 0.5) * ch - s / 2}" width="${s.toFixed(1)}" height="${s.toFixed(1)}" fill="#fff" opacity="${o.toFixed(2)}"/>`);
      }
    }
  }

  return `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" role="img" aria-hidden="true"><rect width="${W}" height="${H}" fill="#0a0a0a"/>${parts.join('')}</svg>`;
}

// SEO Data
const seoTitle = ({ es: 'OSIX Tech - Consultoría Tecnológica & Desarrollo a Medida con IA', gl: 'OSIX Tech - Consultoría Tecnolóxica & Desenvolvemento a Medida con IA', en: 'OSIX Tech - Technology Consulting & Custom AI Development' }[lang]);

const seoDescription = ({ es: 'OSIX Tech: Desarrollo de software a medida con IA, consultoría de transformación digital y gestión de subvenciones. Tecnología que genera resultados reales para tu empresa.', gl: 'OSIX Tech: Desenvolvemento de software a medida con IA, consultoría de transformación dixital e xestión de subvencións. Tecnoloxía que xera resultados reais para a túa empresa.', en: 'OSIX Tech: Custom AI software development, digital transformation consulting, and innovation grants. Technology that delivers real results for your business.' }[lang]);

// FAQ translations for structured data
const faqTranslations = await import(`../../../public/locales/${lang}.json`);
const ft = (k: string) => faqTranslations.default[k] || k;

// Team members for Person schema (E-E-A-T signals)
const teamPersons = [
  { name: "Pablo Pazos", role: "CTO / Software Architect", linkedin: "https://www.linkedin.com/in/pablo-pazos-parada/" },
  { name: "Mateo Bodenlle", role: "CFO", linkedin: "https://www.linkedin.com/in/mateo-bodenlle-villarino/" },
  { name: "Juan Freire", role: "Backend Engineer", linkedin: "https://www.linkedin.com/in/juan-freire-alvarez/" },
  { name: "David Gutiérrez", role: "Security & AI Backend Engineer", linkedin: "https://www.linkedin.com/in/david-gutierrez-cs/" },
  { name: "Nicolás Corbal", role: "Frontend Engineer", linkedin: "https://www.linkedin.com/in/nicol%C3%A1s-corbal-912929318/" },
  { name: "David M. Raposeiras", role: "DevOps Engineer", linkedin: "https://www.linkedin.com/in/david-manuel-raposeiras-canabal-a95028210/" },
  { name: "Diego Cristóbal", role: "Full Stack Mobile Engineer", linkedin: "https://www.linkedin.com/in/diego-cristobal-andaluz-3a5580304/" },
];

// Collect testimonials from all services for AggregateRating
const allServices = getAllServices(lang);
const testimonials = allServices.map(s => s.testimonial);

// Structured Data — unified @graph
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "LocalBusiness"],
      "@id": "https://osix.tech/#organization",
      "name": "OSIX Tech",
      "url": "https://osix.tech",
      "logo": "https://osix.tech/logo_w.png",
      "description": seoDescription,
      "telephone": "+34 648935068",
      "email": "info@osix.tech",
      "foundingDate": "2024",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Santiago del Estero, 2-4 1G",
        "addressLocality": "Santiago de Compostela",
        "addressRegion": "Galicia",
        "postalCode": "15702",
        "addressCountry": "ES"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 42.8782,
        "longitude": -8.5448
      },
      "areaServed": [
        { "@type": "Country", "name": "Spain" },
        { "@type": "AdministrativeArea", "name": "Galicia" }
      ],
      "sameAs": [
        "https://github.com/osixtech",
        "https://linkedin.com/company/osixtech"
      ],
      "knowsAbout": [
        "Artificial Intelligence",
        "Inteligencia Artificial",
        "Intelixencia Artificial",
        "AI Consulting",
        "Consultoría de IA",
        "Consultoría de IA en Galicia",
        "Digital Transformation",
        "Intelligent Agents",
        "Process Automation",
        "IGAPE IA360",
        "Custom Software Development"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": "info@osix.tech",
        "telephone": "+34 648935068",
        "availableLanguage": ["English", "Spanish", "Galician"]
      },
      "employee": teamPersons.map(p => ({
        "@type": "Person",
        "name": p.name,
        "jobTitle": p.role,
        "worksFor": { "@id": "https://osix.tech/#organization" },
        "sameAs": [p.linkedin]
      })),
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5",
        "bestRating": "5",
        "ratingCount": String(testimonials.length),
        "reviewCount": String(testimonials.length)
      },
      "review": testimonials.map(t => ({
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "author": { "@type": "Person", "name": t.author },
        "reviewBody": t.quote
      })),
      "makesOffer": allServices.map(s => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": s.title,
          "description": s.description,
          "url": `https://osix.tech/${lang}/servicios/${s.id}`
        }
      }))
    },
    {
      "@type": "WebSite",
      "@id": "https://osix.tech/#website",
      "name": "OSIX Tech",
      "url": "https://osix.tech",
      "publisher": { "@id": "https://osix.tech/#organization" },
      "inLanguage": ["en", "es", "gl"]
    },
    {
      "@type": "WebPage",
      "@id": `https://osix.tech/${lang}/#webpage`,
      "name": seoTitle,
      "description": seoDescription,
      "url": `https://osix.tech/${lang}/`,
      "inLanguage": lang,
      "dateModified": "2026-04-07",
      "isPartOf": { "@id": "https://osix.tech/#website" },
      "about": { "@id": "https://osix.tech/#organization" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [{
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `https://osix.tech/${lang}/`
        }]
      }
    },
    {
      "@type": "FAQPage",
      "@id": `https://osix.tech/${lang}/#faq`,
      "isPartOf": { "@id": `https://osix.tech/${lang}/#webpage` },
      "mainEntity": [
        { "@type": "Question", "name": ft('home.faq.q1'), "acceptedAnswer": { "@type": "Answer", "text": ft('home.faq.a1') } },
        { "@type": "Question", "name": ft('home.faq.q2'), "acceptedAnswer": { "@type": "Answer", "text": ft('home.faq.a2') } },
        { "@type": "Question", "name": ft('home.faq.q3'), "acceptedAnswer": { "@type": "Answer", "text": ft('home.faq.a3') } },
        { "@type": "Question", "name": ft('home.faq.q4'), "acceptedAnswer": { "@type": "Answer", "text": ft('home.faq.a4') } },
        { "@type": "Question", "name": ft('home.faq.q5'), "acceptedAnswer": { "@type": "Answer", "text": ft('home.faq.a5') } },
        { "@type": "Question", "name": ft('home.faq.q6'), "acceptedAnswer": { "@type": "Answer", "text": ft('home.faq.a6') } }
      ]
    }
  ]
};

---

<Layout 
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="website"
  jsonLd={jsonLd}
>
  <LoadingScreen duration={1000} />
  <section id="hero"><Hero lang={lang} /></section>
  <section id="services"><ServicesShowcase lang={lang} /></section>
  <section id="guias" class="home-guias bg-white text-black">
    <div class="w-full max-w-7xl mx-auto px-6 md:px-12">
      <h2 class="section-title" set:html={{ es: "Guías <span class='font-bold'>prácticas</span>", gl: "Guías <span class='font-bold'>prácticas</span>", en: "Practical <span class='font-bold'>guides</span>" }[lang]} />
    </div>
    <div class="w-full max-w-7xl mx-auto px-6 md:px-12">
      <div class="home-guias-grid">
        {latestGuides.slice(0, 5).map((g, i) => (
          <a class="guia-home-card" href={`/es/guias/${g.slug}/`}>
            <div class="guia-home-media">
              <Fragment set:html={genGuideArt(g.slug, i)} />
              <span class="guia-home-tag">{g.tag}</span>
            </div>
            <div class="guia-home-body">
              <h3 class="guia-home-title">{g.title}</h3>
              <div class="guia-home-meta">
                <span class="guia-home-arrow" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
                <time class="guia-home-date" datetime={g.date}>{formatGuideDate(g.date)}</time>
              </div>
            </div>
          </a>
        ))}
        <a class="guia-home-card guia-home-card-all" href={`/es/guias/`}>
          <div class="guia-home-all-inner">
            <span class="guia-home-all-count">10+</span>
            <span class="guia-home-all-label">{{ es: 'Ver todas las guías', gl: 'Ver todas as guías', en: 'See all guides' }[lang]}</span>
            <span class="guia-home-all-arrow" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>
  <section id="about-us"><AboutUsSection lang={lang} /></section>
  <section id="faq"><HomeFAQ lang={lang} /></section>
  <section id="contact"><StaticContactSection lang={lang} /></section>
</Layout>

<style>
  #hero {
    margin-bottom: 7.5vh !important;
  }

  .contact-section {
    transform: translateY(100%);
    opacity: 0;
  }

  .contact-section.visible {
    transform: translateY(0);
    opacity: 1;
  }
</style>

<style is:global>
  .home-guias {
    padding: 32px 0 112px;
  }

  .home-guias-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .home-guias-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .home-guias-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .guia-home-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    text-decoration: none;
    overflow: hidden;
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 0.8s cubic-bezier(0.19, 1, 0.22, 1),
      transform 0.8s cubic-bezier(0.19, 1, 0.22, 1),
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .home-guias.in-view .guia-home-card {
    opacity: 1;
    transform: translateY(0);
  }

  .home-guias.in-view .guia-home-card:nth-child(1) { transition-delay: 0.05s, 0.05s, 0s, 0s; }
  .home-guias.in-view .guia-home-card:nth-child(2) { transition-delay: 0.13s, 0.13s, 0s, 0s; }
  .home-guias.in-view .guia-home-card:nth-child(3) { transition-delay: 0.21s, 0.21s, 0s, 0s; }
  .home-guias.in-view .guia-home-card:nth-child(4) { transition-delay: 0.29s, 0.29s, 0s, 0s; }
  .home-guias.in-view .guia-home-card:nth-child(5) { transition-delay: 0.37s, 0.37s, 0s, 0s; }
  .home-guias.in-view .guia-home-card:nth-child(6) { transition-delay: 0.45s, 0.45s, 0s, 0s; }
  .home-guias.in-view .guia-home-card:nth-child(7) { transition-delay: 0.53s, 0.53s, 0s, 0s; }

  .guia-home-card:hover {
    border-color: #0a0a0a;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
  }

  /* Upper part: image + category tag */
  .guia-home-media {
    position: relative;
    aspect-ratio: 16 / 8;
    background: #0a0a0a;
    overflow: hidden;
  }

  .guia-home-media svg,
  .guia-home-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .guia-home-card:hover .guia-home-media svg,
  .guia-home-card:hover .guia-home-media img {
    transform: scale(1.06);
  }

  .guia-home-tag {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #0a0a0a;
    background: #fff;
    padding: 0.3rem 0.7rem;
  }

  /* Lower part: title + date */
  .guia-home-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.25rem 1rem;
  }

  .guia-home-title {
    font-size: 1rem;
    font-weight: 700;
    color: #0a0a0a;
    line-height: 1.4;
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .guia-home-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .guia-home-arrow {
    color: rgba(0, 0, 0, 0.3);
    transition: color 0.3s ease, transform 0.3s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .guia-home-card:hover .guia-home-arrow {
    color: #0a0a0a;
    transform: translateX(5px);
  }

  .guia-home-date {
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.35);
    letter-spacing: 0.04em;
  }

  /* "See all" card */
  .guia-home-card-all {
    background: #0a0a0a;
    border-color: #0a0a0a;
  }

  .guia-home-card-all:hover {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
  }

  .guia-home-all-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
    padding: 1.5rem;
  }

  .guia-home-all-count {
    font-size: 3rem;
    font-weight: 800;
    color: #fff;
    line-height: 1;
  }

  .guia-home-all-label {
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.35;
    margin-top: auto;
    margin-bottom: 1.25rem;
  }

  .guia-home-all-arrow {
    color: rgba(255, 255, 255, 0.5);
    transition: color 0.3s ease, transform 0.3s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .guia-home-card-all:hover .guia-home-all-arrow {
    color: #fff;
    transform: translateX(6px);
  }

  @media (max-width: 1023px) {
    .home-guias {
      padding-bottom: 80px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const contactSection = document.querySelector('.contact-section');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1 });

    if (contactSection) {
      observer.observe(contactSection);
    }

    const guiasSection = document.querySelector('.home-guias');
    if (guiasSection) {
      const guiasObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            guiasObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      guiasObserver.observe(guiasSection);
    }
  });
</script>