---
import { render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import Metrics from '../../components/Metrics.astro';
import Faq from '../../components/Faq.astro';
import CaseCard from '../../components/CaseCard.astro';
import { getCases, getGuidesById, guideTitle, lastModified, type Case } from '../../lib/content';
import { article, faqPage } from '../../lib/schema';

export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props as { item: Case };
const { data } = item;
const { Content, headings } = await render(item);
const path = `/casos/${item.id}/`;
const cases = await getCases();
const related = cases.filter((c) => c.id !== item.id).slice(0, 3);
const guides = await getGuidesById(data.relatedGuides);

const sidebar = {
  title: 'Todos los casos',
  href: '/casos/',
  groups: [
    {
      id: 'casos',
      label: 'Casos en producción',
      items: cases.map((c) => ({ href: `/casos/${c.id}/`, label: c.data.title, current: c.id === item.id })),
    },
  ],
};

const tocHeadings = [
  ...headings,
  { depth: 2, slug: 'limite', text: data.limit.title },
  { depth: 2, slug: 'ficha', text: 'Ficha del proyecto' },
  { depth: 2, slug: 'preguntas-frecuentes', text: 'Preguntas frecuentes' },
];
---

<DocLayout
  title={data.title}
  seoTitle={data.seoTitle}
  description={data.description}
  subtitle={data.lead}
  eyebrow={`Caso · ${data.category}`}
  crumbs={[
    { name: 'Casos', path: '/casos/' },
    { name: data.title, path },
  ]}
  published={data.published}
  updated={data.updated}
  headings={tocHeadings}
  sidebar={sidebar}
  markdown={`/casos/${item.id}.md`}
  jsonLd={[
    article({
      path,
      headline: data.title,
      description: data.description,
      published: data.published,
      modified: lastModified(data)!,
      section: 'Casos de estudio',
    }),
    faqPage(path, data.faqs),
  ]}
>
  <Fragment slot="lead">
    <section class="case-metrics" aria-label="Cifras medidas">
      <Metrics items={data.metrics} label="Cifras medidas" variant="light" />
      {data.metricsNote && <p class="case-note">{data.metricsNote}</p>}
      <p class="case-status"><strong>Estado:</strong> {data.status}</p>
    </section>
  </Fragment>

  <Content />

  <Fragment slot="end">
    {
      data.secondaryMetrics && (
        <section class="case-secondary">
          <Metrics items={data.secondaryMetrics} label="Desglose de producción" variant="light" />
        </section>
      )
    }

    <section class="case-limit" aria-labelledby="limite">
      <p class="eyebrow">Alcance</p>
      <h2 id="limite">{data.limit.title}</h2>
      {data.limit.body.map((p) => <p>{p}</p>)}
    </section>

    <section class="case-facts" aria-labelledby="ficha">
      <h2 id="ficha">Ficha del proyecto</h2>
      <dl>
        {
          data.facts.map((f) => (
            <div>
              <dt>{f.key}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
      {data.sourceNote && <p class="case-source">{data.sourceNote}</p>}
    </section>

    <div class="case-faq">
      <Faq faqs={data.faqs} />
    </div>

    <aside class="case-cta">
      <h2>{data.cta.title}</h2>
      {data.cta.body.map((p) => <p>{p}</p>)}
      <a class="btn btn-dark" href="/contacto/">Cuéntanos tu proceso</a>
      {
        guides.length > 0 && (
          <ul class="case-guides">
            {guides.map((g) => (
              <li>
                Guía relacionada: <a href={`/guias/${g.id}/`}>{guideTitle(g)}</a>
              </li>
            ))}
          </ul>
        )
      }
    </aside>

    <section class="case-related" aria-labelledby="otros">
      <h2 id="otros">Otros casos</h2>
      <div class="card-grid">
        {related.map((c, i) => <CaseCard item={c} index={i + 1} />)}
      </div>
    </section>
  </Fragment>
</DocLayout>

<style>
  .case-metrics {
    margin-bottom: 2.75rem;
    padding: 1.75rem;
    background: var(--surface);
  }

  .case-note {
    margin-top: 1.5rem;
    color: #2b2b2b;
    font-size: 0.9375rem;
    max-width: 65ch;
  }

  .case-status {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .case-secondary {
    margin-top: 3rem;
  }

  .case-limit {
    margin-top: 3.5rem;
    padding: 1.75rem;
    border: 1px solid var(--ink);
  }

  .case-limit h2,
  .case-facts h2,
  .case-cta h2,
  .case-related h2 {
    font-size: 1.5rem;
    letter-spacing: -0.025em;
  }

  .case-limit h2 {
    margin-top: 0.5rem;
  }

  .case-limit p:not(.eyebrow) {
    margin-top: 0.9rem;
    line-height: 1.7;
    color: #2b2b2b;
  }

  .case-facts {
    margin-top: 3.5rem;
  }

  .case-facts dl {
    margin-top: 1.25rem;
  }

  .case-facts dl > div {
    display: grid;
    grid-template-columns: minmax(8rem, 13rem) minmax(0, 1fr);
    gap: 1.5rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .case-facts dt {
    font-weight: 700;
  }

  .case-source {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .case-faq {
    margin-top: 3.5rem;
  }

  .case-cta {
    margin-top: 3.5rem;
    padding: 1.75rem;
    background: var(--ink);
    color: var(--paper);
  }

  .case-cta p {
    margin: 0.75rem 0 0;
    color: var(--muted-on-ink);
    max-width: 62ch;
  }

  .case-cta .btn {
    margin-top: 1.5rem;
    border-color: var(--paper);
    background: var(--paper);
    color: var(--ink);
  }

  .case-cta .btn:hover {
    background: transparent;
    color: var(--paper);
  }

  .case-guides {
    list-style: none;
    padding: 1.25rem 0 0;
    margin-top: 1.5rem;
    border-top: 1px solid var(--line-on-ink);
    color: var(--muted-on-ink);
    font-size: 0.9375rem;
  }

  .case-guides a {
    color: var(--paper);
  }

  .case-related {
    margin-top: 4rem;
  }

  .case-related h2 {
    margin-bottom: 1.25rem;
  }

  .case-related .card-grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
  }

  @media (max-width: 560px) {
    .case-facts dl > div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
