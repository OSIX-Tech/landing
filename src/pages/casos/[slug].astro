---
// A case study: header, generated cover with the headline figures, then the Markdown body
// (narrative, breakdown table, limit, project sheet, FAQ, closing section). Nothing else.
import { render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import { caseFaqs, coverOf, getCases, getGuidesById, guideTitle, lastModified, type Case } from '../../lib/content';
import { ogImage } from '../../lib/og';
import { article, faqPage } from '../../lib/schema';
import { absolute } from '../../site';

export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props as { item: Case };
const { data } = item;
const { Content, headings } = await render(item);
const path = `/casos/${item.id}/`;
const cases = await getCases();
const related = cases.filter((c) => c.id !== item.id).slice(0, 3);
const guides = await getGuidesById(data.relatedGuides);
const cover = coverOf('casos', item);
const og = await ogImage(cover);
const coverAlt = `Cifras medidas: ${data.metrics.map((m) => `${m.value} ${m.label}`).join(', ')}`;

const sidebar = {
  title: 'Todos los casos',
  href: '/casos/',
  groups: [
    {
      id: 'casos',
      label: 'Casos en producción',
      items: cases.map((c) => ({ href: `/casos/${c.id}/`, label: c.data.title, current: c.id === item.id })),
    },
  ],
};
---

<DocLayout
  title={data.title}
  seoTitle={data.seoTitle}
  description={data.description}
  subtitle={data.lead}
  eyebrow={`Caso · ${data.category}`}
  crumbs={[
    { name: 'Casos', path: '/casos/' },
    { name: data.title, path },
  ]}
  published={data.published}
  updated={data.updated}
  headings={headings}
  sidebar={sidebar}
  cover={cover}
  coverAlt={coverAlt}
  coverCaption={[data.metricsNote, data.status].filter(Boolean).join(' ')}
  image={og}
  markdown={`/casos/${item.id}.md`}
  jsonLd={[
    article({
      path,
      headline: data.title,
      description: data.description,
      published: data.published,
      modified: lastModified(data)!,
      section: 'Casos de estudio',
      image: absolute(og),
    }),
    faqPage(path, caseFaqs(item)),
  ]}
>
  <Content />

  <Fragment slot="end">
    {
      guides.length > 0 && (
        <aside class="case-guides" aria-label="Guías relacionadas">
          <p class="eyebrow">Para profundizar</p>
          <ul>
            {guides.map((g) => (
              <li>
                <a href={`/guias/${g.id}/`} class="t-link">
                  {guideTitle(g)}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <section class="case-related" aria-labelledby="otros">
      <h2 id="otros">Otros casos</h2>
      <div class="card-grid">
        {related.map((c) => <CaseCard item={c} sizes="(max-width: 640px) calc(100vw - 2rem), 14rem" />)}
      </div>
    </section>
  </Fragment>
</DocLayout>

<style>
  .case-guides {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .case-guides ul {
    list-style: none;
    padding: 0;
    margin-top: 0.75rem;
  }

  .case-guides li + li {
    margin-top: 0.4rem;
  }

  .case-guides a {
    font-weight: 600;
  }

  .case-related {
    margin-top: 4rem;
  }

  .case-related h2 {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
    letter-spacing: -0.03em;
  }

  .case-related .card-grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 2rem 1.25rem;
  }

  .case-related :global(.card-title) {
    font-size: 1rem;
  }
</style>
