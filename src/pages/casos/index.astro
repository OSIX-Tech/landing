---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCases, lastModified } from '../../lib/content';
import { breadcrumbs, webPage } from '../../lib/schema';
import { absolute } from '../../site';

const cases = await getCases();
const title = 'Casos de estudio de automatización e IA | OSIX Tech';
const description =
  'Casos de estudio de OSIX Tech: software a medida, automatización documental, OCR e inteligencia artificial con métricas de producción y sus límites.';
const modified = cases.map((c) => lastModified(c.data)!).sort().at(-1);
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[
    {
      ...webPage({ path: '/casos/', name: title, description, type: 'CollectionPage', modified }),
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: cases.length,
        itemListElement: cases.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: absolute(`/casos/${c.id}/`),
          name: c.data.title,
        })),
      },
    },
    breadcrumbs([
      { name: 'Inicio', path: '/' },
      { name: 'Casos', path: '/casos/' },
    ]),
  ]}
>
  <header class="shell hub-head">
    <h1 class="rise">
      <span class="w" style="--i:0">Software</span> <span class="w" style="--i:1">que</span> <span class="w" style="--i:2">ya</span>
      <span class="w" style="--i:3">está</span> <span class="w" style="--i:4">trabajando</span>
    </h1>
    <p class="hub-lead fade-in">
      Productos que procesan documentos, ordenan correo, preparan ofertas y convierten documentación en respuestas. Cada
      caso publica la ventana medida y lo que la cifra no demuestra.
    </p>
  </header>

  <section class="shell hub-body" aria-label="Casos">
    <div class="card-grid reveal-stagger">
      {cases.map((c) => <CaseCard item={c} showLead as="h2" />)}
    </div>
  </section>

  <CtaBand title="¿Tienes un proceso parecido?" text="Podemos revisar el flujo actual, separar lo que conviene automatizar de lo que debe seguir bajo control humano y proponer una primera prueba medible." />
</BaseLayout>

<style>
  .hub-head {
    padding-block: clamp(3rem, 8vw, 6rem) 2.5rem;
  }

  h1 {
    margin-top: 1rem;
    max-width: 16ch;
    font-size: clamp(2.5rem, 7vw, 5rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .hub-lead {
    margin-top: 1.5rem;
    max-width: 62ch;
    color: var(--muted);
    font-size: 1.125rem;
    --d: 0.3s;
  }

  .hub-body {
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .hub-body .card-grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
</style>
