---
import Layout from '../../layouts/Layout.astro';
import LoadingScreen from '../../components/LoadingScreen.astro';

export const prerender = true;

// Guía actualmente en español. Ampliar a en/gl cuando exista traducción.
export async function getStaticPaths() {
  return [{}];
}

const lang = 'es' as const;

const GuideContent = (await import('../../content/es/guias/analizar-pliegos-licitaciones-ia-pyme.md')).default;

const canonicalUrl = `https://osix.tech/guias/analizar-pliegos-licitaciones-ia-pyme/`;

// SEO Data
const seoTitle = "Cómo analizar pliegos y licitaciones con IA: qué extraer y qué decide una persona - OSIX Tech";
const seoDescription = "Qué puede extraer la IA de un pliego, qué debe revisar una persona y cómo controlar requisitos, fechas, evidencias y contradicciones antes de presentar una oferta.";

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Puede la IA analizar un pliego completo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Puede extraer y organizar gran parte del contenido, pero analizarlo completo también implica detectar anexos ausentes, interpretar contradicciones y decidir qué significa cada requisito para una empresa concreta. La IA debe indicar qué ha encontrado, qué no ha podido leer y qué necesita revisión humana."
      }
    },
    {
      "@type": "Question",
      "name": "¿Puede generar la memoria técnica de una licitación?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Puede preparar un índice, extraer los puntos que debe responder la memoria y redactar un primer borrador basado en información real. El equipo debe verificar cada afirmación, adaptar la propuesta al pliego y eliminar cualquier promesa que no pueda demostrar."
      }
    },
    {
      "@type": "Question",
      "name": "¿Puede la IA decirme si mi empresa puede presentarse?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Puede comparar los requisitos del expediente con los datos y documentos que le proporciones, y señalar posibles incumplimientos o evidencias faltantes. La decisión final debe revisarla una persona con responsabilidad comercial, técnica, económica o jurídica."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué pasa si la IA no encuentra un dato?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Debe marcarlo como no encontrado y conservar la referencia al documento y las páginas revisadas. Nunca debe completar el hueco con una estimación presentada como hecho. Si el dato es decisivo, se incorpora como bloqueo de revisión."
      }
    },
    {
      "@type": "Question",
      "name": "¿Conviene automatizar también la presentación de la oferta?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "En general, es más prudente automatizar la preparación y las comprobaciones que el envío final. La presentación puede implicar firma, declaraciones, selección de archivos y aceptación de condiciones. Una persona debe revisar la versión final y conservar el justificante."
      }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · Licitaciones · IA · Pymes</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">
          Cómo analizar pliegos y licitaciones con IA
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">
          Qué extraer del pliego, qué debe decidir una persona y cómo controlar requisitos, fechas y evidencias.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <div class="related-guides mt-12 fade-up" style="--delay: 0.3s">
        <h2 class="related-guides-title">Guías relacionadas</h2>
        <ul class="related-guides-list">
          <li><a href="/guias/automatizar-facturas-documentos-pyme/">Cómo automatizar las facturas y los documentos de tu pyme</a></li>
          <li><a href="/guias/automatizar-documentos-sin-perder-revision-humana/">Automatizar documentos sin perder la revisión humana</a></li>
          <li><a href="/guias/integrar-ia-software-pyme-espana/">Cómo integrar la IA con el software que ya usa tu empresa</a></li>
          <li><a href="/guias/cuanto-cuesta-automatizar-con-ia-pyme-espana/">Cuánto cuesta automatizar procesos con IA en una pyme</a></li>
        </ul>      </div>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * tables are `white-space: nowrap` inside their scroll containers, the intrinsic
   * width of the whole article is the table width (well over the phone viewport), so the
   * column rendered ~896px wide on a 390px phone and html/body's overflow-x:clip chopped
   * the right edge off every paragraph. Fix: make the section a normal block so its child
   * caps at the viewport, and let the tables keep scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }

  .content-section .max-w-7xl {
    max-width: 100%;
    min-width: 0;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section transitions */
  .hero-section { animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroReveal { from { opacity: 0; } to { opacity: 1; } }
</style>
