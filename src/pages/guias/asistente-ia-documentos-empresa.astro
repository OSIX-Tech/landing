---
import Layout from '../../layouts/Layout.astro';
import LoadingScreen from '../../components/LoadingScreen.astro';

export const prerender = true;

// Guía en español sobre asistentes de IA basados en documentos (RAG).
export async function getStaticPaths() {
  return [{}];
}

const lang = 'es' as const;

const GuideContent = (await import('../../content/es/guias/asistente-ia-documentos-empresa.md')).default;

const canonicalUrl = `https://osix.tech/guias/asistente-ia-documentos-empresa/`;

// SEO Data
const seoTitle = "Cómo funciona un asistente de IA con los documentos de tu empresa (RAG) - OSIX Tech";
const seoDescription = "Qué hace un asistente de IA con tus documentos, cómo preparar las fuentes y probar respuestas, permisos y citas antes de abrirlo al equipo.";

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Hace falta entrenar un modelo con los documentos de mi empresa?",
      "acceptedAnswer": { "@type": "Answer", "text": "Normalmente, no. RAG busca fragmentos relevantes cuando llega una pregunta y se los entrega al modelo como contexto. Si cambian los documentos, hay que volver a procesarlos o indexarlos, pero no entrenar de nuevo el modelo." }
    },
    {
      "@type": "Question",
      "name": "¿El asistente responderá solo con mis documentos?",
      "acceptedAnswer": { "@type": "Answer", "text": "Puedes pedirle que priorice las fuentes conectadas y se abstenga si no encuentra evidencia suficiente, pero puede interpretar mal un fragmento o completar huecos. Prueba preguntas sin respuesta y exige referencias verificables." }
    },
    {
      "@type": "Question",
      "name": "¿Los empleados verán todos los documentos conectados?",
      "acceptedAnswer": { "@type": "Answer", "text": "No deberían. La aplicación debe identificar quién pregunta y aplicar permisos antes de recuperar pasajes. Prueba con cuentas distintas y confirma que los permisos de origen se respetan en el índice." }
    },
    {
      "@type": "Question",
      "name": "¿RAG elimina las alucinaciones?",
      "acceptedAnswer": { "@type": "Answer", "text": "No. Recuperar pasajes relevantes puede fundamentar la respuesta, pero el buscador puede traer un fragmento inadecuado y el modelo puede interpretarlo mal. Una cita permite revisar la respuesta, no demuestra que sea correcta." }
    },
    {
      "@type": "Question",
      "name": "¿Necesito un desarrollo a medida?",
      "acceptedAnswer": { "@type": "Answer", "text": "No siempre. Si un SaaS o una plataforma no-code respeta tus fuentes y permisos, puede bastar. Valora un desarrollo propio cuando necesites integrar sistemas, aplicar controles específicos o registrar consultas y respuestas." }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · Asistentes con IA · Documentos · Pymes</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">Cómo funciona un asistente de IA con los documentos de tu empresa</h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">RAG explicado sin jerga: preparar las fuentes, respetar permisos y probar las respuestas.</p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <div class="related-guides mt-12 fade-up" style="--delay: 0.3s">
        <h2 class="related-guides-title">Guías relacionadas</h2>
        <ul class="related-guides-list">
          <li><a href="/guias/integrar-ia-software-pyme-espana/">Cómo integrar IA con el software que ya usa tu empresa</a></li>
          <li><a href="/guias/chatbot-sin-programar/">Cuándo un chatbot no-code se queda corto</a></li>
          <li><a href="/guias/donde-se-guardan-datos-ia-empresa/">Dónde se guardan los datos de tu empresa</a></li>
        </ul>      </div>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * tables are `white-space: nowrap` inside their scroll containers, the intrinsic
   * width of the whole article is the table width (well over the phone viewport), so the
   * column rendered ~896px wide on a 390px phone and html/body's overflow-x:clip chopped
   * the right edge off every paragraph. Fix: make the section a normal block so its child
   * caps at the viewport, and let the tables keep scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section transitions */
  .hero-section { animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroReveal { from { opacity: 0; } to { opacity: 1; } }
</style>
