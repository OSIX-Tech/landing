---
import Layout from '../../layouts/Layout.astro';
import LoadingScreen from '../../components/LoadingScreen.astro';

export const prerender = true;

// Guía en español sobre automatización del ciclo de pedidos para distribuidoras.
export async function getStaticPaths() {
  return [{}];
}

const lang = 'es' as const;

const GuideContent = (await import('../../content/es/guias/automatizar-gestion-pedidos-distribuidora-galicia.md')).default;

const canonicalUrl = `https://osix.tech/guias/automatizar-gestion-pedidos-distribuidora-galicia/`;

// SEO Data
const seoTitle = "Cómo automatizar la gestión de pedidos en una distribuidora gallega - OSIX Tech";
const seoDescription = "Cómo conectar pedidos, ERP, stock, almacén y facturación en una distribuidora. Qué automatizar primero y cómo controlar errores sin cambiar de sistema por defecto.";

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Tengo que cambiar de ERP para automatizar pedidos?",
      "acceptedAnswer": { "@type": "Answer", "text": "No necesariamente. Empieza por comprobar si el ERP actual puede registrar el proceso, mantener los datos que necesita y conectarse con los otros sistemas. Configurar o integrar lo que ya funciona puede bastar. Valora un cambio cuando hayas identificado una limitación concreta que no se resuelva razonablemente de otra forma." }
    },
    {
      "@type": "Question",
      "name": "¿Se pueden registrar automáticamente los pedidos que llegan por correo o PDF?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí, se puede extraer información y preparar un pedido para revisión. La confirmación automática solo es prudente cuando el cliente, las referencias, las cantidades y las condiciones se reconocen con suficiente certeza. Los casos ambiguos deben quedar en una cola de revisión, no convertirse en pedidos válidos por defecto." }
    },
    {
      "@type": "Question",
      "name": "¿Cuándo tiene sentido usar EDI?",
      "acceptedAnswer": { "@type": "Answer", "text": "Cuando la distribuidora y sus clientes o proveedores acuerdan intercambiar documentos comerciales estructurados, como pedidos, avisos de expedición o confirmaciones de recepción. EDI no ordena por sí solo el proceso interno ni corrige catálogos inconsistentes." }
    },
    {
      "@type": "Question",
      "name": "¿Qué conviene automatizar primero?",
      "acceptedAnswer": { "@type": "Answer", "text": "El paso que hoy repite más trabajo o provoca errores que el equipo puede medir. Registra el punto de partida, automatiza ese flujo y revisa tanto el tiempo ahorrado como los errores, duplicados y excepciones. Después decide si merece la pena ampliar a stock, almacén, reparto o facturación." }
    },
    {
      "@type": "Question",
      "name": "¿Cómo evito que se duplique un pedido si falla la integración?",
      "acceptedAnswer": { "@type": "Answer", "text": "Usa una referencia estable del pedido y comprueba si ya se procesó antes de crear otro. Si se reintenta una operación, debe actualizar el registro existente o señalar el error, no duplicar la orden." }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · Distribución · Pedidos · Galicia</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">Cómo automatizar la gestión de pedidos en una distribuidora gallega</h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">Del canal de entrada a stock, almacén y factura: qué conectar primero y qué revisar antes de automatizar.</p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <div class="related-guides mt-12 fade-up" style="--delay: 0.3s">
        <h2 class="related-guides-title">Guías relacionadas</h2>
        <ul class="related-guides-list">
          <li><a href="/guias/conectar-produccion-ventas-almacen-pyme-industrial/">Cómo conectar producción, ventas y almacén en una pyme industrial</a></li>
          <li><a href="/guias/automatizar-facturas-documentos-pyme/">Cómo automatizar las facturas y los documentos de tu pyme</a></li>
          <li><a href="/guias/automatizar-ofertas-presupuestos-correo-pyme/">Automatizar la preparación de ofertas desde el correo del cliente</a></li>
        </ul>      </div>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * tables are `white-space: nowrap` inside their scroll containers, the intrinsic
   * width of the whole article is the table width (well over the phone viewport), so the
   * column rendered ~896px wide on a 390px phone and html/body's overflow-x:clip chopped
   * the right edge off every paragraph. Fix: make the section a normal block so its child
   * caps at the viewport, and let the tables keep scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section transitions */
  .hero-section { animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroReveal { from { opacity: 0; } to { opacity: 1; } }
</style>
