---
import Layout from '../../layouts/Layout.astro';
import LoadingScreen from '../../components/LoadingScreen.astro';

export const prerender = true;

// Guía actualmente en español (prompt BOFU: cómo automatizar documentos sin perder la revisión humana). Ampliar a en/gl cuando exista traducción.
export async function getStaticPaths() {
  return [{}];
}

const lang = 'es' as const;

const GuideContent = (await import('../../content/es/guias/bandeja-compartida-crm-sin-copiar-correos.md')).default;

const canonicalUrl = `https://osix.tech/guias/bandeja-compartida-crm-sin-copiar-correos/`;

// SEO Data
const seoTitle = "Cómo pasar de una bandeja compartida a un CRM sin copiar correos a mano | OSIX Tech";
const seoDescription = "Cómo convertir el correo compartido en trabajo asignado y registros trazables del CRM, con clasificación, deduplicación, revisión humana y prueba piloto.";

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Necesito sustituir Gmail o Microsoft 365 para conectar el correo al CRM?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No necesariamente. Primero comprueba las funciones de la bandeja y del CRM que ya utilizas. Si el flujo debe crear registros, consultar el ERP o aplicar reglas que la integración nativa no cubre, añade un conector o una solución específica sin cambiar de correo por defecto."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo evito que una respuesta o un reenvío cree un registro duplicado?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Define qué identifica una conversación y una operación, por ejemplo el identificador del hilo más la referencia de pedido cuando exista. Antes de crear un registro, busca una coincidencia y decide si corresponde actualizarla, crear una nueva o pedir revisión. Diseña los reintentos para que una caída de conexión no duplique la operación."
      }
    },
    {
      "@type": "Question",
      "name": "¿Puede la IA responder a los clientes automáticamente?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Puede redactar una propuesta, pero al principio una persona debería revisar los datos, las condiciones y el tono antes de enviarla. En el caso de producción descrito aquí, el sistema prepara la propuesta y el equipo decide qué se envía."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuándo basta con una bandeja compartida y cuándo necesito un CRM?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Una bandeja compartida puede bastar para repartir conversaciones y marcarlas como resueltas. El CRM resulta útil cuando necesitas relacionar mensajes con contactos, oportunidades, pedidos o incidencias, asignar un responsable y conservar el estado de cada operación.\n\nSi el equipo sigue copiando cada correo a mano, empieza por identificar una categoría de mensajes, el registro que debe producir y la excepción que debe revisar una persona. Después prueba ese flujo con una muestra antes de conectarlo a toda la bandeja."
      }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · Bandeja compartida · CRM · Automatización de correo · España</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">
          Cómo pasar de una bandeja compartida a un CRM sin copiar correos a mano
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">
          Cómo clasificar correos, crear registros trazables, asignar responsables y mantener la revisión humana.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <div class="related-guides mt-12 fade-up" style="--delay: 0.3s">
        <h2 class="related-guides-title">Guías relacionadas</h2>
        <ul class="related-guides-list">
          <li><a href="/casos/iciga-correo-crm/">Caso ICIGA: de cuatro bandejas de entrada a un flujo comercial trazable</a></li>
          <li><a href="/servicios/desarrollo-a-medida/">Desarrollo de software a medida</a></li>
          <li><a href="/guias/automatizar-ofertas-presupuestos-correo-pyme/">Preparar ofertas desde el correo del cliente</a></li>
          <li><a href="/guias/automatizar-gestion-pedidos-distribuidora-galicia/">Automatizar pedidos en una distribuidora</a></li>
        </ul>      </div>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * tables are `white-space: nowrap` inside their scroll containers, the intrinsic
   * width of the whole article is the table width (well over the phone viewport), so the
   * column rendered ~896px wide on a 390px phone and html/body's overflow-x:clip chopped
   * the right edge off every paragraph. Fix: make the section a normal block so its child
   * caps at the viewport, and let the tables keep scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section transitions */
  .hero-section { animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroReveal { from { opacity: 0; } to { opacity: 1; } }
</style>
