---
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

// Guía actualmente en español (apunta al prompt BOFU de criterios de selección). Ampliar a en/gl cuando exista traducción.
export async function getStaticPaths() {
  return [{}];
}

const lang = 'es' as const;

const GuideContent = (await import('../../content/es/guias/como-elegir-empresa-desarrollo-software-ia-espana.md')).default;

const canonicalUrl = `https://osix.tech/guias/como-elegir-empresa-desarrollo-software-ia-espana/`;

// SEO Data
const seoTitle = "Cómo elegir una empresa de desarrollo de software con IA en España (2026) - OSIX Tech";
const seoDescription = "Qué pedir antes de contratar: prueba con datos, privacidad, integración, coste total y control por fases para elegir un proveedor de IA.";

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl,
  "dateModified": "2026-09-24"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
      {
          "@type": "Question",
          "name": "¿Cómo sé si una empresa de desarrollo de software con IA es fiable?",
          "acceptedAnswer": {
              "@type": "Answer",
              "text": "Pide una prueba con datos representativos, criterios de aceptación acordados, un recorrido claro de los datos y la identidad del equipo que implementará y mantendrá el sistema. Comprueba qué sucede cuando el modelo se equivoca."
          }
      },
      {
          "@type": "Question",
          "name": "¿Conviene elegir una empresa grande o un equipo pequeño?",
          "acceptedAnswer": {
              "@type": "Answer",
              "text": "Depende del alcance. Un equipo pequeño puede encajar en un piloto acotado o una integración directa. Un programa con varios sistemas, departamentos, turnos de soporte o requisitos formales puede necesitar más capacidad. En ambos casos pregunta quién trabajará realmente en tu proyecto y quién responde si algo falla."
          }
      },
      {
          "@type": "Question",
          "name": "¿Cuándo necesito desarrollo a medida y cuándo basta una herramienta ya hecha?",
          "acceptedAnswer": {
              "@type": "Answer",
              "text": "Empieza por una herramienta existente si cubre el proceso y las integraciones necesarias sin trabajo manual oculto. Valora desarrollo a medida cuando hacen falta reglas propias, datos o sistemas que la herramienta no conecta, una experiencia de usuario específica o controles que no ofrece la solución estándar."
          }
      },
      {
          "@type": "Question",
          "name": "¿Qué debería incluir una propuesta de IA?",
          "acceptedAnswer": {
              "@type": "Answer",
              "text": "El problema y la medida de éxito, el alcance, la arquitectura, los datos tratados, las integraciones, los controles humanos, los criterios de aceptación, los costes iniciales y recurrentes, el soporte y las condiciones de salida."
          }
      },
      {
          "@type": "Question",
          "name": "¿Quién es responsable del cumplimiento del RGPD?",
          "acceptedAnswer": {
              "@type": "Answer",
              "text": "Depende del papel de cada organización y del tratamiento concreto. La empresa cliente y los proveedores pueden tener obligaciones distintas. Haz que el proveedor describa sus funciones y responsabilidades, y solicita revisión jurídica para el caso específico. Esta guía no sustituye asesoramiento legal."
          }
      }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>


  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4">Guía · Desarrollo con IA · España</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 leading-tight">
          Cómo elegir una empresa de desarrollo de software con IA en España
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6">
          Pruebas, privacidad, integración, coste total y cómo conservar el control en un proyecto con IA.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <!-- Related guides (internal linking for indexation) -->
      <div class="related-guides mt-12">
        <h2 class="related-guides-title">Guías relacionadas</h2>
        <ul class="related-guides-list">
          <li><a href="/guias/como-elegir-empresa-automatizacion-ia-galicia/">Cómo elegir una empresa de automatización con IA en Galicia</a></li>
          <li><a href="/guias/mejores-empresas-automatizacion-ia-espana/">Mejores empresas de automatización con IA para pymes en España</a></li>
          <li><a href="/guias/consultoras-ia-grandes-vs-especializadas-pymes/">Consultoras grandes frente a especialistas en pymes</a></li>
        </ul>
      </div>

      <!-- Back to home button -->
      <div class="text-center mt-12">
        <a href={`/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * scoring table is `white-space: nowrap` inside its scroll container, the intrinsic
   * width of the whole article is the table width (well over the phone viewport), so the
   * column rendered ~896px wide on a 390px phone and html/body's overflow-x:clip chopped
   * the right edge off every paragraph. Fix: make the section a normal block so its child
   * caps at the viewport, and let the tables keep scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }

</style>
