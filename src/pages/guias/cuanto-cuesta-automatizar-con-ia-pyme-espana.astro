---
import Layout from '../../layouts/Layout.astro';
import LoadingScreen from '../../components/LoadingScreen.astro';

export const prerender = true;

// Guía actualmente en español (apunta al prompt BOFU de coste). Ampliar a en/gl cuando exista traducción.
export async function getStaticPaths() {
  return [{}];
}

const lang = 'es' as const;

const GuideContent = (await import('../../content/es/guias/cuanto-cuesta-automatizar-con-ia-pyme-espana.md')).default;

const canonicalUrl = `https://osix.tech/guias/cuanto-cuesta-automatizar-con-ia-pyme-espana/`;

// SEO Data
const seoTitle = 'Cuánto cuesta automatizar procesos con IA en una pyme española (2026): precios reales por tipo de proyecto - OSIX Tech';
const seoDescription = 'Cuánto cuesta un proyecto de automatización con IA para una pyme en España en 2026: rangos por tipo de proyecto, coste total a 24 meses, mantenimiento y criterios para comparar presupuestos.';

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl,
  "dateModified": "2026-09-22"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta automatizar un proceso con IA en una pyme en España?",
      "acceptedAnswer": { "@type": "Answer", "text": "Para un proceso bien definido, calcula entre 3.000 y 5.000 € de implantación y entre 200 y 300 € al mes de operación y mantenimiento. Si hay varias integraciones, documentos, agentes o requisitos de trazabilidad, el proyecto suele subir a 5.000 a 15.000 €. Una plataforma privada con marca propia pertenece a otro tramo y puede llegar a 25.000 €." }
    },
    {
      "@type": "Question",
      "name": "¿Qué encarece un proyecto de automatización con IA?",
      "acceptedAnswer": { "@type": "Answer", "text": "Lo encarecen sobre todo cinco cosas: conectar sistemas sin una API adecuada, ordenar datos que llegan en formatos distintos, cubrir muchas excepciones, exigir permisos y trazabilidad, y ampliar el alcance antes de validar el primer proceso. El modelo de IA es solo una parte del presupuesto. Pide que cada factor aparezca reflejado en el alcance y en el precio." }
    },
    {
      "@type": "Question",
      "name": "¿Es mejor montarlo yo con n8n, Make o Zapier?",
      "acceptedAnswer": { "@type": "Answer", "text": "Puede ser suficiente para un flujo corto, con pocas excepciones, datos no sensibles y una persona interna que pueda mantenerlo. Pide ayuda especializada si el proceso toca un ERP o CRM, depende de datos desordenados, necesita permisos por rol o debe dejar un registro auditable. El tiempo interno también forma parte del coste." }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta mantener una automatización con IA?",
      "acceptedAnswer": { "@type": "Answer", "text": "La operación y el mantenimiento suelen presupuestarse mensualmente, con referencias de 200 a 800 € al mes para proyectos profesionales. Ese importe puede incluir monitorización, corrección de errores, adaptación de integraciones y pequeñas mejoras. El consumo de los modelos, las licencias y los cambios grandes de alcance deben aparecer separados. Pregunta qué horas, tiempos de respuesta y tareas incluye el mantenimiento." }
    },
    {
      "@type": "Question",
      "name": "¿Cómo comparo dos presupuestos de automatización?",
      "acceptedAnswer": { "@type": "Answer", "text": "Compara el resultado entregable, los sistemas conectados, los casos excepcionales incluidos, las horas internas que necesitará tu equipo, el coste mensual y el coste total a 24 meses. Un presupuesto más barato puede dejar fuera mantenimiento, consumo de modelos, limpieza de datos o cambios necesarios para que el proceso funcione en producción." }
    },
    {
      "@type": "Question",
      "name": "¿Las ayudas cubren un proyecto de automatización con IA?",
      "acceptedAnswer": { "@type": "Answer", "text": "No se puede asumir que cubran el proyecto entero. Kit Consulting ofrece bonos de asesoramiento digital y contempla un servicio de Inteligencia Artificial, pero la elegibilidad y el alcance financiable dependen de la convocatoria y del tamaño de la empresa. Comprueba siempre la información oficial antes de restar la ayuda del presupuesto de implantación." }
    }
  ]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>

  <LoadingScreen duration={1000} />

  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4 opacity-0">Guía · Precios · Automatización con IA · España</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 opacity-0 leading-tight">
          Cuánto cuesta automatizar procesos con IA en una pyme española
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6 opacity-0">
          Precios por tipo de proyecto en 2026, coste total a 24 meses y criterios para comparar presupuestos.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12 fade-up" style="--delay: 0.2s">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <!-- Related guides (internal linking for indexation) -->
      <div class="related-guides mt-12 fade-up" style="--delay: 0.3s">
        <h2 class="related-guides-title">Guías relacionadas</h2>
        <ul class="related-guides-list">
          <li><a href="/guias/consultoras-ia-grandes-vs-especializadas-pymes/">Consultoras de IA grandes vs especializadas en pymes</a></li>
          <li><a href="/guias/mejores-empresas-automatizacion-ia-galicia/">Mejores empresas de automatización con IA en Galicia</a></li>
          <li><a href="/guias/como-elegir-empresa-desarrollo-software-ia-espana/">Cómo elegir una empresa de desarrollo de software con IA</a></li>
        </ul>
      </div>

      <!-- Back to home button -->
      <div class="text-center mt-12 fade-up" style="--delay: 0.4s">
        <a href={`/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

    const initializeAnimations = () => {
      setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
      setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
      setTimeout(() => { document.querySelector('.hero-badge')?.classList.add('animate'); }, 200);
      document.querySelectorAll('.fade-up').forEach(el => { el.classList.add('in-view'); });
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * price tables are `white-space: nowrap` inside their scroll containers, the intrinsic
   * width of the whole article is the table width (well over the phone viewport), so the
   * column rendered ~896px wide on a 390px phone and html/body's overflow-x:clip chopped
   * the right edge off every paragraph. Fix: make the section a normal block so its child
   * caps at the viewport, and let the tables keep scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }

  /* Hero Animations */
  .hero-title { opacity: 0; transform: translateX(-100px) skewX(-5deg); transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle { opacity: 0; transform: translateX(100px); transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-badge { opacity: 0; transform: translateY(20px); transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1); }
  .hero-badge.animate { opacity: 1; transform: translateY(0); }

  /* Fade up animation */
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section transitions */
  .hero-section { animation: heroReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroReveal { from { opacity: 0; } to { opacity: 1; } }
</style>
