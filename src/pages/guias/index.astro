---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getGuides, getGuidesBySection, guideTitle } from '../../lib/content';
import { breadcrumbs, webPage } from '../../lib/schema';
import { absolute } from '../../site';

const guides = await getGuides();
const sections = (await getGuidesBySection()).filter((s) => s.guides.length);
const latest = guides.slice(0, 3);

const title = 'Guías de IA para pymes en España y Galicia - OSIX Tech';
const description =
  'Guías prácticas sobre inteligencia artificial para pymes: cuánto cuesta automatizar, cómo elegir proveedor, qué procesos automatizar y cómo medir resultados. Con fuentes y límites honestos.';
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[
    {
      ...webPage({ path: '/guias/', name: title, description, type: 'CollectionPage', modified: guides[0]?.data.updated ?? guides[0]?.data.published }),
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: guides.length,
        itemListElement: guides.map((g, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: absolute(`/guias/${g.id}/`),
          name: guideTitle(g),
        })),
      },
    },
    breadcrumbs([
      { name: 'Inicio', path: '/' },
      { name: 'Guías', path: '/guias/' },
    ]),
  ]}
>
  <header class="shell hub-head">
    <p class="eyebrow fade-in" style="--d: 0s">{guides.length} guías prácticas</p>
    <h1 class="rise">
      <span class="w" style="--i:0">Guías</span> <span class="w" style="--i:1">de</span> <span class="w" style="--i:2">IA</span>
      <span class="w" style="--i:3">para</span> <span class="w" style="--i:4">pymes</span>
    </h1>
    <p class="hub-lead fade-in">
      Comparativas y análisis prácticos: cuánto cuesta automatizar, qué empresas y herramientas conviene mirar, qué procesos
      merece la pena automatizar y cómo comprobar si funciona. Cada guía cita sus fuentes y dice qué no sabemos.
    </p>
    <nav class="hub-index fade-in" aria-label="Secciones">
      {sections.map((s) => <a href={`#${s.id}`}>{s.label} <span>{s.guides.length}</span></a>)}
    </nav>
  </header>

  <section class="shell hub-latest" aria-labelledby="recientes">
    <h2 id="recientes" class="hub-section-title">Lo más reciente</h2>
    <div class="card-grid reveal-stagger">
      {latest.map((g) => <GuideCard guide={g} showSummary />)}
    </div>
  </section>

  {
    sections.map((s) => (
      <section class="shell hub-section" id={s.id} aria-labelledby={`${s.id}-t`}>
        <h2 id={`${s.id}-t`} class="hub-section-title">
          {s.label}
        </h2>
        <ul class="hub-list">
          {s.guides.map((g) => (
            <li>
              <a href={`/guias/${g.id}/`}>
                <span class="hub-item-title">{guideTitle(g)}</span>
                <span class="hub-item-summary">{g.data.summary}</span>
              </a>
              <span class="hub-item-tag">{g.data.category}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <div class="hub-gap"></div>
  <CtaBand />
</BaseLayout>

<style>
  .hub-head {
    padding-block: clamp(3rem, 8vw, 6rem) 2.5rem;
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .hub-lead {
    margin-top: 1.5rem;
    max-width: 64ch;
    color: var(--muted);
    font-size: 1.125rem;
    --d: 0.3s;
  }

  .hub-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
    --d: 0.45s;
  }

  .hub-index a {
    display: inline-flex;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--line-strong);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .hub-index a:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .hub-index span {
    color: var(--muted);
    font-weight: 400;
  }

  .hub-index a:hover span {
    color: var(--muted-on-ink);
  }

  .hub-latest {
    padding-block: 1.5rem 2rem;
  }

  .hub-section {
    padding-top: 3.5rem;
  }

  .hub-section-title {
    padding-top: 1.25rem;
    margin-bottom: 1.25rem;
    border-top: 1px solid var(--ink);
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: -0.025em;
  }

  .hub-list {
    list-style: none;
    padding: 0;
  }

  .hub-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .hub-list a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 0;
    text-decoration: none;
  }

  .hub-item-title {
    align-self: flex-start;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--t) var(--ease);
  }

  .hub-list a:hover .hub-item-title {
    background-size: 100% 1px;
  }

  .hub-item-summary {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .hub-item-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .hub-gap {
    height: clamp(4rem, 8vw, 6rem);
  }

  @media (max-width: 640px) {
    .hub-list li {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .hub-item-tag {
      display: none;
    }
  }
</style>
