---
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

// Guía en español sobre propiedad del código fuente en contratos de desarrollo a medida.
export async function getStaticPaths() {
  return [{}];
}

const lang = 'es' as const;

const GuideContent = (await import('../../content/es/guias/quien-es-dueno-codigo-fuente-software-encargo.md')).default;

const canonicalUrl = `https://osix.tech/guias/quien-es-dueno-codigo-fuente-software-encargo/`;

// SEO Data
const seoTitle = "¿Quién es dueño del código fuente de un software por encargo? (España) - OSIX Tech";
const seoDescription = "Qué aclara la ley española y qué debes pactar sobre derechos de explotación, entrega del código fuente, componentes previos y continuidad.";

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `https://osix.tech/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guías",
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": seoTitle,
  "description": seoDescription,
  "url": canonicalUrl,
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "OSIX Tech",
    "url": "https://osix.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://osix.tech/logo_w.png"
    }
  },
  "mainEntityOfPage": canonicalUrl,
  "dateModified": "2026-09-28"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
  {
    "@type": "Question",
    "name": "Si he pagado el desarrollo, ¿el código es mío?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "No lo presupongas. El pago, por sí solo, no sustituye una cláusula clara sobre derechos y entregables. Comprueba quién creó cada parte, qué derechos se cedieron o licenciaron y qué dice el contrato sobre la copia fuente."
    }
  },
  {
    "@type": "Question",
    "name": "¿Tener el código fuente significa que puedo modificarlo o revenderlo?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "No necesariamente. La entrega material del código y los derechos para reproducirlo, transformarlo, distribuirlo o autorizar a terceros son cuestiones relacionadas pero distintas. Comprueba qué permite la licencia o cesión y qué restricciones imponen componentes de terceros."
    }
  },
  {
    "@type": "Question",
    "name": "¿Qué pasa con el software creado por un empleado?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "La Ley de Propiedad Intelectual atribuye al empresario, salvo pacto en contrario, los derechos de explotación del programa creado por un trabajador en el ejercicio de sus funciones o siguiendo instrucciones del empleador, tanto para el programa fuente como para el objeto. Es una regla específica y no resuelve automáticamente una contratación con un proveedor independiente."
    }
  },
  {
    "@type": "Question",
    "name": "¿Qué debo exigir antes de firmar con un desarrollador?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Deja claros los derechos concedidos, su alcance, los componentes previos y de terceros, la entrega del repositorio y la documentación, los accesos, los criterios de aceptación y el plan de salida. Pide revisión jurídica si no está claro qué puede hacer tu empresa o un futuro proveedor."
    }
  }
]
};

const jsonLd = [breadcrumbSchema, articleSchema, faqSchema];
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  pageType="article"
  jsonLd={jsonLd}>


  <!-- Hero Section -->
  <section class="hero-section relative min-h-[420px] bg-black lg:min-h-[480px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="flex justify-center mx-auto max-w-7xl z-10 px-4 sm:px-6 lg:px-0 w-full">
      <div class="flex-col flex justify-center items-center max-w-4xl">
        <span class="hero-badge text-xs uppercase tracking-widest text-gray-400 mb-4">Guía · Software a medida · España</span>
        <h1 class="hero-title text-center text-4xl md:text-6xl font-bold text-white mb-4 leading-tight">
          ¿Quién es dueño del código fuente de un software por encargo?
        </h1>
        <p class="hero-subtitle text-xl text-center md:text-2xl text-gray-300 mb-6">
          Derechos de explotación, repositorio, entrega y continuidad: qué conviene aclarar antes de contratar.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section pt-16 pb-32 bg-white mb-0">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <article class="content-card bg-white rounded-lg p-8 md:p-12">
        <div class="markdown-body">
          <GuideContent />
        </div>
      </article>

      <!-- Related guides (internal linking for indexation) -->
      <div class="related-guides mt-12">
        <h2 class="related-guides-title">Guías relacionadas</h2>
        <ul class="related-guides-list">
          <li><a href="/guias/como-elegir-empresa-desarrollo-software-ia-espana/">Cómo elegir una empresa de desarrollo de software con IA</a></li>
          <li><a href="/guias/trabajar-con-consultora-ia-sin-perder-control/">Cómo trabajar con una consultora sin perder el control</a></li>
        </ul>
      </div>

      <!-- Back to home button -->
      <div class="text-center mt-12">
        <a href={`/`} class="btn-primary btn-arrow">
          Volver al inicio
          <svg class="btn-arrow-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Wrap markdown tables so they expand and scroll inside their own container,
    // never making the page itself scroll horizontally.
    document.querySelectorAll('.markdown-body table').forEach((t) => {
      if (t.parentElement && !t.parentElement.classList.contains('table-scroll')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    });

  });
</script>

<style is:global>
  /*
   * Mobile horizontal overflow fix.
   * The global `section { display: flex }` rule turns this section's wrapper into a
   * flex item that refuses to shrink below its content's intrinsic width. Because the
   * scoring table is `white-space: nowrap` inside its scroll container, the intrinsic
   * width of the whole article is the table width (well over the phone viewport), so the
   * column rendered ~896px wide on a 390px phone and html/body's overflow-x:clip chopped
   * the right edge off every paragraph. Fix: make the section a normal block so its child
   * caps at the viewport, and let the tables keep scrolling inside their own containers.
   */
  .content-section {
    display: block;
    width: 100%;
  }

</style>
