---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import CaseCard from '../components/CaseCard.astro';
import GuideCard from '../components/GuideCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCases, getGuides, getServices, getTeam } from '../lib/content';
import { faqPage, webPage } from '../lib/schema';
import { clients, faqs } from '../data/home';

const [services, cases, guides, team] = await Promise.all([getServices(), getCases(), getGuides(), getTeam()]);
const title = 'Consultoría de IA para pymes en Galicia | OSIX Tech';
const description =
  'OSIX Tech: consultoría de IA y desarrollo de software a medida para pymes de Galicia y España. Automatización, agentes de IA y casos en producción con cifras medidas.';
---

<BaseLayout title={title} description={description} jsonLd={[webPage({ path: '/', name: title, description }), faqPage('/', faqs)]}>
  <Hero />

  <section class="clients" aria-label="Empresas que confían en OSIX">
    <div class="shell clients-inner">
      <p class="eyebrow">Ya confían en nosotros</p>
      <ul>
        {
          clients.map((c) => (
            <li>
              <Image src={c.logo} alt={c.name} height={36} densities={[1, 2]} loading="lazy" decoding="async" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" id="servicios">
    <div class="shell">
      <span id="services" aria-hidden="true"></span>
      <SectionHead title="Nuestros **servicios**" link={{ href: '/servicios/', label: 'Ver servicios' }} />
      <div class="services reveal-stagger">
        {
          services.map((s, i) => (
            <a class="service" href={`/servicios/${s.id}/`}>
              <span class="service-top">
                <span class="service-num">0{i + 1}</span>
                <Icon name={s.data.icon} size={22} />
              </span>
              <h3>{s.data.title}</h3>
              <p>{s.data.tagline}</p>
              <ul>
                {s.data.highlights.slice(0, 3).map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
              <span class="link-arrow">
                Ver servicio <Icon name="arrow" size={15} class="arrow" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band-surface" id="casos">
    <div class="shell">
      <SectionHead
        title="Casos en **producción**"
        lead="No enseñamos demos aisladas. Cada caso publica la ventana medida y lo que la cifra no demuestra."
        link={{ href: '/casos/', label: `Ver los ${cases.length} casos` }}
      />
      <div class="card-grid reveal-stagger">
        {cases.slice(0, 3).map((c, i) => <CaseCard item={c} index={i} />)}
        <a class="card card-all" href="/casos/">
          <strong>{cases.length}</strong>
          <span class="link-arrow">Ver todos los casos <Icon name="arrow" size={15} class="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="band" id="guias">
    <div class="shell">
      <SectionHead
        title="Guías **prácticas**"
        lead="Costes, plazos, proveedores y procesos explicados para pymes, con fuentes y límites honestos."
        link={{ href: '/guias/', label: `Ver las ${guides.length} guías` }}
      />
      <div class="card-grid reveal-stagger">
        {guides.slice(0, 5).map((g, i) => <GuideCard guide={g} index={i} />)}
        <a class="card card-all" href="/guias/">
          <strong>{guides.length}</strong>
          <span class="link-arrow">Ver todas las guías <Icon name="arrow" size={15} class="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="band band-surface" id="about-us">
    <div class="shell">
      <SectionHead
        title="Quién está **detrás**"
        lead="Un equipo de ingenieros en Santiago de Compostela que diseña, construye y mantiene cada proyecto."
        link={{ href: '/nosotros/', label: 'Conocer al equipo' }}
      />
      <ul class="team reveal-stagger">
        {
          team.map((m) => (
            <li>
              <a href={`/nosotros/#${m.id}`}>
                <Image src={m.data.photo} alt="" width={240} height={240} loading="lazy" decoding="async" class="team-photo" />
                <span class="team-name">{m.data.name}</span>
                <span class="team-role">{m.data.role}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" id="faq">
    <div class="shell faq-grid">
      <div class="reveal">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="faq-title">Lo que necesitas saber</h2>
      </div>
      <Faq faqs={faqs} title="Preguntas frecuentes sobre OSIX" id="faq-osix" />
    </div>
  </section>

  <CtaBand id="contact" />
</BaseLayout>

<style>
  .clients {
    border-block: 1px solid var(--line);
  }

  .clients-inner {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding-block: 1.75rem;
  }

  .clients .eyebrow {
    flex-shrink: 0;
  }

  .clients ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.5rem;
    list-style: none;
    padding: 0;
  }

  .clients img {
    height: 1.75rem;
    width: auto;
    filter: grayscale(1);
    opacity: 0.7;
    transition:
      opacity 0.3s ease,
      filter 0.3s ease;
  }

  .clients img:hover {
    filter: none;
    opacity: 1;
  }

  #services {
    position: relative;
    top: calc(-1 * var(--header-h));
  }

  .services {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.75rem;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    transition: transform 0.4s var(--ease-out);
  }

  .service:hover {
    transform: translateY(-4px);
  }

  .service-top {
    display: flex;
    justify-content: space-between;
    color: var(--muted-on-ink);
  }

  .service-num {
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .service h3 {
    margin-top: 1.5rem;
    font-size: 1.625rem;
    letter-spacing: -0.03em;
  }

  .service p {
    color: var(--muted-on-ink);
  }

  .service ul {
    display: grid;
    gap: 0.5rem;
    padding: 1rem 0 0;
    margin-bottom: auto;
    border-top: 1px solid var(--line-on-ink);
    list-style: none;
    font-size: 0.9375rem;
  }

  .service li::before {
    content: '— ';
    color: var(--muted-on-ink);
  }

  .service .link-arrow {
    margin-top: 1rem;
  }

  .team {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
  }

  .team a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }

  .team :global(.team-photo) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: 0.6rem;
    filter: grayscale(1);
    transition: filter 0.4s ease;
  }

  .team a:hover :global(.team-photo) {
    filter: none;
  }

  .team-name {
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .team-role {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 3rem;
  }

  .faq-title {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.035em;
  }

  .faq-grid :global(.faq h2) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  @media (max-width: 1000px) {
    .services {
      grid-template-columns: 1fr;
    }

    .team {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }

    .clients-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
