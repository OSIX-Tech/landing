---
// The home is the showcase: the one page that is allowed to move. Each section has its
// own background and composition; everything below the hero still reads without JS.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import GuideCard from '../components/GuideCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { coverOf, getCases, getGuides, getServices, getTeam } from '../lib/content';
import { faqPage, webPage } from '../lib/schema';
import { clients, faqs } from '../data/home';

const [services, cases, guides, team] = await Promise.all([getServices(), getCases(), getGuides(), getTeam()]);
const title = 'Consultoría de IA para pymes en Galicia | OSIX Tech';
const description =
  'OSIX Tech: consultoría de IA y desarrollo de software a medida para pymes de Galicia y España. Automatización, agentes de IA y casos en producción con cifras medidas.';
---

<BaseLayout title={title} description={description} jsonLd={[webPage({ path: '/', name: title, description }), faqPage('/', faqs)]}>
  <Hero />

  <!-- Clients: a black band with the logos in white, moving slowly. Pauses on hover. -->
  <section class="clients" aria-label="Empresas que confían en OSIX">
    <div class="marquee">
      <ul class="marquee-track">
        {
          [0, 1].map((copy) =>
            clients.map((c) => (
              <li aria-hidden={copy === 1 ? 'true' : undefined}>
                <Image src={c.logo} alt={copy === 0 ? c.name : ''} height={44} densities={[1, 2]} loading="lazy" decoding="async" />
              </li>
            )),
          )
        }
      </ul>
    </div>
  </section>

  <!-- Services: the title stays while the three services scroll past it. -->
  <section class="band" id="servicios">
    <div class="shell services">
      <span id="services" aria-hidden="true"></span>
      <div class="services-head reveal">
        <p class="eyebrow">Servicios</p>
        <h2 class="section-title">Tres formas de<br />trabajar con OSIX</h2>
        <p class="section-lead">
          Construimos el software, te ayudamos a decidir qué automatizar o preparamos el proyecto cuando hay una ayuda
          pública vigente que encaja. En los tres casos empezamos por tu proceso real.
        </p>
        <a class="link-arrow" href="/servicios/">Ver servicios <Icon name="arrow" size={15} class="arrow" /></a>
      </div>
      <ol class="services-list">
        {
          services.map((s) => (
            <li class="reveal">
              <a class="service" href={`/servicios/${s.id}/`}>
                <span class="service-main">
                  <h3 class="service-title"><span class="t-link">{s.data.shortTitle ?? s.data.title}</span></h3>
                  <p class="service-text">{s.data.summary ?? s.data.description}</p>
                </span>
                <Icon name="arrow" size={24} class="arrow service-arrow" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Cases: black. One featured cover, then every case as a line with its headline figure. -->
  <section class="band band-ink cases" id="casos">
    <div class="shell">
      <div class="cases-head reveal">
        <h2 class="section-title">Casos en<br />producción</h2>
        <p class="cases-lead">
          Software que ya trabaja en empresas reales: documentos que se procesan solos, correo que se clasifica, ofertas
          que se preparan en segundos. Cada caso publica la cifra, el periodo medido y lo que esa cifra no demuestra.
        </p>
      </div>
      <div class="cases-body">
        <a class="cases-featured reveal" href={`/casos/${cases[0].id}/`}>
          <Image
            class="cases-cover"
            src={coverOf('casos', cases[0])}
            alt={`${cases[0].data.metrics[0].value} ${cases[0].data.metrics[0].label}`}
            widths={[640, 960, 1400]}
            sizes="(max-width: 1000px) calc(100vw - 2rem), 56vw"
            loading="lazy"
            decoding="async"
          />
          <span class="cases-featured-text">
            <span class="eyebrow">{cases[0].data.category}</span>
            <span class="cases-featured-title t-link">{cases[0].data.title}</span>
          </span>
        </a>
        <ol class="cases-list reveal-stagger">
          {
            cases.slice(1).map((c) => (
              <li>
                <a class="cases-row" href={`/casos/${c.id}/`}>
                  <span class="cases-metric">
                    <strong>{c.data.metrics[0].value}</strong>
                    <span>{c.data.metrics[0].label}</span>
                  </span>
                  <span class="cases-row-title">
                    <span class="t-link">{c.data.title}</span>
                  </span>
                  <Icon name="arrow" size={18} class="arrow" />
                </a>
              </li>
            ))
          }
        </ol>
      </div>
      <a class="link-arrow cases-all reveal" href="/casos/">Ver los {cases.length} casos <Icon name="arrow" size={15} class="arrow" /></a>
    </div>
  </section>

  <!-- Guides: the library, on grey. -->
  <section class="band" id="guias">
    <div class="shell">
      <SectionHead
        title="Guías **prácticas**"
        lead="Costes, plazos, proveedores y procesos explicados para pymes, con fuentes y límites honestos."
        link={{ href: '/guias/', label: `Ver las ${guides.length} guías` }}
      />
      <div class="guide-grid reveal-stagger">
        {guides.slice(0, 6).map((g) => <GuideCard guide={g} sizes="(max-width: 640px) calc(100vw - 2rem), 26rem" />)}
      </div>
    </div>
  </section>

  <!-- Team: six portraits in a row, colour on hover. -->
  <section class="band" id="about-us">
    <div class="shell">
      <SectionHead
        title="Quién está **detrás**"
        lead="Un equipo de ingenieros en Santiago de Compostela que diseña, construye y mantiene cada proyecto."
        link={{ href: '/nosotros/', label: 'Conocer al equipo' }}
      />
      <ul class="team reveal-stagger">
        {
          team.map((m) => (
            <li>
              <a href={`/nosotros/#${m.id}`}>
                <Image src={m.data.photo} alt="" width={320} height={320} widths={[240, 320, 480]} sizes="(max-width: 640px) 50vw, 15rem" loading="lazy" decoding="async" class="team-photo" />
                <span class="team-name t-link">{m.data.name}</span>
                <span class="team-role">{m.data.role}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" id="faq">
    <div class="shell faq-grid">
      <div class="reveal">
        <h2 class="section-title faq-title">Preguntas<br />frecuentes</h2>
      </div>
      <Faq faqs={faqs} title="Preguntas frecuentes sobre OSIX" id="faq-osix" />
    </div>
  </section>

  <CtaBand id="contact" />
</BaseLayout>

<style>
  /* ----- Clients ----- */
  .clients {
    background: var(--black);
    color: var(--paper);
    padding-block: 2.25rem;
  }

  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: clamp(3rem, 6vw, 5.5rem);
    width: max-content;
    padding: 0 clamp(1.5rem, 3vw, 2.75rem);
    list-style: none;
  }

  .marquee-track img {
    height: 2.5rem;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.85;
    transition: opacity var(--t-fast) var(--ease);
  }

  .marquee-track li:hover img {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee 48s linear infinite;
    }

    .marquee:hover .marquee-track,
    .marquee:focus-within .marquee-track {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
      -webkit-mask-image: none;
    }

    .marquee-track {
      flex-wrap: wrap;
      width: auto;
      gap: 1.5rem 3rem;
    }

    .marquee-track li[aria-hidden] {
      display: none;
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* ----- Services ----- */
  /* Legacy anchor; absolute so it is not a grid cell. */
  #services {
    position: absolute;
    top: calc(-1 * var(--header-h));
  }

  .services {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 3rem clamp(3rem, 6vw, 7rem);
    align-items: start;
  }

  .services-head {
    position: sticky;
    top: calc(var(--header-h) + 3rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .services-head .section-title {
    font-size: clamp(2rem, 3.6vw, 3rem);
    text-wrap: nowrap;
  }

  .services-head .section-lead {
    margin-top: 0.25rem;
  }

  .services-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .service {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    padding: clamp(1.75rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid var(--ink);
    text-decoration: none;
    color: var(--ink);
  }

  .service-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    min-width: 0;
  }

  .service-title {
    font-size: clamp(2rem, 3.8vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .service-title .t-link {
    background-size: 0% 3px;
  }

  .service:hover .service-title .t-link {
    background-size: 100% 3px;
  }

  .service-text {
    max-width: 58ch;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    color: var(--muted);
  }

  .service :global(.service-arrow) {
    margin-top: 0.75rem;
    color: var(--muted);
    transition:
      transform var(--t) var(--ease),
      color var(--t-fast) var(--ease);
  }

  .service:hover :global(.service-arrow) {
    color: var(--ink);
  }

  /* ----- Cases ----- */
  .cases-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2rem clamp(3rem, 6vw, 7rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .cases-lead {
    max-width: 58ch;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    color: var(--muted-on-ink);
  }

  .cases-body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 3rem clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .cases-featured {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--paper);
    text-decoration: none;
  }

  .cases :global(.cases-cover) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--line-on-ink);
  }

  .cases-featured-text {
    display: block;
  }

  .cases-featured-text .eyebrow {
    display: block;
    margin-bottom: 0.5rem;
  }

  .cases-featured-title {
    font-size: clamp(1.25rem, 1.8vw, 1.625rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .cases-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line-on-ink);
  }

  .cases-row {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: start;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line-on-ink);
    color: var(--paper);
    text-decoration: none;
  }

  .cases-metric {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-variant-numeric: tabular-nums;
  }

  .cases-metric strong {
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .cases-metric span {
    font-size: 0.6875rem;
    line-height: 1.3;
    color: var(--muted-on-ink);
  }

  .cases-row-title {
    display: block;
    padding-top: 0.2rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .cases-row :global(.arrow) {
    margin-top: 0.3rem;
    color: var(--muted-on-ink);
    transition:
      transform var(--t) var(--ease),
      color var(--t-fast) var(--ease);
  }

  .cases-row:hover :global(.arrow) {
    color: var(--paper);
  }

  .cases-all {
    margin-top: 2.5rem;
  }

  /* ----- Guides ----- */
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem 2rem;
  }

  /* ----- Team ----- */
  .team {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }

  .team a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }

  .team :global(.team-photo) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: 0.75rem;
    background: var(--paper);
    filter: grayscale(1);
    transition: filter var(--t) var(--ease);
  }

  .team a:hover :global(.team-photo) {
    filter: none;
  }

  .team-name {
    align-self: flex-start;
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .team-role {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* ----- FAQ ----- */
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 3rem;
  }

  .faq-title {
    margin-top: 0;
  }

  .faq-grid :global(.faq h2) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  @media (max-width: 1000px) {
    .services {
      grid-template-columns: 1fr;
    }

    .services-head {
      position: static;
    }

    .cases-head,
    .cases-body {
      grid-template-columns: 1fr;
    }

    .guide-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .team {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .guide-grid {
      grid-template-columns: 1fr;
    }

    .cases-row {
      grid-template-columns: 7rem minmax(0, 1fr) auto;
    }

    .service-title {
      font-size: 2rem;
    }

    .team {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
