---
// The home is the showcase: the one page that is allowed to move. Each section has its
// own background and composition; everything below the hero still reads without JS.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import CaseCard from '../components/CaseCard.astro';
import GuideCard from '../components/GuideCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCases, getGuides, getServices, getTeam } from '../lib/content';
import { faqPage, webPage } from '../lib/schema';
import { clients, faqs } from '../data/home';

const [services, cases, guides, team] = await Promise.all([getServices(), getCases(), getGuides(), getTeam()]);
const title = 'Consultoría de IA para pymes en Galicia | OSIX Tech';
const description =
  'OSIX Tech: consultoría de IA y desarrollo de software a medida para pymes de Galicia y España. Automatización, agentes de IA y casos en producción con cifras medidas.';
---

<BaseLayout title={title} description={description} jsonLd={[webPage({ path: '/', name: title, description }), faqPage('/', faqs)]}>
  <Hero />

  <!-- Clients: a black band with the logos in white, moving slowly. Pauses on hover. -->
  <section class="clients" aria-label="Empresas que confían en OSIX">
    <div class="marquee">
      <ul class="marquee-track">
        {
          [0, 1].map((copy) =>
            clients.map((c) => (
              <li aria-hidden={copy === 1 ? 'true' : undefined}>
                <Image src={c.logo} alt={copy === 0 ? c.name : ''} height={44} densities={[1, 2]} loading="lazy" decoding="async" />
              </li>
            )),
          )
        }
      </ul>
    </div>
  </section>

  <!-- Services: the title stays while the three services scroll past it. -->
  <section class="band" id="servicios">
    <div class="shell services">
      <span id="services" aria-hidden="true"></span>
      <div class="services-head reveal">
        <p class="eyebrow">Servicios</p>
        <h2 class="section-title">Tres formas de<br />trabajar con OSIX</h2>
        <p class="section-lead">
          Construimos el software, te ayudamos a decidir qué automatizar o preparamos el proyecto cuando hay una ayuda
          pública vigente que encaja. En los tres casos empezamos por tu proceso real.
        </p>
        <a class="link-arrow" href="/servicios/">Ver servicios <Icon name="arrow" size={15} class="arrow" /></a>
      </div>
      <ol class="services-list">
        {
          services.map((s) => (
            <li class="reveal">
              <a class="service" href={`/servicios/${s.id}/`}>
                <span class="service-main">
                  <h3 class="service-title"><span class="t-link">{s.data.shortTitle ?? s.data.title}</span></h3>
                  <p class="service-text">{s.data.summary ?? s.data.description}</p>
                </span>
                <Icon name="arrow" size={24} class="arrow service-arrow" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Cases: black, the covers carry the figures. -->
  <section class="band band-ink" id="casos">
    <div class="shell">
      <SectionHead
        title="Casos en **producción**"
        lead="No enseñamos demos aisladas. Cada caso publica la ventana medida y lo que la cifra no demuestra."
        link={{ href: '/casos/', label: `Ver los ${cases.length} casos` }}
      />
      <div class="case-grid reveal-stagger">
        {cases.slice(0, 3).map((c) => <CaseCard item={c} variant="ink" sizes="(max-width: 800px) calc(100vw - 2rem), 26rem" />)}
      </div>
    </div>
  </section>

  <!-- Guides: the library, on grey. -->
  <section class="band band-surface" id="guias">
    <div class="shell">
      <SectionHead
        title="Guías **prácticas**"
        lead="Costes, plazos, proveedores y procesos explicados para pymes, con fuentes y límites honestos."
        link={{ href: '/guias/', label: `Ver las ${guides.length} guías` }}
      />
      <div class="guide-grid reveal-stagger">
        {guides.slice(0, 6).map((g) => <GuideCard guide={g} sizes="(max-width: 640px) calc(100vw - 2rem), 26rem" />)}
      </div>
    </div>
  </section>

  <!-- Team: six portraits in a row, colour on hover. -->
  <section class="band" id="about-us">
    <div class="shell">
      <SectionHead
        title="Quién está **detrás**"
        lead="Un equipo de ingenieros en Santiago de Compostela que diseña, construye y mantiene cada proyecto."
        link={{ href: '/nosotros/', label: 'Conocer al equipo' }}
      />
      <ul class="team reveal-stagger">
        {
          team.map((m) => (
            <li>
              <a href={`/nosotros/#${m.id}`}>
                <Image src={m.data.photo} alt="" width={320} height={320} widths={[240, 320, 480]} sizes="(max-width: 640px) 50vw, 15rem" loading="lazy" decoding="async" class="team-photo" />
                <span class="team-name t-link">{m.data.name}</span>
                <span class="team-role">{m.data.role}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band band-surface" id="faq">
    <div class="shell faq-grid">
      <div class="reveal">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="section-title faq-title">Lo que <strong>necesitas</strong> saber</h2>
      </div>
      <Faq faqs={faqs} title="Preguntas frecuentes sobre OSIX" id="faq-osix" />
    </div>
  </section>

  <CtaBand id="contact" />
</BaseLayout>

<style>
  /* ----- Clients ----- */
  .clients {
    background: var(--black);
    color: var(--paper);
    padding-block: 2.25rem;
  }

  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: clamp(3rem, 6vw, 5.5rem);
    width: max-content;
    padding: 0 clamp(1.5rem, 3vw, 2.75rem);
    list-style: none;
  }

  .marquee-track img {
    height: 2.5rem;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.85;
    transition: opacity var(--t-fast) var(--ease);
  }

  .marquee-track li:hover img {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee 48s linear infinite;
    }

    .marquee:hover .marquee-track,
    .marquee:focus-within .marquee-track {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
      -webkit-mask-image: none;
    }

    .marquee-track {
      flex-wrap: wrap;
      width: auto;
      gap: 1.5rem 3rem;
    }

    .marquee-track li[aria-hidden] {
      display: none;
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* ----- Services ----- */
  /* Legacy anchor; absolute so it is not a grid cell. */
  #services {
    position: absolute;
    top: calc(-1 * var(--header-h));
  }

  .services {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 3rem clamp(3rem, 6vw, 7rem);
    align-items: start;
  }

  .services-head {
    position: sticky;
    top: calc(var(--header-h) + 3rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .services-head .section-title {
    font-size: clamp(2rem, 3.6vw, 3rem);
    text-wrap: nowrap;
  }

  .services-head .section-lead {
    margin-top: 0.25rem;
  }

  .services-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .service {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    padding: clamp(1.75rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid var(--ink);
    text-decoration: none;
    color: var(--ink);
  }

  .service-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    min-width: 0;
  }

  .service-title {
    font-size: clamp(2rem, 3.8vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .service-title .t-link {
    background-size: 0% 3px;
  }

  .service:hover .service-title .t-link {
    background-size: 100% 3px;
  }

  .service-text {
    max-width: 58ch;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    color: var(--muted);
  }

  .service :global(.service-arrow) {
    margin-top: 0.75rem;
    color: var(--muted);
    transition:
      transform var(--t) var(--ease),
      color var(--t-fast) var(--ease);
  }

  .service:hover :global(.service-arrow) {
    color: var(--ink);
  }

  /* ----- Cases and guides ----- */
  .case-grid,
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem 2rem;
  }

  .case-grid :global(.card-title) {
    font-size: 1.25rem;
  }

  /* ----- Team ----- */
  .team {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }

  .team a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }

  .team :global(.team-photo) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: 0.75rem;
    background: var(--surface);
    filter: grayscale(1);
    transition: filter var(--t) var(--ease);
  }

  .team a:hover :global(.team-photo) {
    filter: none;
  }

  .team-name {
    align-self: flex-start;
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .team-role {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* ----- FAQ ----- */
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 3rem;
  }

  .faq-title {
    margin-top: 0.75rem;
  }

  .faq-grid :global(.faq h2) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  @media (max-width: 1000px) {
    .services {
      grid-template-columns: 1fr;
    }

    .services-head {
      position: static;
    }

    .case-grid,
    .guide-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .team {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .case-grid,
    .guide-grid {
      grid-template-columns: 1fr;
    }

    .service-title {
      font-size: 2rem;
    }

    .team {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
