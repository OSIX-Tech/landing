---
import Layout from '../../layouts/Layout.astro';
import { type Lang } from '../../utils/languages';

export const prerender = true;
export async function getStaticPaths() {
  return ['a', 'b', 'c'].map(variant => ({ params: { lang: 'es', variant } }));
}

const { lang = 'es', variant = 'a' } = Astro.params as { lang: Lang; variant: string };
const copy = {
  es: {
    title: 'Kit Espacios de Datos: estado de la convocatoria | OSIX Tech',
    description: 'La información promocional anterior del KTED no debe tratarse como una convocatoria abierta. Consulta la ficha oficial de Red.es.',
    eyebrow: 'Kit Espacios de Datos (KTED)',
    heading: 'La información de esta página corresponde a una convocatoria anterior',
    body: 'Red.es sitúa el fin del proyecto inicial en marzo de 2026. La ficha consultada no confirma una convocatoria sucesora abierta. No envíes una solicitud basándote en los importes, plazos o formularios de la antigua campaña.',
    source: 'Consulta la ficha oficial de Red.es',
    guide: 'Lee nuestra guía de ayudas para pymes gallegas',
  },
  en: {
    title: 'Data Spaces Kit: call status | OSIX Tech',
    description: 'Previous KTED promotional information should not be treated as an open call. Check the official Red.es page.',
    eyebrow: 'Data Spaces Kit (KTED)',
    heading: 'This page contains information about a previous call',
    body: 'Red.es lists the initial project as ending in March 2026. The page reviewed does not confirm an open successor call. Do not apply using amounts, deadlines, or forms from the old campaign.',
    source: 'Check the official Red.es page',
    guide: 'Read our grant guide for Galician SMEs',
  },
  gl: {
    title: 'Kit Espazos de Datos: estado da convocatoria | OSIX Tech',
    description: 'A información promocional anterior de KTED non se debe tratar como unha convocatoria aberta. Consulta a ficha oficial de Red.es.',
    eyebrow: 'Kit Espazos de Datos (KTED)',
    heading: 'Esta páxina contén información dunha convocatoria anterior',
    body: 'Red.es sitúa o fin do proxecto inicial en marzo de 2026. A ficha consultada non confirma unha convocatoria sucesora aberta. Non envíes unha solicitude baseándote nos importes, prazos ou formularios da antiga campaña.',
    source: 'Consulta a ficha oficial de Red.es',
    guide: 'Le a nosa guía de axudas para pemes galegas',
  },
} as const;
const currentCopy = copy[lang];
const title = currentCopy.title;
const description = currentCopy.description;
const canonicalUrl = 'https://osix.tech/kted/a';
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": `https://osix.tech/kted/${variant}`,
  "inLanguage": lang
};
---

<Layout lang={lang} title={title} description={description} pageType="website" canonical={canonicalUrl} jsonLd={jsonLd} noindex={true} hideHeader={true}>
  <main class="notice">
    <p class="eyebrow">{currentCopy.eyebrow}</p>
    <h1>{currentCopy.heading}</h1>
    <p>{currentCopy.body}</p>
    <ul>
      <li><a href="https://www.red.es/es/iniciativas/proyectos/kit-espacios-de-datos">{currentCopy.source}</a></li>
      <li><a href="/guias/subvenciones-ia-pymes-galicia-2026/">{currentCopy.guide}</a></li>
    </ul>
  </main>
</Layout>

<style>
  .notice { max-width: 54rem; margin: 8rem auto; padding: 2rem; color: #111; }
  .eyebrow { font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .notice h1 { margin: 1rem 0; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.1; }
  .notice p, .notice li { line-height: 1.7; }
  .notice ul { margin-top: 1.5rem; padding-left: 1.25rem; }
</style>
