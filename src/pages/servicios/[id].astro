---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import CaseCard from '../../components/CaseCard.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getServices, getCasesForService, getGuidesById, guideTitle, type Service } from '../../lib/content';
import { breadcrumbs, faqPage, webPage } from '../../lib/schema';
import { absolute, ORG_ID } from '../../site';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({ params: { id: service.id }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const { data } = service;
const { Content } = await render(service);
const hasBody = Boolean(service.body?.trim());
const path = `/servicios/${service.id}/`;
const cases = await getCasesForService(service.id);
const guides = await getGuidesById(data.guides);
const others = (await getServices()).filter((s) => s.id !== service.id);
const seoTitle = data.seoTitle ?? `${data.title}: ${data.tagline.replace(/\.$/, '')} | OSIX Tech`;
const words = data.title.split(' ');
---

<BaseLayout
  title={seoTitle}
  description={data.description.length > 200 ? data.description.slice(0, data.description.lastIndexOf(' ', 197)) + '…' : data.description}
  jsonLd={[
    {
      '@type': 'Service',
      '@id': `${absolute(path)}#service`,
      name: data.title,
      description: data.description,
      serviceType: data.serviceType,
      url: absolute(path),
      provider: { '@id': ORG_ID },
      areaServed: [
        { '@type': 'Country', name: 'España' },
        { '@type': 'AdministrativeArea', name: 'Galicia' },
      ],
    },
    webPage({ path, name: seoTitle, description: data.description, modified: data.updated }),
    faqPage(path, data.faqs),
    breadcrumbs([
      { name: 'Inicio', path: '/' },
      { name: 'Servicios', path: '/servicios/' },
      { name: data.title, path },
    ]),
  ]}
>
  <header class="shell svc-hero">
    <nav class="crumbs fade-in" style="--d:0s" aria-label="Migas de pan">
      <a href="/">Inicio</a> <span aria-hidden="true">/</span> <a href="/servicios/">Servicios</a>
    </nav>
    <h1 class="rise">
      {
        words.map((w, i) => (
          <>
            <span class="w" style={`--i:${i}`}>
              {w}
            </span>{' '}
          </>
        ))
      }
    </h1>
    <p class="svc-tagline fade-in">{data.tagline}</p>
    <div class="svc-actions fade-in" style="--d:0.5s">
      <a class="btn btn-dark" href="/contacto/">Cuéntanos tu caso <Icon name="arrow" size={15} class="arrow" /></a>
      <a class="btn btn-outline" href="#preguntas-frecuentes">Preguntas frecuentes</a>
    </div>
  </header>

  <section class="shell svc-intro">
    <p class="svc-description reveal">{data.description}</p>
  </section>

  <section class="shell svc-grid">
    <div class="svc-narrative reveal">
      <div>
        <h2>{data.problem.title}</h2>
        <p>{data.problem.body}</p>
      </div>
      <div>
        <h2>{data.solution.title}</h2>
        <p>{data.solution.body}</p>
      </div>
    </div>
    <dl class="svc-stats reveal">
      {
        data.stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="shell svc-highlights">
    <div class="svc-highlights-inner reveal">
      <h2>{data.highlightsTitle}</h2>
      <ul>
        {
          data.highlights.map((h) => (
            <li>
              <Icon name="check" size={18} />
              <span>{h}</span>
            </li>
          ))
        }
      </ul>
    </div>
    {
      data.testimonial && (
        <figure class="svc-quote reveal">
          <Icon name="quote" size={28} />
          <blockquote>{data.testimonial.quote}</blockquote>
          <figcaption>
            {data.testimonial.author} · {data.testimonial.role}
          </figcaption>
        </figure>
      )
    }
  </section>

  {
    hasBody && (
      <section class="shell svc-body">
        <div class="prose">
          <Content />
        </div>
      </section>
    )
  }

  <section class="band">
    <div class="shell">
      <SectionHead title="Casos en **producción**" link={{ href: '/casos/', label: 'Ver todos los casos' }} />
      <div class="card-grid reveal-stagger">
        {cases.map((c) => <CaseCard item={c} />)}
      </div>
    </div>
  </section>

  <section class="shell svc-faq">
    <div class="svc-faq-inner">
      <Faq faqs={data.faqs} />
    </div>
    <aside class="svc-links">
      {
        guides.length > 0 && (
          <div>
            <p class="eyebrow">Guías relacionadas</p>
            <ul>
              {guides.map((g) => (
                <li>
                  <a href={`/guias/${g.id}/`}>
                    <Icon name="book" size={16} />
                    {guideTitle(g)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div>
        <p class="eyebrow">Otros servicios</p>
        <ul>
          {
            others.map((s) => (
              <li>
                <a href={`/servicios/${s.id}/`}>
                  <Icon name={s.data.icon} size={16} />
                  {s.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .svc-hero {
    padding-block: clamp(2.5rem, 7vw, 5.5rem) 2rem;
  }

  .crumbs {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .crumbs a {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--t) var(--ease);
  }

  .crumbs a:hover {
    background-size: 100% 1px;
  }

  h1 {
    margin-top: 1.75rem;
    max-width: 18ch;
    font-size: clamp(2.5rem, 7.5vw, 5.5rem);
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .svc-tagline {
    margin-top: 1.5rem;
    max-width: 48ch;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: var(--muted);
    --d: 0.35s;
  }

  .svc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .svc-intro {
    padding-block: 2rem;
  }

  .svc-description {
    max-width: 68ch;
    padding-top: 2rem;
    border-top: 1px solid var(--ink);
    font-size: clamp(1.125rem, 1.8vw, 1.3125rem);
    line-height: 1.6;
  }

  .svc-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 2rem;
  }

  .svc-narrative {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    padding: 2rem;
    border: 1px solid var(--line);
  }

  .svc-narrative h2,
  .svc-highlights h2 {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  .svc-narrative p {
    margin-top: 0.85rem;
    color: #2b2b2b;
  }

  .svc-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line-on-ink);
    border: 1px solid var(--ink);
  }

  .svc-stats > div {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem;
    background: var(--ink);
    color: var(--paper);
  }

  .svc-stats dd {
    order: -1;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .svc-stats dt {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--muted-on-ink);
  }

  .svc-highlights {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1.25rem;
    padding-bottom: 2rem;
  }

  .svc-highlights-inner {
    padding: 2rem;
    background: var(--paper);
    border: 1px solid var(--line);
  }

  .svc-highlights ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem 2rem;
    margin-top: 1.25rem;
    list-style: none;
    padding: 0;
  }

  .svc-highlights li {
    display: flex;
    gap: 0.6rem;
    font-weight: 500;
  }

  .svc-highlights li :global(svg) {
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .svc-quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem;
    border: 1px solid var(--line);
  }

  .svc-quote blockquote {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .svc-quote figcaption {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .svc-body {
    padding-block: 3rem 1rem;
  }

  .svc-body .prose {
    max-width: 46rem;
  }

  .svc-faq {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 3.5rem;
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .svc-links {
    display: grid;
    align-content: start;
    gap: 2rem;
  }

  .svc-links ul {
    margin-top: 0.75rem;
    list-style: none;
    padding: 0;
  }

  .svc-links a {
    display: flex;
    gap: 0.6rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.4;
    text-decoration: none;
  }

  .svc-links a :global(svg) {
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .svc-links a {
    transition: color var(--t-fast) var(--ease);
  }

  .svc-links a:hover {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .svc-grid,
    .svc-highlights,
    .svc-faq,
    .svc-narrative,
    .svc-highlights ul {
      grid-template-columns: 1fr;
    }
  }
</style>
