  "rewrites": [
    {
      "source": "/guias/:slug/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/guias/:slug.md"
    },
    {
      "source": "/casos/:slug/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/casos/:slug.md"
    },
    {
      "source": "/demo/malasa/",
      "destination": "https://malasa-informes.vercel.app/index.html"
    },
    {
      "source": "/demo/malasa/:path*",
      "destination": "https://malasa-informes.vercel.app/:path*"
    },
    {
      "source": "/demos/(.*)",
      "destination": "https://portfolio-osix.vercel.app/demos/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/llms(.*)\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/guias/:slug/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "Link",
          "value": "</guias/:slug.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/casos/:slug/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "Link",
          "value": "</casos/:slug.md>; rel=\"alternate\"; type=\"text/markdown\""
