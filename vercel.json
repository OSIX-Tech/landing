{
  "redirects": [
    {
      "source": "/",
      "destination": "/es/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "destination": "/es/:path*",
      "permanent": true
    },
    {
      "source": "/gl/:path*",
      "destination": "/es/:path*",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/es/privacy/",
      "permanent": true
    },
    {
      "source": "/:path((?!.*\\.)(?!.*\\/$).+)",
      "destination": "/:path/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/demo/malasa/",
      "destination": "https://malasa-informes.vercel.app/index.html"
    },
    {
      "source": "/demo/malasa/:path*",
      "destination": "https://malasa-informes.vercel.app/:path*"
    }
  ]
}
